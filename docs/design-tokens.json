{
  "$description": "CoCoffee F&B design tokens. Single source for Web Admin (CSS variables) and Flutter tablet POS (ThemeData). Contrast ratios verified with the WCAG 2.x relative-luminance formula; see docs/UI-UX-SPEC.md section 4.",
  "color": {
    "dark": {
      "bg.base": "#1B1D1F",
      "bg.surface": "#25282B",
      "bg.elevated": "#2F3337",
      "border.subtle": "#3D4247",
      "border.strong": "#6B737A",
      "text.primary": "#F4F1EA",
      "text.secondary": "#B9BEC3",
      "text.muted": "#8A9097",
      "accent.amber": "#F2A33A",
      "accent.amberPressed": "#D98B1F",
      "accent.onAmber": "#1B1D1F",
      "accent.espresso": "#7A5236",
      "accent.espressoLine": "#B8865F",
      "accent.onEspresso": "#F4F1EA",
      "status.matcha": "#8DB36B",
      "status.onMatcha": "#14210F",
      "status.matchaTint": "#24331F",
      "status.amberTint": "#3A2C14",
      "status.danger": "#EE6C59",
      "status.onDanger": "#1B1D1F",
      "status.dangerTint": "#3D1F1B",
      "channel.zalo": "#4C9AFF",
      "channel.onZalo": "#0B1B33",
      "channel.zaloTint": "#1A2B45",
      "focus.ring": "#F2A33A"
    },
    "light": {
      "bg.base": "#ECEAE5",
      "bg.surface": "#FFFFFF",
      "bg.elevated": "#F6F4F0",
      "border.subtle": "#D3D0CA",
      "border.strong": "#7A8189",
      "text.primary": "#1F2123",
      "text.secondary": "#4A5056",
      "text.muted": "#5F666D",
      "accent.amber": "#A35F00",
      "accent.amberPressed": "#8A5000",
      "accent.onAmber": "#FFFFFF",
      "accent.espresso": "#6B4429",
      "accent.espressoLine": "#6B4429",
      "accent.onEspresso": "#FFFFFF",
      "status.matcha": "#3F6B2B",
      "status.onMatcha": "#FFFFFF",
      "status.matchaTint": "#E1EDD6",
      "status.amberTint": "#F8E7CC",
      "status.danger": "#B3261E",
      "status.onDanger": "#FFFFFF",
      "status.dangerTint": "#F8DAD6",
      "channel.zalo": "#0057D9",
      "channel.onZalo": "#FFFFFF",
      "channel.zaloTint": "#D9E8FF",
      "focus.ring": "#A35F00"
    }
  },
  "typography": {
    "family.ui": "Times New Roman, Times, Liberation Serif, Tinos, serif",
    "family.numeric": "Times New Roman, Times, Liberation Serif, Tinos, serif",
    "$note": "Times New Roman everywhere (system font, nothing to download). Its digits are fixed-width, so prices and quantities stay column-aligned without a separate monospace face.",
    "scale": {
      "display": { "family": "ui", "size": 32, "line": 40, "weight": 700 },
      "h1": { "family": "ui", "size": 24, "line": 32, "weight": 600 },
      "h2": { "family": "ui", "size": 20, "line": 28, "weight": 600 },
      "bodyL": { "family": "ui", "size": 18, "line": 26, "weight": 400 },
      "body": { "family": "ui", "size": 16, "line": 24, "weight": 400 },
      "label": { "family": "ui", "size": 14, "line": 20, "weight": 600 },
      "caption": { "family": "ui", "size": 13, "line": 18, "weight": 500 },
      "numTotal": { "family": "numeric", "size": 32, "line": 40, "weight": 600 },
      "numL": { "family": "numeric", "size": 20, "line": 28, "weight": 500 },
      "num": { "family": "numeric", "size": 16, "line": 24, "weight": 500 },
      "timer": { "family": "numeric", "size": 14, "line": 20, "weight": 500 }
    }
  },
  "spacing": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 32 },
  "radius": { "sm": 8, "md": 12, "lg": 16, "pill": 999 },
  "touch": { "min": 48, "primary": 56, "cta": 64, "gapMin": 8 },
  "border": { "hairline": 1, "emphasis": 2, "focus": 2 },
  "motion": { "fast": 120, "base": 200, "slow": 300, "easing": "cubic-bezier(0.2, 0, 0, 1)", "reducedMotion": "disable pulses and slides, keep 120ms fades" },
  "layout": {
    "pos": { "referenceDp": [1280, 800], "minDp": [960, 600], "rail": 72, "categories": 136, "cart": 380, "topBar": 56, "tile": 122, "tableCard": [148, 112] },
    "admin": {
      "referencePx": [1440, 900], "minPx": 1024, "sidebar": 240, "sidebarCollapsed": 72, "header": 64, "headerPhone": 56,
      "contentMax": 1280, "gutter": 24, "gutterPhone": 12, "columns": 12, "padding": 24, "paddingPhone": 16, "bottomNavPhone": 56,
      "breakpoints": { "phone": "<768", "tablet": "768-1023", "laptop": "1024-1279", "desktop": ">=1280" }
    }
  }
}
