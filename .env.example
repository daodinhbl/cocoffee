# Copy to .env for local work. On Hostinger the same keys are set as the Node.js app's environment variables.
# NEVER commit the real .env and never place it inside public_html.

NODE_ENV=production

# ---- MySQL -------------------------------------------------------------------------------------------------
# Hostinger prefixes database/user names with the account id (e.g. u123456789_cocoffee).
# On Hostinger these five come from the platform ("Setup website database" writes them for you);
# use 127.0.0.1 (never "localhost", never the srvNNNN.hstgr.io host) when you set them by hand.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cocoffee
DB_USER=[INSERT_DB_USER]
DB_PASSWORD=[INSERT_PASSWORD]
DB_POOL_LIMIT=5
DB_TIMEZONE=+07:00

# First boot on a host that cannot import SQL: when the database holds no data the app applies
# database/schema.sql (+ database/seed.sql if SEED_DEMO=true: demo menu/BOM/tables and an "admin" account).
# A database with any row, or any table that is not ours, is never touched, so redeploying cannot wipe data.
# A bootstrap that stopped half-way (only our tables, all empty) is simply re-run on the next boot.
AUTO_BOOTSTRAP_DB=false
SEED_DEMO=false
# With SEED_DEMO=true: password (min 10 chars) the seeded "admin" account gets INSTEAD of the factory admin/admin.
# Left empty (or too short), a random password is generated and printed ONCE in the app log (stderr.log).
# Only read while bootstrapping an empty database; delete the variable afterwards.
BOOTSTRAP_ADMIN_PASSWORD=

# ---- Auth for the POS/Admin API --------------------------------------------------------------------------------
# Optional. When empty the key is derived from DB_PASSWORD (HMAC-SHA256), so no secret has to be invented or pasted.
# Set it explicitly to rotate tokens independently of the database password:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# ---- Public URL (used to build receipt image links Zalo will fetch) ----------------------------------------------
PUBLIC_BASE_URL=https://cocoffee.tasotek-giaiphapso.com

# ---- Zalo chatbot (personal account + external Bot Client) ---------------------------------------------
# The Bot Client (PC/VPS, logged in to a personal Zalo account) POSTs every message to /api/zalo/webhook with
# "Authorization: Bearer <BOT_WEBHOOK_SECRET>" and sends the returned replies to the chat. See docs/zalo-bot.md.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BOT_WEBHOOK_SECRET=
# Minutes a Zalo draft order waits for "ok"
ZALO_DRAFT_TTL_MINUTES=30

# ---- Business rules --------------------------------------------------------------------------------------------------
ALLOW_NEGATIVE_STOCK=false
SHOP_NAME=CoCoffee
SHOP_ADDRESS=
SHOP_PHONE=
# Thermal receipt paper width in mm: 80 (default) or 58
RECEIPT_PAPER_MM=80
# Printed at the bottom of the receipt (bank transfer info, etc.)
SHOP_PAYMENT_NOTE=Thanh toan tai quay hoac chuyen khoan. Cam on quy khach!

# ---- Product / ingredient photos (scripts/sync_images.js) ------------------------------------------------
# Free key: https://www.pexels.com/api/  (200 requests/hour, 20k/month)
PEXELS_API_KEY=

# ---- Optional receipt image (pure-JS renderer, needs a TTF with Vietnamese glyphs) -------------------------
RECEIPT_IMAGE_ENABLED=false
RECEIPT_FONT_PATH=assets/fonts/Roboto-Regular.ttf
