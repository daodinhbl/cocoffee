# Copy to .env (local) or set the same keys in cPanel > Setup Node.js App > Environment variables.
# NEVER commit the real .env and never place it inside public_html.

NODE_ENV=production

# ---- MySQL (Hostinger: use 127.0.0.1, not "localhost", not the srvNNNN.hstgr.io host) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cocoffee_fnb
DB_USER=[INSERT_DB_USER]
DB_PASSWORD=[INSERT_PASSWORD]
DB_POOL_LIMIT=5
DB_TIMEZONE=+07:00

# ---- Auth for POS/Admin API (Flutter app in Phase 2) ----
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=[INSERT_LONG_RANDOM_STRING]
JWT_EXPIRES_IN=12h

# ---- Public URL (used to build receipt image links Zalo will fetch) ----
PUBLIC_BASE_URL=https://cocoffee.tasotek-giaiphapso.com

# ---- Zalo Official Account ----
ZALO_APP_ID=[INSERT_ZALO_APP_ID]
# "Khoa bi mat cua OA" (OA secret key) -> used to verify X-ZEvent-Signature
ZALO_OA_SECRET_KEY=[INSERT_OA_SECRET_KEY]
# "Khoa bi mat cua ung dung" (application secret key) -> used for the OAuth refresh call
ZALO_APP_SECRET_KEY=[INSERT_APP_SECRET_KEY]
# One-time bootstrap: refresh_token from the first OA authorization.
# After the first refresh the rotating tokens live in table zalo_tokens and this value is ignored.
ZALO_BOOTSTRAP_REFRESH_TOKEN=
# Set false ONLY for local testing with hand-made payloads
ZALO_VERIFY_SIGNATURE=true
# Minutes a Zalo draft order waits for "ok"
ZALO_DRAFT_TTL_MINUTES=30

# ---- Business rules ----
ALLOW_NEGATIVE_STOCK=false
SHOP_NAME=CoCoffee
# Printed at the bottom of the receipt (bank transfer info, etc.)
SHOP_PAYMENT_NOTE=Thanh toan tai quay hoac chuyen khoan. Cam on quy khach!

# ---- Optional receipt image (pure-JS renderer, needs a TTF with Vietnamese glyphs) ----
RECEIPT_IMAGE_ENABLED=false
RECEIPT_FONT_PATH=assets/fonts/Roboto-Regular.ttf
