<%
  /*
   * Revenue (area) + gross profit (line) per day: server-rendered SVG, no library, CSP-safe (no inline script).
   *   locals: days = [{ day: 'YYYY-MM-DD', revenue, cogs, orders }], id
   * Hover/focus a day to read its numbers; the table next to the chart carries the same figures as text.
   */
  const W = 720, H = 260, L = 52, R = 14, T = 14, B = 30;
  const iw = W - L - R, ih = H - T - B;
  const rev = days.map((d) => Number(d.revenue));
  const prof = days.map((d) => Number(d.revenue) - Number(d.cogs));
  const niceMax = (v) => { if (v <= 0) return 4; const raw = v / 4; const mag = Math.pow(10, Math.floor(Math.log10(raw))); const m = raw / mag; const s = [1, 1.2, 1.5, 2, 2.5, 3, 4, 5, 6, 8, 10].find((c) => m <= c + 1e-9); return s * mag * 4; };
  const top = niceMax(Math.max(1, ...rev, ...prof));
  const lo = Math.min(0, ...prof);
  const span = top - lo;
  const n = days.length;
  const x = (i) => L + (n === 1 ? iw / 2 : (i / (n - 1)) * iw);
  const y = (v) => T + ih - ((v - lo) / span) * ih;
  const compact = (v) => { const a = Math.abs(v); const s = v < 0 ? '−' : ''; return a >= 1e6 ? s + (a / 1e6).toFixed(a >= 1e7 ? 0 : 1).replace('.0', '') + 'tr' : a >= 1e3 ? s + Math.round(a / 1e3) + 'k' : s + a; };
  const ticks = [0, 1, 2, 3, 4].map((k) => lo + (span * k) / 4);
  const every = Math.max(1, Math.ceil(n / 9));
  const dl = (d) => `${d.slice(8, 10)}/${d.slice(5, 7)}`;
  const line = (arr) => arr.map((v, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)} ${y(v).toFixed(1)}`).join(' ');
  const area = `${line(rev)} L${x(n - 1).toFixed(1)} ${y(0).toFixed(1)} L${x(0).toFixed(1)} ${y(0).toFixed(1)} Z`;
  const colW = n > 1 ? iw / (n - 1) : iw;
%>
<div class="relative">
  <div class="mb-2 flex flex-wrap items-center gap-x-5 gap-y-1 text-xs text-gray-600">
    <span class="inline-flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-sm bg-navy"></span>Doanh thu</span>
    <span class="inline-flex items-center gap-1.5"><span class="h-0.5 w-4 bg-emerald-600"></span>Lãi gộp</span>
  </div>
  <svg viewBox="0 0 <%= W %> <%= H %>" class="h-auto w-full" role="img" aria-label="Biểu đồ doanh thu và lãi gộp theo ngày" preserveAspectRatio="xMidYMid meet">
    <% ticks.forEach((t) => { %>
      <line x1="<%= L %>" x2="<%= W - R %>" y1="<%= y(t).toFixed(1) %>" y2="<%= y(t).toFixed(1) %>" stroke="<%= t === 0 ? '#CBD5E1' : '#E8E3DA' %>" stroke-width="1"/>
      <text x="<%= L - 8 %>" y="<%= (y(t) + 4).toFixed(1) %>" text-anchor="end" font-size="11" fill="#8C8478"><%= compact(t) %></text>
    <% }) %>
    <path d="<%= area %>" fill="#1E3A8A" fill-opacity=".12"/>
    <path d="<%= line(rev) %>" fill="none" stroke="#1E3A8A" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round"/>
    <path d="<%= line(prof) %>" fill="none" stroke="#059669" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/>
    <% days.forEach((d, i) => { if (i % every === 0 || i === n - 1) { %>
      <text x="<%= x(i).toFixed(1) %>" y="<%= H - 8 %>" text-anchor="middle" font-size="11" fill="#8C8478"><%= dl(d.day) %></text>
    <% } }) %>
    <% days.forEach((d, i) => {
         const tx = Math.min(Math.max(x(i) - 82, L), W - R - 164);
         const hasOrders = Number(d.orders) > 0; %>
      <g class="group" tabindex="0" aria-label="<%= dl(d.day) %>: doanh thu <%= money(d.revenue) %>, lãi gộp <%= money(prof[i]) %>, <%= d.orders %> đơn">
        <rect x="<%= (x(i) - colW / 2).toFixed(1) %>" y="<%= T %>" width="<%= Math.max(colW, 8).toFixed(1) %>" height="<%= ih %>" fill="transparent"/>
        <line x1="<%= x(i).toFixed(1) %>" x2="<%= x(i).toFixed(1) %>" y1="<%= T %>" y2="<%= T + ih %>" stroke="#1E3A8A" stroke-opacity=".35" stroke-dasharray="3 3" class="opacity-0 group-hover:opacity-100 group-focus:opacity-100"/>
        <circle cx="<%= x(i).toFixed(1) %>" cy="<%= y(rev[i]).toFixed(1) %>" r="<%= n > 45 ? 0 : 3 %>" fill="#fff" stroke="#1E3A8A" stroke-width="2"/>
        <g class="pointer-events-none opacity-0 group-hover:opacity-100 group-focus:opacity-100">
          <rect x="<%= tx.toFixed(1) %>" y="<%= T + 2 %>" width="164" height="58" rx="6" fill="#0F172A"/>
          <text x="<%= (tx + 10).toFixed(1) %>" y="<%= T + 19 %>" font-size="12" font-weight="700" fill="#fff"><%= dl(d.day) %> · <%= d.orders %> đơn</text>
          <text x="<%= (tx + 10).toFixed(1) %>" y="<%= T + 35 %>" font-size="11" fill="#CBD5E1">Doanh thu: <%= money(d.revenue) %></text>
          <text x="<%= (tx + 10).toFixed(1) %>" y="<%= T + 50 %>" font-size="11" fill="#6EE7B7">Lãi gộp: <%= money(prof[i]) %></text>
        </g>
      </g>
    <% }) %>
  </svg>
</div>
