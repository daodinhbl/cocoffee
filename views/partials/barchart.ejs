<%
  /*
   * Horizontal bar chart for a ranking (one series): server-rendered, no library.
   *   locals.chart = { id, title, subtitle, rows: [{ label, value, display, detail, tone?, href? }], empty, link? }
   * Magnitude in one hue (navy); `tone` switches a bar to a status colour (critical/warning) and the row
   * then also carries a text badge, so state is never colour-alone. Values are printed in ink, not in the
   * bar colour. Each row is a list item with its numbers as text: the list doubles as the table view.
   */
  const c = locals.chart;
  const max = Math.max(1, ...c.rows.map((r) => r.value));
  const fill = { critical: 'bg-red-600', warning: 'bg-amber-500' };
  const badge = { critical: 'border-red-200 bg-red-50 text-red-700', warning: 'border-amber-200 bg-amber-50 text-amber-800' };
  const badgeText = { critical: 'Nguy cấp', warning: 'Sắp hết' };
%>
<section aria-labelledby="<%= c.id %>-title" class="rounded-xl border border-milk-200 bg-white p-4 shadow-[0_1px_2px_rgba(15,23,42,.04)] sm:p-5">
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <h2 id="<%= c.id %>-title" class="text-base font-semibold text-navy-darker"><%= c.title %></h2>
      <p class="mt-0.5 text-xs text-milk-500"><%= c.subtitle %></p>
    </div>
    <% if (c.link) { %><a href="<%= c.link.href %>" class="shrink-0 text-xs font-medium text-blue-700 hover:text-navy"><%= c.link.label %> →</a><% } %>
  </div>

  <% if (!c.rows.length) { %>
    <p class="py-8 text-center text-sm text-milk-500"><%= c.empty %></p>
  <% } else { %>
  <ol class="mt-4 space-y-3">
    <% c.rows.forEach((r, i) => { const w = r.value > 0 ? Math.max(2, (r.value / max) * 100) : 0; %>
      <li class="group relative">
        <div class="flex items-baseline justify-between gap-3 text-sm">
          <span class="flex min-w-0 items-center gap-2">
            <span class="w-4 shrink-0 text-right font-mono text-xs text-milk-500 tnum"><%= i + 1 %></span>
            <% if (r.href) { %><a href="<%= r.href %>" class="truncate font-medium text-dark hover:text-navy-accent hover:underline"><%= r.label %></a><% } else { %><span class="truncate font-medium"><%= r.label %></span><% } %>
            <% if (r.tone) { %><span class="shrink-0 rounded-full border px-1.5 py-px text-[10px] font-semibold <%= badge[r.tone] %>"><%= badgeText[r.tone] %></span><% } %>
          </span>
          <span class="shrink-0 font-mono text-sm font-semibold text-navy-darker tnum"><%= r.display %></span>
        </div>
        <!-- hit target taller than the bar; tooltip on hover/focus -->
        <div class="relative mt-1.5 flex h-4 items-center" tabindex="0" aria-label="<%= r.label %>: <%= r.detail %>">
          <div class="h-2 w-full rounded-r bg-milk-100"></div>
          <div class="absolute left-0 h-2 rounded-r <%= fill[r.tone] || 'bg-navy group-hover:bg-navy-accent' %> transition-colors" style="width: <%= w.toFixed(1) %>%"></div>
          <div role="tooltip" class="pointer-events-none absolute bottom-full left-0 z-10 mb-1 hidden whitespace-nowrap rounded-md bg-navy-darker px-2.5 py-1.5 text-xs text-white shadow-lg group-hover:block group-focus-within:block">
            <span class="font-semibold"><%= r.label %></span> · <%= r.detail %>
          </div>
        </div>
      </li>
    <% }) %>
  </ol>
  <% } %>
</section>
