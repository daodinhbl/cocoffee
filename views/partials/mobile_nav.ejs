<%
  // Thumb-zone navigation, phones only (<768px). Tablets/desktops use the sidebar rail instead.
  // Main modules only; the "Menu" button opens the full drawer.
  const tabs = [
    { key: 'dashboard', label: 'Tổng quan', icon: 'grid', href: '/admin/dashboard' },
    { key: 'orders', label: 'Đơn hàng', icon: 'receipt', href: '/admin/orders' },
    { key: 'inventory', label: 'Kho', icon: 'box', href: '/admin/inventory' },
    { key: 'reports', label: 'Báo cáo', icon: 'chart', href: '/admin/reports' },
  ];
  const base = 'relative flex h-14 flex-1 flex-col items-center justify-center gap-0.5 text-[11px] font-medium';
%>
<nav aria-label="Điều hướng nhanh" class="fixed inset-x-0 bottom-0 z-30 flex border-t border-gray-200 bg-white pb-[env(safe-area-inset-bottom)] md:hidden">
  <% tabs.forEach((t) => { const active = activeMenu === t.key; %>
    <a href="<%= t.href %>" <%- active ? 'aria-current="page"' : '' %>
      class="<%= base %> <%= active
        ? 'text-gray-900 before:absolute before:inset-x-4 before:top-[-1px] before:h-[3px] before:bg-amber-400'
        : 'text-gray-500 active:bg-gray-50' %>">
      <span class="<%= active ? 'text-amber-600' : '' %>"><%- icon(t.icon, 'h-6 w-6') %></span>
      <span><%= t.label %></span>
    </a>
  <% }) %>
  <button type="button" data-sidebar-toggle aria-controls="sidebar" aria-expanded="false" class="<%= base %> text-gray-500 active:bg-gray-50">
    <%- icon('menu', 'h-6 w-6') %>
    <span>Menu</span>
  </button>
</nav>
