<%
  const zaloTone = {
    ok:      { pill: 'border-green-200 bg-green-50 text-green-700', dot: 'bg-green-500' },
    warn:    { pill: 'border-amber-200 bg-amber-50 text-amber-800', dot: 'bg-amber-500' },
    off:     { pill: 'border-gray-200 bg-gray-50 text-gray-600',    dot: 'bg-gray-400' },
    unknown: { pill: 'border-gray-200 bg-gray-50 text-gray-600',    dot: 'bg-gray-400' },
  }[zalo.state] || { pill: 'border-gray-200 bg-gray-50 text-gray-600', dot: 'bg-gray-400' };
  const noteTone = { warn: 'bg-amber-500', info: 'bg-sky-500', bad: 'bg-red-500' };
%>
<header class="sticky top-0 z-20 flex h-14 shrink-0 items-center gap-3 border-b border-milk-200 bg-white/90 px-4 backdrop-blur md:h-header sm:px-6">
  <!-- Phones: brand mark (navigation lives in the bottom tab bar) -->
  <a href="/admin/dashboard" aria-label="<%= shopName %> — Tổng quan" class="-ml-1 flex h-11 w-11 shrink-0 items-center justify-center md:hidden"><span class="flex h-9 w-9 items-center justify-center rounded bg-[#FBF6EF] p-1 ring-1 ring-[#E9D3B6]"><img src="/brand/mark.png" alt="" width="256" height="200" class="h-full w-full object-contain"></span></a>

  <!-- Breadcrumbs -->
  <nav aria-label="Breadcrumb" class="min-w-0 flex-1">
    <ol class="flex items-center gap-1.5 truncate text-sm text-gray-500">
      <li class="hidden lg:block"><a href="/admin/dashboard" class="hover:text-gray-900"><%= shopName %></a></li>
      <% breadcrumbs.forEach((crumb, i) => { const last = i === breadcrumbs.length - 1; %>
        <li class="items-center gap-1.5 <%= last ? 'flex' : 'hidden lg:flex' %>">
          <span class="hidden text-gray-300 lg:inline" aria-hidden="true"><%- icon('chevron', 'h-3.5 w-3.5') %></span>
          <% if (last) { %>
            <span aria-current="page" class="truncate text-base font-semibold text-gray-900 sm:text-sm sm:font-medium"><%= crumb.label %></span>
          <% } else { %>
            <a href="<%= crumb.href || '#' %>" class="hover:text-gray-900"><%= crumb.label %></a>
          <% } %>
        </li>
      <% }) %>
    </ol>
  </nav>

  <!-- Quick search (Ctrl/Cmd + K) -->
  <form role="search" data-no-submit class="relative hidden w-44 md:block xl:w-72">
    <label for="quick-search" class="sr-only">Tìm nhanh</label>
    <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"><%- icon('search', 'h-4 w-4') %></span>
    <input id="quick-search" type="search" autocomplete="off" placeholder="Tìm nhanh…"
      class="h-10 w-full rounded-lg border border-milk-200 bg-milk-50 pl-9 pr-14 text-sm placeholder:text-gray-400 focus:border-navy-accent focus:bg-white focus:outline-none focus:ring-1 focus:ring-navy-accent">
    <kbd class="pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 rounded-sm border border-gray-200 bg-white px-1.5 py-0.5 font-mono text-[11px] text-gray-500">Ctrl K</kbd>
  </form>

  <!-- Zalo OA status: dot only on phones -->
  <span role="status" title="<%= zalo.label %>" class="inline-flex h-10 w-6 items-center justify-center sm:hidden">
    <span class="h-2.5 w-2.5 rounded-full <%= zaloTone.dot %>" aria-hidden="true"></span>
    <span class="sr-only"><%= zalo.label %></span>
  </span>
  <!-- Zalo OA status -->
  <span role="status" title="Trạng thái kết nối Zalo OA"
    class="hidden items-center gap-2 rounded-sm border px-2.5 py-1.5 text-xs font-medium sm:inline-flex <%= zaloTone.pill %>">
    <span class="h-2 w-2 rounded-full <%= zaloTone.dot %>" aria-hidden="true"></span>
    <%= zalo.label %>
  </span>

  <!-- Notifications -->
  <div class="relative">
    <button type="button" data-dropdown="#notif-panel" aria-haspopup="true" aria-expanded="false" aria-controls="notif-panel"
      aria-label="Thông báo (<%= notifications.length %>)"
      class="icon-btn relative flex h-10 w-10 items-center justify-center rounded text-gray-600 hover:bg-gray-100">
      <%- icon('bell', 'h-5 w-5') %>
      <% if (notifications.length) { %>
        <span class="absolute right-1.5 top-1.5 flex h-4 min-w-4 items-center justify-center rounded-full bg-amber-400 px-1 text-[10px] font-bold leading-none text-ink-900"><%= notifications.length %></span>
      <% } %>
    </button>
    <div id="notif-panel" hidden class="z-30 rounded border border-gray-200 bg-white shadow-sm max-md:fixed max-md:inset-x-3 max-md:top-[60px] max-md:w-auto md:absolute md:right-0 md:top-full md:mt-2 md:w-80">
      <p class="border-b border-gray-200 px-4 py-3 text-sm font-semibold">Thông báo</p>
      <ul class="max-h-80 divide-y divide-gray-100 overflow-y-auto">
        <% notifications.forEach((n) => { %>
          <li>
            <a href="<%= n.href || '#' %>" class="flex gap-3 px-4 py-3 hover:bg-gray-50">
              <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full <%= noteTone[n.tone] || 'bg-gray-400' %>" aria-hidden="true"></span>
              <span class="min-w-0">
                <span class="block text-sm text-gray-800"><%= n.text %></span>
                <% if (n.time) { %><span class="block text-xs text-gray-500"><%= n.time %></span><% } %>
              </span>
            </a>
          </li>
        <% }) %>
        <% if (!notifications.length) { %><li class="px-4 py-6 text-center text-sm text-gray-500">Không có thông báo mới.</li><% } %>
      </ul>
    </div>
  </div>

  <!-- Account -->
  <div class="hidden items-center gap-2 border-l border-gray-200 pl-3 xl:flex">
    <% const who = (typeof currentUser !== 'undefined' && currentUser) || { username: '', full_name: '' };
         const initials = (who.full_name || who.username || '?').trim().split(/\s+/).slice(-2).map((w) => w[0]).join('').toUpperCase(); %>
    <span class="flex h-8 w-8 items-center justify-center rounded-sm bg-navy text-xs font-semibold text-white" aria-hidden="true"><%= initials %></span>
    <span class="hidden leading-tight xl:block">
      <span class="block text-sm font-medium"><%= who.full_name || who.username %></span>
      <span class="block text-xs text-gray-500">Quản trị viên</span>
    </span>
  </div>
</header>
