<!DOCTYPE html>
<html lang="vi" class="h-full">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="color-scheme" content="light">
  <meta name="robots" content="noindex, nofollow">
  <meta name="theme-color" content="#1E3A8A">
  <title>Tải ứng dụng <%= meta.name %> cho iPhone/iPad · <%= shopName %></title>
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" href="/brand/favicon-32.png">
  <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png">
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <script nonce="<%= nonce %>">
    tailwind.config = {
      theme: { extend: {
        colors: {
          navy: { 50: '#FAF8F5', 100: '#F1EEE8', 200: '#D9E0F0', 300: '#93A8D8', 600: '#1D4ED8', 700: '#1E3A8A', 800: '#172554', 900: '#0F172A' },
        },
        fontFamily: { sans: ['"Times New Roman"', 'Times', '"Liberation Serif"', 'Tinos', 'serif'] },
        borderRadius: { DEFAULT: '4px', sm: '2px', md: '4px', lg: '6px', xl: '10px' },
      } },
    };
  </script>
  <style>
    :focus-visible { outline: 2px solid #1E3A8A; outline-offset: 2px; }
    .steam { background-image: radial-gradient(circle at 20% 15%, rgba(30,58,138,.08) 0, transparent 45%), radial-gradient(circle at 85% 80%, rgba(30,58,138,.10) 0, transparent 50%); }
  </style>
</head>
<body class="steam min-h-full bg-navy-50 font-sans text-gray-900 antialiased">
  <main class="mx-auto flex min-h-screen w-full max-w-lg flex-col px-4 py-8 sm:py-12">
    <%# Three states: a TestFlight / App Store link set in Cài đặt (works on any iPhone, so it comes first; an ad-hoc
        build is then the alternative for registered devices), only an ad-hoc build published in releases/ios/
        (installs over the air on registered devices), or neither. `release`/`installUrl` come from
        services/iosRelease.js, `app` from services/iosApp.js (routes/downloadRoutes.js). %>
    <% const step = (n) => `<span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-navy-100 text-xs font-semibold text-navy-800">${n}</span>`; %>
    <% const serverLine = `Khi đăng nhập, kiểm tra địa chỉ máy chủ trong ứng dụng là <code class="font-mono text-navy-700">${host}</code> (đổi được ngay trên màn hình đăng nhập của ứng dụng).`; %>

    <header class="flex items-center gap-4">
      <img src="/brand/mark.png" alt="" width="256" height="200" class="h-16 w-auto shrink-0">
      <div class="min-w-0">
        <h1 class="text-2xl font-semibold text-navy-800"><%= meta.name %></h1>
        <p class="text-sm text-gray-500">Ứng dụng iPhone và iPad quản lý quán · <%= shopName %></p>
      </div>
    </header>

    <% if (release && !app) { %>
      <section class="mt-6 rounded-xl border border-navy-200 bg-white p-6 shadow-[0_10px_30px_-12px_rgba(30,58,138,.25)]" aria-labelledby="ota-title">
        <h2 id="ota-title" class="sr-only">Cài đặt trực tiếp</h2>
        <dl class="grid grid-cols-3 gap-3 text-center">
          <div>
            <dt class="text-xs uppercase tracking-wide text-gray-500">Phiên bản</dt>
            <dd class="mt-1 text-sm font-semibold text-navy-800"><%= release.version_name %> <span class="text-xs font-normal text-gray-400">(<%= release.version_code %>)</span></dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-wide text-gray-500">Dung lượng</dt>
            <dd class="mt-1 text-sm font-semibold text-navy-800"><%= release.sizeLabel %></dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-wide text-gray-500">Yêu cầu</dt>
            <dd class="mt-1 text-sm font-semibold text-navy-800">iOS <%= release.min_ios %> trở lên</dd>
          </div>
        </dl>
        <a id="ios-install" href="<%= installUrl %>"
          class="mt-5 inline-flex h-12 w-full items-center justify-center gap-2 rounded text-base font-semibold bg-navy-700 text-white hover:bg-navy-800 active:bg-navy-900">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v12M7 11l5 5 5-5M4 20h16"/></svg>
          Cài đặt trực tiếp · <%= release.sizeLabel %>
        </a>
        <a id="ios-download" href="/download/ios/app.ipa?v=<%= release.sha256.slice(0, 12) %>" download="<%= release.downloadName %>"
          class="mt-3 inline-flex h-12 w-full items-center justify-center gap-2 rounded text-base font-semibold border border-navy-300 bg-white text-navy-700 hover:bg-navy-100">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v12M7 11l5 5 5-5M4 20h16"/></svg>
          Tải tệp .ipa · <%= release.sizeLabel %>
        </a>
        <p class="mt-3 text-center text-xs text-gray-500">Bản nội bộ cho máy đã đăng ký · phát hành <%= release.builtAtLabel %> · tệp <code class="font-mono"><%= release.downloadName %></code>. Tệp .ipa dùng khi cài qua máy tính (Finder / Apple Configurator).</p>
      </section>

      <section class="mt-6 rounded-xl border border-navy-200 bg-white p-6" aria-labelledby="steps-title">
        <h2 id="steps-title" class="text-base font-semibold text-navy-800">Cách cài đặt</h2>
        <ol class="mt-3 space-y-3 text-sm text-gray-700">
          <li class="flex gap-3"><%- step(1) %><span>Mở trang này bằng <b>Safari</b> trên chính chiếc iPhone/iPad cần cài (các trình duyệt khác không cài được).</span></li>
          <li class="flex gap-3"><%- step(2) %><span>Nhấn <b>Cài đặt trực tiếp</b> rồi chọn <b>Cài đặt</b> trong hộp thoại của iOS. Biểu tượng <b><%= meta.name %></b> xuất hiện ở màn hình chính và tải xong sau vài phút.</span></li>
          <li class="flex gap-3"><%- step(3) %><span>Mở <b><%= meta.name %></b> và đăng nhập bằng tài khoản dùng trên trang quản trị. <%- serverLine %></span></li>
        </ol>
        <p class="mt-4 text-xs text-gray-500">Chỉ cài được trên máy đã đăng ký với quản trị viên (Apple cho tối đa 100 máy mỗi năm). Nếu iOS báo <b>Không thể cài đặt</b>, máy này chưa được đăng ký: gửi UDID cho quản trị viên và chờ bản tiếp theo. Cập nhật: quét lại mã QR và cài đè, dữ liệu đăng nhập giữ nguyên. Bản nội bộ dùng được 1 năm kể từ ngày phát hành.</p>
      </section>
    <% } else if (app) { %>
      <section class="mt-6 rounded-xl border border-navy-200 bg-white p-6 shadow-[0_10px_30px_-12px_rgba(30,58,138,.25)]" aria-labelledby="dl-title">
        <h2 id="dl-title" class="sr-only">Cài đặt</h2>
        <dl class="grid grid-cols-3 gap-3 text-center">
          <div>
            <dt class="text-xs uppercase tracking-wide text-gray-500">Phát hành qua</dt>
            <dd class="mt-1 text-sm font-semibold text-navy-800"><%= app.label %></dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-wide text-gray-500">Yêu cầu</dt>
            <dd class="mt-1 text-sm font-semibold text-navy-800">iOS <%= meta.minIos %> trở lên</dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-wide text-gray-500">Thiết bị</dt>
            <dd class="mt-1 text-sm font-semibold text-navy-800">iPhone, iPad</dd>
          </div>
        </dl>
        <a id="ios-link" href="<%= app.url %>" rel="noopener"
          class="mt-5 inline-flex h-12 w-full items-center justify-center gap-2 rounded bg-navy-700 text-base font-semibold text-white hover:bg-navy-800 active:bg-navy-900">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v12M7 11l5 5 5-5M4 20h16"/></svg>
          <%= app.action %>
        </a>
        <% if (app.kind === 'testflight') { %>
          <p class="mt-3 text-center text-xs text-gray-500">Bản thử nghiệm (beta) phát hành qua TestFlight của Apple: cần cài ứng dụng TestFlight trước, miễn phí.</p>
        <% } else { %>
          <p class="mt-3 text-center text-xs text-gray-500">Bản chính thức trên App Store.</p>
        <% } %>
      </section>

      <section class="mt-6 rounded-xl border border-navy-200 bg-white p-6" aria-labelledby="steps-title">
        <h2 id="steps-title" class="text-base font-semibold text-navy-800">Cách cài đặt</h2>
        <ol class="mt-3 space-y-3 text-sm text-gray-700">
          <% if (app.kind === 'testflight') { %>
            <li class="flex gap-3"><%- step(1) %><span>Cài ứng dụng <b>TestFlight</b> từ App Store: <a href="https://apps.apple.com/app/testflight/id899247664" rel="noopener" class="font-semibold text-navy-700 hover:underline">Tải TestFlight</a>.</span></li>
            <li class="flex gap-3"><%- step(2) %><span>Quay lại trang này, nhấn <b>Mở trong TestFlight</b>, rồi chọn <b>Chấp nhận</b> (Accept) và <b>Cài đặt</b> (Install).</span></li>
            <li class="flex gap-3"><%- step(3) %><span>Mở <b><%= meta.name %></b> và đăng nhập bằng tài khoản dùng trên trang quản trị. <%- serverLine %></span></li>
          <% } else { %>
            <li class="flex gap-3"><%- step(1) %><span>Nhấn <b>Tải trên App Store</b> rồi chọn <b>Nhận</b> (Get) và xác nhận bằng Face ID / mật khẩu Apple.</span></li>
            <li class="flex gap-3"><%- step(2) %><span>Mở <b><%= meta.name %></b> và đăng nhập bằng tài khoản dùng trên trang quản trị. <%- serverLine %></span></li>
          <% } %>
        </ol>
        <p class="mt-4 text-xs text-gray-500"><% if (app.kind === 'testflight') { %>Cập nhật: TestFlight tự báo khi có bản mới; mỗi bản thử nghiệm dùng được 90 ngày, sau đó cài bản mới từ chính TestFlight.<% } else { %>Cập nhật: App Store tự cập nhật ứng dụng như mọi ứng dụng khác.<% } %></p>
      </section>

      <% if (release) { %>
        <%# The ad-hoc build for devices whose UDID is in the profile: no TestFlight app needed, Safari installs it. %>
        <section class="mt-6 rounded-xl border border-navy-200 bg-white p-5 text-sm text-gray-700" aria-labelledby="alt-title">
          <h2 id="alt-title" class="text-base font-semibold text-navy-800">Máy đã đăng ký với quản trị viên?</h2>
          <p class="mt-1">Cài thẳng bản nội bộ <%= release.version_name %> (<%= release.sizeLabel %>) mà không cần TestFlight: mở trang này bằng <b>Safari</b> rồi nhấn
            <a id="ios-install" href="<%= installUrl %>" class="font-semibold text-navy-700 hover:underline">Cài đặt trực tiếp</a>,
            hoặc <a id="ios-download" href="/download/ios/app.ipa?v=<%= release.sha256.slice(0, 12) %>" download="<%= release.downloadName %>" class="font-semibold text-navy-700 hover:underline">tải tệp .ipa</a> để cài qua máy tính.</p>
          <p class="mt-1 text-xs text-gray-500">Phát hành <%= release.builtAtLabel %> · tệp <code class="font-mono"><%= release.downloadName %></code>. Máy chưa đăng ký sẽ báo <b>Không thể cài đặt</b>: dùng <%= app.label %> ở trên.</p>
        </section>
      <% } %>
    <% } else { %>
      <section class="mt-6 rounded-xl border border-navy-200 bg-white p-6 shadow-[0_10px_30px_-12px_rgba(30,58,138,.25)]" aria-labelledby="dl-title">
        <h2 id="dl-title" class="sr-only">Cài đặt</h2>
        <dl class="grid grid-cols-3 gap-3 text-center">
          <div>
            <dt class="text-xs uppercase tracking-wide text-gray-500">Phiên bản</dt>
            <dd class="mt-1 text-sm font-semibold text-gray-400">chưa có</dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-wide text-gray-500">Yêu cầu</dt>
            <dd class="mt-1 text-sm font-semibold text-navy-800">iOS <%= meta.minIos %> trở lên</dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-wide text-gray-500">Thiết bị</dt>
            <dd class="mt-1 text-sm font-semibold text-navy-800">iPhone, iPad</dd>
          </div>
        </dl>
        <span id="ios-install-pending" role="button" aria-disabled="true" class="mt-5 inline-flex h-12 w-full items-center justify-center gap-2 rounded text-base font-semibold cursor-not-allowed bg-gray-300 text-white">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v12M7 11l5 5 5-5M4 20h16"/></svg>
          Cài đặt trực tiếp · chưa có bản cài
        </span>
        <span id="ios-download-pending" role="button" aria-disabled="true" class="mt-3 inline-flex h-12 w-full items-center justify-center gap-2 rounded text-base font-semibold cursor-not-allowed border border-gray-300 bg-white text-gray-400">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v12M7 11l5 5 5-5M4 20h16"/></svg>
          Tải tệp .ipa · chưa có bản cài
        </span>
        <p class="mt-3 text-center text-xs text-gray-500">Hai nút hoạt động ngay khi bản iPhone/iPad đầu tiên được đưa lên máy chủ; quét lại mã QR trên trang đăng nhập sau nhé.</p>
      </section>
      <section class="mt-6 rounded-xl border border-amber-200 bg-amber-50 p-5 text-sm text-amber-900" role="status">
        <p class="font-semibold">Bản iPhone/iPad đang được chuẩn bị.</p>
        <p class="mt-1 text-xs">Quản trị viên: phát hành bản nội bộ bằng <code class="font-mono">scripts/publish-ipa.js</code> rồi deploy, hoặc dán liên kết TestFlight / App Store vào <b>Cài đặt → Ứng dụng iOS</b> (hướng dẫn: <code class="font-mono">docs/ios-testflight.md</code>).</p>
      </section>
    <% } %>

    <section class="mt-6 grid items-center gap-5 rounded-xl border border-navy-200 bg-white p-6 sm:grid-cols-[auto_1fr]" aria-labelledby="share-title">
      <img src="/download/ios/qr.svg" alt="Mã QR dẫn tới trang này" width="144" height="144" class="mx-auto h-36 w-36 rounded border border-navy-100 bg-white p-1">
      <div class="min-w-0 text-center sm:text-left">
        <h2 id="share-title" class="text-base font-semibold text-navy-800">Chia sẻ cho nhân viên</h2>
        <p class="mt-1 text-sm text-gray-600">Quét mã bằng camera iPhone/iPad để mở trang này, hoặc gửi liên kết:</p>
        <p class="mt-1 break-all font-mono text-sm text-navy-700"><%= pageUrl %></p>
      </div>
    </section>

    <% if (release) { %>
      <details class="mt-6 text-xs text-gray-500">
        <summary class="cursor-pointer select-none">Kiểm tra toàn vẹn tệp (SHA-256)</summary>
        <p class="mt-2 break-all font-mono"><%= release.sha256 %></p>
        <p class="mt-1">Gói ứng dụng: <code class="font-mono"><%= release.bundle_id %></code></p>
      </details>
    <% } %>

    <p class="mt-6 text-center text-xs text-gray-500">Dùng điện thoại Android? <a href="/download" class="font-semibold text-navy-700 hover:underline">Tải bản Android</a></p>

    <footer class="mt-auto pt-8 text-center text-xs text-gray-400">© <%= new Date().getFullYear() %> <%= shopName %> · <a href="/admin/login" class="hover:underline">Trang quản trị</a></footer>
  </main>
</body>
</html>
