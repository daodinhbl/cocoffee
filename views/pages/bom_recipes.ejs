<%
  const badgeTone = { good: 'border-green-200 bg-green-50 text-green-700', warn: 'border-amber-200 bg-amber-50 text-amber-800', bad: 'border-red-200 bg-red-50 text-red-700' };
  const barTone = { good: 'bg-green-500', warn: 'bg-amber-400', bad: 'bg-red-500' };
  const MAX_BADGES = 4;
  const { input, btnGhost, btnSecondary, sheet, grabber } = ui;
  const card = 'rounded-xl border border-milk-200 bg-white shadow-[0_1px_2px_rgba(15,23,42,.04)]';
  const editable = tab === 'drinks';
  const offset = (page - 1) * pageSize;
%>

<!-- ===== Page header ===== -->
<div class="flex flex-wrap items-start justify-between gap-4">
  <div>
    <h1 class="text-xl font-semibold tracking-tight text-navy-darker sm:text-2xl">Quản lý định mức (BOM)</h1>
    <p class="mt-1 max-w-2xl text-sm text-gray-500">Công thức nguyên liệu, giá vốn (COGS) và tỷ lệ lợi nhuận của từng món. Kho tự trừ theo định mức khi đơn hoàn tất; giá vốn tính theo giá bình quân hiện tại của nguyên liệu.</p>
  </div>
  <div class="hidden gap-3 md:flex">
    <button type="button" data-recipe-open="create"
      class="inline-flex h-10 items-center gap-2 rounded bg-amber-400 px-4 text-sm font-semibold text-ink-900 hover:bg-amber-500 active:bg-amber-600">
      + Thêm Công thức
    </button>
  </div>
</div>

<!-- ===== Summary (same look as Nguyên liệu / Thực đơn) ===== -->
<section aria-label="Tóm tắt" class="mt-5 grid grid-cols-2 gap-3 lg:grid-cols-4">
  <div class="<%= card %> px-4 py-3">
    <p class="text-xs font-medium uppercase tracking-wide text-gray-500">Tổng món</p>
    <p class="mt-1 text-2xl font-semibold tnum text-navy-darker"><%= stats.total %></p>
    <p class="text-xs text-milk-500"><%= counts.drinks %> pha chế · <%= counts.retail %> bán lẻ</p>
  </div>
  <a href="<%= tabUrl('drinks', { missing: true }) %>" class="<%= card %> block px-4 py-3 transition hover:border-red-300">
    <p class="text-xs font-medium uppercase tracking-wide text-gray-500">Thiếu định mức</p>
    <p class="mt-1 text-2xl font-semibold tnum <%= stats.missing ? 'text-red-700' : 'text-navy-darker' %>"><%= stats.missing %></p>
    <p class="text-xs text-milk-500"><%= stats.missing ? 'Cần nhập công thức →' : 'Đủ công thức' %></p>
  </a>
  <div class="<%= card %> px-4 py-3">
    <p class="text-xs font-medium uppercase tracking-wide text-gray-500">Lợi nhuận TB</p>
    <p class="mt-1 text-2xl font-semibold tnum text-navy-darker"><%= pct(stats.avgMargin) %></p>
    <p class="text-xs text-milk-500">(Giá bán − COGS) / Giá bán</p>
  </div>
  <div class="<%= card %> px-4 py-3">
    <p class="text-xs font-medium uppercase tracking-wide text-gray-500">Lợi nhuận thấp (&lt; 55%)</p>
    <p class="mt-1 text-2xl font-semibold tnum <%= stats.low ? 'text-amber-700' : 'text-navy-darker' %>"><%= stats.low %></p>
    <p class="text-xs text-milk-500">Nên xem lại giá bán / định mức</p>
  </div>
</section>

<!-- ===== One filter card: search, tab, missing-only, category chips ===== -->
<section class="mt-6" aria-label="Bộ lọc">
  <div class="<%= card %> p-3 sm:p-4">
    <div class="flex flex-col gap-3 lg:flex-row lg:items-center">
      <form method="get" action="/admin/bom-recipes" role="search" class="relative lg:w-80">
        <input type="hidden" name="tab" value="<%= tab %>">
        <% if (cat) { %><input type="hidden" name="cat" value="<%= cat %>"><% } %>
        <% if (missing) { %><input type="hidden" name="missing" value="1"><% } %>
        <label for="bom-q" class="sr-only">Tìm công thức</label>
        <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"><%- icon('search', 'h-4 w-4') %></span>
        <input id="bom-q" name="q" type="search" value="<%= q %>" autocomplete="off" enterkeyhint="search" placeholder="Tìm theo tên món, nguyên liệu… (Enter)" class="<%= input %> pl-9">
      </form>
      <div role="group" aria-label="Loại món" class="inline-flex w-full rounded-lg bg-milk-50 p-1 lg:w-auto">
        <% [['drinks', 'Đồ uống pha chế', counts.drinks], ['retail', 'Hàng bán lẻ', counts.retail]].forEach(([id, text, n]) => { const on = tab === id; %>
          <a href="<%= tabUrl(id, { reset: true }) %>" <%- on ? 'aria-current="page"' : '' %>
             class="inline-flex h-9 flex-1 items-center justify-center gap-2 rounded-md px-3 text-sm font-medium transition lg:flex-none <%= on ? 'bg-white text-navy-darker shadow' : 'text-gray-600 hover:text-dark' %>"><%= text %> <span class="tnum text-xs opacity-70"><%= n %></span></a>
        <% }) %>
      </div>
      <% if (editable) { %>
        <a href="<%= tabUrl('drinks', { missing: !missing }) %>" <%- missing ? 'aria-current="true"' : '' %>
           class="inline-flex h-9 items-center gap-2 rounded-full border px-3.5 text-sm font-medium transition <%= missing ? 'border-red-300 bg-red-50 text-red-700' : 'border-milk-200 bg-white text-dark hover:border-navy-accent' %>">Chỉ món thiếu định mức <span class="tnum text-xs opacity-70"><%= stats.missing %></span></a>
      <% } %>
      <p class="text-sm text-gray-500 lg:ml-auto" aria-live="polite"><span class="font-semibold tnum text-dark"><%= total %></span> món<%= q ? ` khớp “${q}”` : '' %></p>
    </div>
    <nav aria-label="Nhóm món" class="no-scrollbar mt-3 flex gap-2 overflow-x-auto pb-1 lg:flex-wrap">
      <% [{ id: '', name: 'Tất cả', n: tabRows }, ...catChips].forEach((c) => { const on = String(cat || '') === String(c.id); %>
        <a href="<%= tabUrl(tab, { cat: c.id }) %>" <%- on ? 'aria-current="page"' : '' %>
           class="inline-flex h-9 shrink-0 items-center gap-2 rounded-full border px-3.5 text-sm font-medium transition <%= on ? 'border-navy bg-navy text-white' : 'border-milk-200 bg-white text-dark hover:border-navy-accent' %>"><%= c.name %> <span class="tnum text-xs opacity-70"><%= c.n %></span></a>
      <% }) %>
    </nav>
  </div>
</section>

<section class="pt-4" aria-label="Danh sách công thức">
  <% if (!editable) { %>
    <p class="mb-3 text-sm text-gray-600">Hàng bán lẻ trừ kho 1:1 theo một mặt hàng; giá vốn lấy từ giá bình quân của mặt hàng đó. Chỉnh giá và liên kết kho ở <a href="/admin/menu" class="font-medium underline">Thực đơn</a>.</p>
  <% } %>
  <div class="<%= card %> relative overflow-x-auto max-lg:border-0 max-lg:bg-transparent max-lg:shadow-none max-lg:overflow-visible">
    <table class="rtable rtable-bom w-full border-collapse text-left text-sm lg:min-w-[880px] xl:min-w-[960px]">
      <caption class="sr-only">Danh sách công thức — <%= editable ? 'Đồ uống pha chế' : 'Hàng bán lẻ' %></caption>
      <thead class="<%= ui.thead %>">
        <tr>
          <th scope="col" class="w-12 px-2 py-3 text-center sm:px-4">STT</th>
          <th scope="col" class="px-4 py-3">Tên món</th>
          <th scope="col" class="px-4 py-3">Nguyên liệu thành phần</th>
          <th scope="col" class="px-4 py-3 text-right">Chi phí vốn (COGS)</th>
          <th scope="col" class="px-4 py-3 text-right">Giá bán</th>
          <th scope="col" class="px-4 py-3">Tỷ lệ lợi nhuận</th>
          <th scope="col" class="px-4 py-3 text-right"><span class="sr-only">Hành động</span></th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach((r, idx) => {
             const stt = offset + idx + 1;
             const tone = marginTone(r.margin);
             const shown = r.ingredients.slice(0, MAX_BADGES);
             const rest = r.ingredients.slice(MAX_BADGES);
             const payload = { id: r.id, name: r.name, sku: r.sku, price: r.price, category_id: r.category_id, image_url: r.image_url || null, lines: r.ingredients.map((g) => ({ ref: g.ref, qty: g.qty })) };
        %>
          <tr data-row class="border-b border-gray-200 <%= stt % 2 === 1 ? 'bg-blue-50/70 hover:bg-blue-100/70' : 'hover:bg-gray-50' %>">
            <td data-label="" class="rt-no px-2 py-3 text-center align-top font-mono text-xs text-milk-500 tnum sm:px-4"><%= stt %></td>
            <td data-label="" class="rt-title px-4 py-3 align-top">
              <p class="font-medium text-gray-900 max-lg:text-base"><%= r.name %></p>
              <p class="mt-0.5 font-mono text-xs text-gray-500"><%= r.sku %> · <%= r.category_name %></p>
            </td>
            <td data-label="Nguyên liệu" class="rt-ingredients px-4 py-3 align-top">
              <% if (!r.ingredients.length) { %>
                <span class="inline-flex items-center rounded-sm border border-red-200 bg-red-50 px-2 py-0.5 text-xs font-medium text-red-700">Chưa có định mức</span>
              <% } else { %>
              <ul class="flex flex-wrap gap-1.5" aria-label="Nguyên liệu của <%= r.name %>">
                <% shown.forEach((g) => { %>
                  <li class="inline-flex items-center gap-1 rounded-sm border border-gray-200 bg-white px-2 py-0.5 text-xs text-gray-700">
                    <%= g.name %> <span class="font-mono text-gray-500"><%= num(g.qty) %><%= g.unit %></span>
                  </li>
                <% }) %>
                <% if (rest.length) { %>
                  <li title="<%= rest.map((g) => `${g.name} ${num(g.qty)}${g.unit}`).join(', ') %>"
                    class="inline-flex items-center rounded-sm border border-dashed border-gray-300 px-2 py-0.5 text-xs text-gray-500">+<%= rest.length %> nữa</li>
                <% } %>
              </ul>
              <% } %>
            </td>
            <td data-label="Giá vốn (COGS)" class="rt-cogs px-4 py-3 text-right align-top font-mono tnum max-lg:text-base max-lg:font-semibold"><%= money(r.cogs) %></td>
            <td data-label="Giá bán" class="rt-price px-4 py-3 text-right align-top font-mono tnum max-lg:text-base max-lg:font-semibold"><%= money(r.price) %></td>
            <td data-label="" class="rt-margin px-4 py-3 align-top">
              <span class="inline-flex items-center rounded-sm border px-2 py-0.5 font-mono text-xs font-medium tnum <%= badgeTone[tone] %>" title="Tỷ lệ lợi nhuận"><%= pct(r.margin) %></span>
              <div class="mt-2 h-1 w-24 rounded-sm bg-gray-100 max-lg:ml-auto" role="img" aria-label="Tỷ lệ lợi nhuận <%= pct(r.margin) %>">
                <div class="h-1 rounded-sm <%= barTone[tone] %>" style="width: <%= Math.max(0, Math.min(100, r.margin)).toFixed(1) %>%"></div>
              </div>
            </td>
            <td data-label="" class="rt-actions px-4 py-3 text-right align-top">
              <% if (editable) { %>
              <div class="inline-flex items-center gap-1">
                <button type="button" data-recipe-open="edit" data-recipe="<%= safeJson(payload) %>" class="<%= btnGhost %>" aria-label="Sửa <%= r.name %>" title="Sửa">
                  <%- icon('pencil', 'h-4 w-4') %><span class="btn-label">Sửa</span>
                </button>
                <form method="post" action="/admin/bom-recipes/<%= r.id %>/delete" data-confirm="Ngừng bán “<%= r.name %>”? Món sẽ biến mất khỏi POS và chatbot Zalo, lịch sử đơn vẫn được giữ. Có thể bật lại ở trang Thực đơn.">
                  <%- include('../partials/csrf') %>
                  <button type="submit" class="<%= btnGhost %> hover:!bg-red-50 hover:!text-red-600" aria-label="Ngừng bán <%= r.name %>" title="Ngừng bán">
                    <%- icon('trash', 'h-4 w-4') %><span class="btn-label">Ngừng bán</span>
                  </button>
                </form>
              </div>
              <% } else { %>
                <a href="/admin/menu" class="<%= btnGhost %> w-auto px-2 text-xs font-medium">Thực đơn</a>
              <% } %>
            </td>
          </tr>
        <% }) %>
        <% if (!rows.length) { %>
          <tr data-empty>
            <td colspan="7" data-label="" class="px-4 py-12 text-center text-sm text-gray-500"><%= (q || cat || missing) ? 'Không có công thức phù hợp.' : 'Chưa có món nào.' %></td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <%- include('../partials/pager', { page, pages, total, pageSize, pageUrl, unit: 'món' }) %>
  <p class="mt-3 text-xs text-gray-500">Tỷ lệ lợi nhuận = (Giá bán − COGS) / Giá bán. <span class="font-medium text-green-700">≥ 65%</span> tốt · <span class="font-medium text-amber-700">55–65%</span> cần xem lại · <span class="font-medium text-red-700">&lt; 55%</span> thấp.</p>
</section>

<!-- ===== Dialog: add / edit recipe (bottom sheet on phones) ===== -->
<dialog id="recipe-dialog" aria-labelledby="recipe-title" class="max-w-2xl max-sm:h-[94dvh] <%= sheet %>">
  <form id="recipe-form" method="post" action="/admin/bom-recipes" novalidate class="flex max-h-[calc(100dvh-2rem)] flex-col max-sm:h-full max-sm:max-h-none">
    <%- include('../partials/csrf') %>
    <input type="hidden" name="recipe" id="f-recipe" value="[]">
    <%- grabber %>
    <div class="flex items-center justify-between border-b border-gray-200 px-4 py-3 sm:px-6 sm:py-4">
      <h2 id="recipe-title" class="text-lg font-semibold">Thêm công thức</h2>
      <button type="button" data-modal-close aria-label="Đóng" class="<%= btnGhost %>"><%- icon('x', 'h-5 w-5') %></button>
    </div>

    <div class="space-y-5 overflow-y-auto px-4 py-4 sm:px-6 sm:py-5">
      <div class="grid grid-cols-12 gap-4">
        <div class="col-span-12 sm:col-span-6">
          <label for="f-name" class="mb-1 block text-sm font-medium">Tên món</label>
          <input id="f-name" name="name" required maxlength="150" class="<%= input %>" placeholder="VD: Cà phê sữa đá" autocomplete="off">
        </div>
        <div class="col-span-6 sm:col-span-3">
          <label for="f-sku" class="mb-1 block text-sm font-medium">Mã (SKU)</label>
          <input id="f-sku" name="sku" required maxlength="40" class="<%= input %> font-mono read-only:bg-gray-50 read-only:text-gray-500" placeholder="CF-SUA-DA" autocomplete="off" autocapitalize="characters">
        </div>
        <div class="col-span-6 sm:col-span-3">
          <label for="f-price" class="mb-1 block text-sm font-medium">Giá bán (đ)</label>
          <input id="f-price" name="price" type="number" min="0" step="500" required inputmode="numeric" class="<%= input %> text-right font-mono">
        </div>
        <div class="col-span-12 sm:col-span-6">
          <label for="f-category" class="mb-1 block text-sm font-medium">Nhóm món</label>
          <select id="f-category" name="category_id" required class="<%= input %>">
            <% categories.forEach((c) => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %>
          </select>
        </div>
      </div>

      <%- include('../partials/image_field', { fieldId: 'f-img' }) %>

      <div>
        <div class="mb-2 flex items-center justify-between">
          <h3 class="text-sm font-semibold" data-lines-title>Nguyên liệu</h3>
          <button type="button" data-line-add class="inline-flex h-9 items-center gap-1.5 rounded border border-gray-300 px-3 text-sm font-medium hover:bg-gray-50">
            <%- icon('plus', 'h-4 w-4') %> Thêm dòng
          </button>
        </div>
        <div class="hidden grid-cols-12 gap-2 px-1 pb-1 text-xs font-semibold uppercase tracking-wide text-gray-500 sm:grid">
          <span class="col-span-6">Thành phần</span><span class="col-span-2 text-right">Định lượng</span><span class="col-span-1">Đơn vị</span><span class="col-span-2 text-right">Thành tiền</span><span class="col-span-1"></span>
        </div>
        <div id="recipe-lines" class="space-y-2"></div>
      </div>

      <!-- live cost -->
      <dl class="grid grid-cols-3 gap-3 rounded border border-gray-200 bg-gray-50 p-3 text-sm sm:gap-4 sm:p-4">
        <div><dt class="text-xs text-gray-500">Chi phí vốn (COGS)</dt><dd data-cogs class="mt-1 font-mono text-sm font-semibold tnum sm:text-base">0đ</dd></div>
        <div><dt class="text-xs text-gray-500">Lãi gộp</dt><dd data-profit class="mt-1 font-mono text-sm font-semibold tnum sm:text-base">—</dd></div>
        <div><dt class="text-xs text-gray-500">Tỷ lệ lợi nhuận</dt><dd data-margin class="mt-1 font-mono text-sm font-semibold tnum sm:text-base">—</dd></div>
      </dl>
    </div>

    <!-- sticky action bar: stays in thumb reach, clears the home indicator -->
    <div class="flex items-center justify-end gap-3 border-t border-gray-200 px-4 py-3 max-sm:pb-[calc(0.75rem+env(safe-area-inset-bottom))] sm:px-6 sm:py-4">
      <button type="button" data-modal-close class="inline-flex h-10 items-center justify-center rounded border border-gray-300 bg-white px-4 text-sm font-medium hover:bg-gray-50 max-sm:flex-1">Hủy</button>
      <button type="submit" class="inline-flex h-10 items-center justify-center rounded bg-amber-400 px-5 text-sm font-semibold text-ink-900 hover:bg-amber-500 max-sm:flex-[2]">Lưu công thức</button>
    </div>
  </form>
</dialog>

<template id="recipe-line-tpl">
  <!-- phones: card with [select | ✕] on top, [qty | unit | cost] below; from sm: one grid row -->
  <div data-line class="grid grid-cols-12 items-center gap-2 rounded border border-gray-200 p-2 sm:border-0 sm:p-0">
    <select data-line-ref aria-label="Thành phần" class="<%= input %> order-1 col-span-10 sm:order-none sm:col-span-6"></select>
    <button type="button" data-line-remove aria-label="Xóa dòng" class="<%= btnGhost %> order-2 col-span-2 justify-self-end sm:order-none sm:col-span-1"><%- icon('x', 'h-4 w-4') %></button>
    <input data-line-qty type="number" min="0" step="any" inputmode="decimal" aria-label="Định lượng" class="<%= input %> order-3 col-span-5 text-right font-mono sm:order-none sm:col-span-2">
    <span data-line-unit class="order-4 col-span-2 text-sm text-gray-500 sm:order-none sm:col-span-1"></span>
    <span data-line-cost class="order-5 col-span-5 text-right font-mono text-sm tnum sm:order-none sm:col-span-2">0đ</span>
  </div>
</template>

<!-- Catalog for the dialog (data block, never executed): raw materials with their current average cost -->
<script type="application/json" id="recipe-catalog"><%- safeJson(catalog) %></script>
