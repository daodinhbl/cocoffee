<%
  const { input, btnPrimary, btnSecondary } = ui;
  const sel = (a, b) => (a === b ? 'selected' : '');
  const card = 'rounded-xl border border-milk-200 bg-white shadow-[0_1px_2px_rgba(15,23,42,.04)]';
  const swipe = 'min-w-[60%] shrink-0 snap-start sm:min-w-0';
  // Pagination numbers: first, last, current ± 1, with ellipsis gaps
  const nums = [...new Set([1, page - 1, page, page + 1, pages])].filter((n) => n >= 1 && n <= pages).sort((a, b) => a - b);
%>
<div class="flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="text-2xl font-semibold tracking-tight text-navy-darker">Khách hàng</h1>
    <p class="mt-1 text-sm text-milk-500">Danh bạ khách hàng và sổ công nợ. Bấm vào khách để thu nợ (được thu một phần) hoặc điều chỉnh công nợ.</p>
  </div>
  <div class="flex gap-2">
    <a href="/admin/customers/reconciliation" class="<%= btnSecondary %>"><%- icon('chart','h-4 w-4') %> Đối chiếu công nợ</a>
    <a href="/admin/customers/new" class="<%= btnPrimary %>"><%-icon('plus','h-4 w-4')%> Thêm khách hàng</a>
  </div>
</div>

<!-- Summary cards -->
<section aria-label="Tổng quan" class="no-scrollbar -mx-4 mt-5 flex snap-x gap-3 overflow-x-auto px-4 pb-1 sm:mx-0 sm:grid sm:grid-cols-3 sm:gap-5 sm:overflow-visible sm:px-0">
  <div class="<%= card %> <%= swipe %> p-4">
    <div class="flex items-start justify-between gap-2">
      <p class="text-xs font-semibold uppercase tracking-wide text-milk-500">Tổng khách hàng</p>
      <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-milk-100 text-navy" aria-hidden="true"><%- icon('users','h-5 w-5') %></span>
    </div>
    <p class="mt-1 font-mono text-2xl font-bold text-navy-darker tnum"><%= stats.total_customers %></p>
    <p class="mt-1 text-xs text-milk-500">Trong hệ thống</p>
  </div>
  <a href="/admin/customers?debt=1" class="<%= card %> <%= swipe %> block p-4 transition hover:border-amber-300">
    <div class="flex items-start justify-between gap-2">
      <p class="text-xs font-semibold uppercase tracking-wide text-milk-500">Còn công nợ</p>
      <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-amber-50 text-amber-700" aria-hidden="true"><%- icon('receipt','h-5 w-5') %></span>
    </div>
    <p class="mt-1 font-mono text-2xl font-bold tnum <%= stats.debt_customers > 0 ? 'text-amber-700' : 'text-navy-darker' %>"><%= stats.debt_customers %></p>
    <p class="mt-1 text-xs text-milk-500"><%= stats.debt_customers > 0 ? 'Khách đang nợ →' : 'Không có nợ' %></p>
  </a>
  <div class="<%= card %> <%= swipe %> p-4">
    <div class="flex items-start justify-between gap-2">
      <p class="text-xs font-semibold uppercase tracking-wide text-milk-500">Tổng công nợ</p>
      <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-red-50 text-red-700" aria-hidden="true"><%- icon('chart','h-5 w-5') %></span>
    </div>
    <p class="mt-1 font-mono text-2xl font-bold tnum <%= Number(stats.total_debt) > 0 ? 'text-red-700' : 'text-navy-darker' %>"><%= money(stats.total_debt) %></p>
    <p class="mt-1 text-xs text-milk-500">Tổng số dư tất cả nợ</p>
  </div>
</section>

<!-- Filters -->
<form method="get" action="/admin/customers" class="<%= card %> mt-4 p-3 sm:p-4">
  <div class="grid grid-cols-2 gap-3 md:grid-cols-12">
    <div class="relative col-span-2 md:col-span-5">
      <label for="c-q" class="sr-only">Tìm khách hàng</label>
      <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-milk-500"><%- icon('search','h-4 w-4') %></span>
      <input id="c-q" name="q" type="search" value="<%= filters.q %>" placeholder="Tên, số điện thoại hoặc Zalo ID" maxlength="60" class="<%= input %> pl-9" autocomplete="off">
    </div>
    <div class="col-span-1 md:col-span-2">
      <label for="c-debt" class="sr-only">Lọc công nợ</label>
      <select id="c-debt" name="debt" class="<%= input %>">
        <option value="">Mọi khách</option>
        <option value="1" <%= filters.debtOnly ? 'selected' : '' %>>Còn nợ</option>
      </select>
    </div>
    <div class="col-span-1 md:col-span-2">
      <label for="c-zalo" class="sr-only">Lọc Zalo</label>
      <select id="c-zalo" name="zalo" class="<%= input %>">
        <option value="">Mọi kênh</option>
        <option value="1" <%= filters.zaloOnly ? 'selected' : '' %>>Có Zalo</option>
      </select>
    </div>
    <div class="col-span-2 flex gap-2 md:col-span-3">
      <button type="submit" class="<%= btnPrimary %> flex-1">Lọc</button>
      <% if (hasFilter) { %><a href="/admin/customers" class="<%= btnSecondary %>" title="Xóa bộ lọc">Xóa</a><% } %>
    </div>
  </div>
</form>

<p class="mt-4 text-sm text-milk-500" aria-live="polite">
  <% if (total) { %>Hiển thị <span class="font-mono font-medium text-dark tnum"><%= from %>–<%= to %></span> / <span class="font-mono tnum"><%= total %></span> khách hàng<% } else { %>Không tìm thấy khách hàng nào.<% } %>
</p>

<!-- Table / card list -->
<div class="<%= card %> mt-3 overflow-hidden max-lg:border-0 max-lg:bg-transparent max-lg:shadow-none">
  <% if (!customers.length) { %>
    <div class="flex flex-col items-center px-5 py-14 text-center">
      <span class="flex h-14 w-14 items-center justify-center rounded-full bg-milk-100 text-milk-500" aria-hidden="true"><%- icon('users','h-7 w-7') %></span>
      <p class="mt-3 font-medium text-dark">Không có khách hàng nào</p>
      <p class="mt-1 text-sm text-milk-500"><%= hasFilter ? 'Thử bỏ bớt bộ lọc.' : 'Thêm khách hàng đầu tiên bằng nút bên trên.' %></p>
    </div>
  <% } else { %>
  <table class="rtable w-full border-collapse text-left text-sm lg:min-w-[900px]">
    <caption class="sr-only">Danh sách khách hàng</caption>
    <thead class="<%= ui.thead %>">
      <tr>
        <th scope="col" class="px-4 py-3">Tên khách hàng</th>
        <th scope="col" class="px-4 py-3">Liên hệ / Zalo</th>
        <th scope="col" class="px-4 py-3 text-right">Đơn hàng</th>
        <th scope="col" class="px-4 py-3 text-right">Số dư nợ</th>
        <th scope="col" class="px-4 py-3">Cập nhật</th>
        <th scope="col" class="px-4 py-3 text-right"><span class="sr-only">Thao tác</span></th>
      </tr>
    </thead>
    <tbody>
      <% customers.forEach((c) => { %>
        <tr class="border-b border-milk-200 last:border-b-0 hover:bg-milk-50">
          <td data-label="" class="rt-title px-4 py-3">
            <a href="/admin/customers/<%= c.id %>" class="font-medium text-blue-700 hover:text-navy hover:underline"><%= c.name %></a>
            <% if (c.note) { %><span class="block text-xs text-milk-500 truncate max-w-[200px]"><%= c.note %></span><% } %>
          </td>
          <td data-label="Liên hệ" class="px-4 py-3">
            <% if (c.phone) { %><span class="block font-mono text-[13px]"><%= c.phone %></span><% } %>
            <% if (c.zalo_user_id) { %><%- badge('Zalo', 'info') %><% } %>
            <% if (!c.phone && !c.zalo_user_id) { %><span class="text-milk-400">—</span><% } %>
          </td>
          <td data-label="Đơn hàng" class="px-4 py-3 text-right font-mono text-milk-500 tnum"><%= c.order_count %></td>
          <td data-label="Số dư nợ" class="px-4 py-3 text-right font-mono font-semibold tnum <%= Number(c.balance) > 0 ? 'text-red-700' : 'text-navy-darker' %>">
            <%= money(c.balance) %>
          </td>
          <td data-label="Cập nhật" class="px-4 py-3 text-sm text-milk-500 tnum"><%= fmtTime(c.updated_at) %></td>
          <td data-label="" class="rt-actions px-4 py-3 text-right">
            <div class="inline-flex items-center gap-1">
              <a href="/admin/customers/<%= c.id %>/edit" class="<%= ui.btnGhost %>" title="Sửa khách hàng" aria-label="Sửa <%= c.name %>"><%- icon('pencil','h-4 w-4') %></a>
              <a href="/admin/customers/<%= c.id %>" class="inline-flex h-9 items-center rounded-lg border border-milk-200 px-3 text-xs font-semibold text-navy hover:border-navy-accent hover:bg-blue-50">Xem</a>
            </div>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</div>

<!-- Pagination -->
<% if (pages > 1) { %>
  <nav aria-label="Phân trang" class="mt-4 flex flex-wrap items-center justify-center gap-1.5">
    <% if (page > 1) { %><a href="<%= pageUrl(page - 1) %>" rel="prev" class="inline-flex h-10 items-center rounded-lg border border-milk-200 bg-white px-3 text-sm hover:border-navy-accent">← Trước</a><% } %>
    <% nums.forEach((n, i) => { %>
      <% if (i > 0 && n - nums[i - 1] > 1) { %><span class="px-1 text-milk-500">…</span><% } %>
      <a href="<%= pageUrl(n) %>" <%- n === page ? 'aria-current="page"' : '' %>
         class="inline-flex h-10 min-w-10 items-center justify-center rounded-lg border px-3 font-mono text-sm tnum <%= n === page ? 'border-navy bg-navy text-white' : 'border-milk-200 bg-white hover:border-navy-accent' %>"><%= n %></a>
    <% }) %>
    <% if (page < pages) { %><a href="<%= pageUrl(page + 1) %>" rel="next" class="inline-flex h-10 items-center rounded-lg border border-milk-200 bg-white px-3 text-sm hover:border-navy-accent">Sau →</a><% } %>
  </nav>
<% } %>
