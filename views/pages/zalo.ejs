<%
  const { btnSecondary, btnPrimary, input, label } = ui;
  const EVENT = { received: ['Đang xử lý', 'info'], processed: ['Đã xử lý', 'good'], ignored: ['Bỏ qua', 'neutral'], failed: ['Lỗi', 'bad'] };
  const isBot = conn.mode !== 'oa';
  const lastAgo = stats.lastEventAt ? Math.round((Date.now() - new Date(stats.lastEventAt).getTime()) / 60000) : null;
  const botState = !conn.configured ? ['Chưa cấu hình', 'neutral', conn.platform ? 'Thiếu khóa bí mật webhook: bấm "Lưu & đăng ký webhook" ở trên.' : 'Dán Bot Token ở ô "Zalo Bot Platform" phía trên (khuyến nghị), hoặc đặt BOT_WEBHOOK_SECRET cho Bot Client.']
    : lastAgo === null ? ['Chưa nhận tin', 'warn', 'Bot Client chưa gửi tin nhắn nào tới webhook.']
    : lastAgo > 60 * 24 ? ['Không hoạt động', 'warn', 'Hơn 24 giờ chưa nhận tin từ Bot Client: kiểm tra máy chạy bot.']
    : ['Đang hoạt động', 'good', null];
  const tokenState = isBot ? botState : !conn.configured ? ['Chưa cấu hình', 'neutral', 'Thiếu ZALO_APP_ID / ZALO_OA_SECRET_KEY / ZALO_APP_SECRET_KEY trong biến môi trường.']
    : conn.readError ? ['Không đọc được', 'warn', 'Không truy vấn được bảng token. Kiểm tra kết nối cơ sở dữ liệu.']
    : !conn.token ? ['Chưa cấp quyền', 'warn', conn.bootstrapPending ? 'Đã có ZALO_BOOTSTRAP_REFRESH_TOKEN, hệ thống sẽ đổi lấy token ở lần gửi tin đầu tiên.' : 'Cần đặt ZALO_BOOTSTRAP_REFRESH_TOKEN để cấp token lần đầu.']
    : ['Đã kết nối', 'good', null];
%>
<div class="flex flex-wrap items-start justify-between gap-4">
  <div>
    <h1 class="text-xl font-semibold tracking-tight sm:text-2xl"><%= conn.platform ? 'Zalo Bot (Zalo Bot Platform)' : isBot ? 'Zalo bot (tài khoản cá nhân)' : 'Zalo OA' %></h1>
    <p class="mt-1 max-w-2xl text-sm text-gray-500">Giám sát chatbot đặt món: kết nối, sự kiện webhook 24 giờ qua, đơn nháp đang chờ khách xác nhận và các bill gửi lỗi.</p>
  </div>
</div>

<% if (isBot && !conn.explicitMode) { %>
<section class="mt-5 rounded-xl border border-milk-200 bg-white p-5" aria-labelledby="zbp-title">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div class="max-w-2xl">
      <h2 id="zbp-title" class="text-base font-semibold">Zalo Bot Platform (khuyến nghị)</h2>
      <p class="mt-1 text-sm text-gray-600">Dán <b>Bot Token</b> lấy ở <a href="https://bot.zaloplatforms.com" target="_blank" rel="noopener" class="text-blue-700 underline">bot.zaloplatforms.com</a> (mục thông tin bot). Hệ thống kiểm tra token với Zalo, lưu lại, tự tạo khóa bí mật cho webhook và đăng ký webhook ngay. Token chỉ được lưu trên máy chủ, không hiển thị lại.</p>
    </div>
    <% if (conn.tokenSet) { %><%- badge(`Đã có token ${conn.tokenHint}${conn.tokenSource === 'env' ? ' (hPanel)' : ''}`, 'good') %><% } %>
  </div>
  <% if (conn.tokenSource === 'env') { %>
    <p class="mt-3 text-sm text-gray-600">Token đang đặt trong hPanel (<code>ZALO_BOT_TOKEN</code>); muốn đổi thì sửa ở đó.</p>
  <% } else { %>
  <form method="post" action="/admin/zalo/bot-token" class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-end" autocomplete="off">
    <%- include('../partials/csrf') %>
    <input type="hidden" name="_back" value="/admin/zalo">
    <div class="flex-1">
      <label for="bot-token" class="<%= label %>"><%= conn.tokenSet ? 'Thay Bot Token' : 'Bot Token' %></label>
      <input id="bot-token" name="botToken" type="password" required minlength="10" maxlength="200" spellcheck="false" autocapitalize="none"
        placeholder="<%= conn.tokenSet ? 'Đã lưu ' + conn.tokenHint + ' — dán token mới để thay' : 'Ví dụ: 1234567890:AbCdEf...' %>" class="<%= input %> font-mono">
    </div>
    <button type="submit" class="<%= btnPrimary %> sm:w-auto">Lưu &amp; đăng ký webhook</button>
  </form>
  <% } %>
</section>
<% } %>

<section class="mt-5 grid grid-cols-12 gap-4 sm:gap-6" aria-label="Kết nối">
  <div class="col-span-12 rounded border border-gray-200 p-5 lg:col-span-7">
    <div class="flex items-center justify-between gap-3">
      <h2 class="text-base font-semibold">Kết nối</h2>
      <%- badge(tokenState[0], tokenState[1]) %>
    </div>
    <% if (tokenState[2]) { %><p class="mt-2 text-sm text-gray-600"><%= tokenState[2] %></p><% } %>
    <dl class="mt-3 space-y-2 text-sm">
      <div class="flex justify-between gap-3"><dt class="text-gray-500">Webhook URL</dt><dd class="break-all text-right font-mono text-xs"><%= conn.webhookUrl %></dd></div>
      <% if (conn.platform && conn.configured) { %>
      <div class="pt-1">
        <form method="post" action="/admin/zalo/register-webhook" data-confirm="Đăng ký webhook này với Zalo Bot Platform? Zalo sẽ gửi tin nhắn của bot về địa chỉ trên.">
          <%- include('../partials/csrf') %>
          <input type="hidden" name="_back" value="/admin/zalo">
          <button type="submit" class="<%= btnSecondary %> w-full sm:w-auto">Đăng ký webhook với Zalo</button>
        </form>
      </div>
      <% } %>
      <% if (isBot) { %>
        <% if (conn.platform) { %>
        <div class="flex justify-between gap-3"><dt class="text-gray-500">Bot Token</dt><dd><%- conn.tokenSet ? badge('Đã đặt ' + conn.tokenHint, 'good') : badge('Chưa đặt', 'bad') %></dd></div>
        <div class="flex justify-between gap-3"><dt class="text-gray-500">Secret token webhook</dt><dd class="text-right">X-Bot-Api-Secret-Token <%- conn.configured ? badge('Đã đặt', 'good') : badge('Chưa đặt', 'bad') %></dd></div>
        <% } else { %>
        <div class="flex justify-between gap-3"><dt class="text-gray-500">Xác thực</dt><dd class="text-right">Authorization: Bearer BOT_WEBHOOK_SECRET <%- conn.configured ? badge('Đã đặt', 'good') : badge('Chưa đặt', 'bad') %></dd></div>
        <% } %>
        <div class="flex justify-between gap-3"><dt class="text-gray-500">Tin nhắn gần nhất</dt><dd><%= stats.lastEventAt ? fmtTime(stats.lastEventAt) : '—' %></dd></div>
      <% } else { %>
      <div class="flex justify-between gap-3"><dt class="text-gray-500">Xác thực chữ ký</dt><dd><%- conn.verifySignature ? badge('Bật', 'good') : badge('TẮT — chỉ dùng khi thử nghiệm', 'bad') %></dd></div>
      <% } %>
      <% if (conn.token) { %>
        <div class="flex justify-between gap-3"><dt class="text-gray-500">Access token hết hạn</dt><dd class="tnum"><%= fmtTime(conn.token.accessExpiresAt) %><span class="block text-right text-xs text-gray-500">Tự gia hạn khi cần</span></dd></div>
      <% } %>
      <div class="flex justify-between gap-3"><dt class="text-gray-500">Đơn nháp tự hết hạn sau</dt><dd><%= conn.draftTtlMinutes %> phút</dd></div>
    </dl>
  </div>

  <div class="col-span-12 rounded border border-gray-200 p-5 lg:col-span-5">
    <h2 class="text-base font-semibold">Webhook 24 giờ qua</h2>
    <dl class="mt-3 grid grid-cols-2 gap-3 text-sm">
      <div><dt class="text-gray-500">Đã xử lý</dt><dd class="font-mono text-xl font-semibold tnum"><%= stats.processed %></dd></div>
      <div><dt class="text-gray-500">Lỗi</dt><dd class="font-mono text-xl font-semibold tnum <%= stats.failed ? 'text-red-700' : '' %>"><%= stats.failed %></dd></div>
      <div><dt class="text-gray-500">Bỏ qua</dt><dd class="font-mono text-xl font-semibold tnum"><%= stats.ignored %></dd></div>
      <div><dt class="text-gray-500">Đang xử lý</dt><dd class="font-mono text-xl font-semibold tnum"><%= stats.received %></dd></div>
    </dl>
    <p class="mt-3 text-xs text-gray-500">Sự kiện gần nhất: <%= stats.lastEventAt ? fmtTime(stats.lastEventAt) + ' (' + ago(stats.lastEventAt) + ')' : 'chưa có' %></p>
  </div>
</section>

<section class="mt-5 rounded-xl border border-milk-200 bg-white p-5" aria-labelledby="debt-recipient-title">
  <div class="max-w-3xl">
    <h2 id="debt-recipient-title" class="text-base font-semibold">Thông báo công nợ cho chủ quán</h2>
    <p class="mt-1 text-sm text-gray-600">Khi nhân viên ghi tăng công nợ, hệ thống sẽ gửi thông báo Zalo cho khách đã liên kết Zalo và gửi bản báo cáo đến Chat ID của chủ quán.</p>
    <ol class="mt-3 list-decimal space-y-1 pl-5 text-sm text-gray-600">
      <li>Dùng tài khoản chủ quán nhắn riêng cho chatbot từ Zalo.</li>
      <li>Gửi đúng nội dung <code>id</code>; bot trả về Chat ID.</li>
      <li>Sao chép Chat ID đó vào ô bên dưới. Username hoặc đường dẫn hồ sơ Zalo không thay thế được Chat ID.</li>
    </ol>
    <% if (conn.mode === 'bot') { %>
      <p class="mt-3 rounded-lg bg-amber-50 p-3 text-sm text-amber-900">Chế độ Bot Client hiện tại chỉ trả lời trong phiên tin nhắn do khách vừa gửi; cần chuyển sang Zalo Bot Platform hoặc Zalo OA để gửi thông báo công nợ chủ động.</p>
    <% } %>
    <% if (conn.debtOwnerChatId) { %>
      <p class="mt-3 text-sm text-green-800">Đang nhận tại: <code><%= conn.debtOwnerChatId %></code> (<%= conn.debtOwnerChatType === 'group' ? 'nhóm' : 'chat cá nhân' %>).</p>
    <% } else { %>
      <p class="mt-3 text-sm text-amber-800">Chưa cấu hình Chat ID, chủ quán sẽ chưa nhận được thông báo Zalo.</p>
    <% } %>
  </div>
  <form method="post" action="/admin/zalo/debt-recipient" class="mt-4 grid gap-3 sm:grid-cols-[minmax(0,1fr)_12rem_auto] sm:items-end" autocomplete="off">
    <%- include('../partials/csrf') %>
    <input type="hidden" name="_back" value="/admin/zalo">
    <div>
      <label for="debt-chat-id" class="<%= label %>">Chat ID chủ quán</label>
      <input id="debt-chat-id" name="chatId" value="<%= conn.debtOwnerChatId %>" maxlength="100" spellcheck="false" autocapitalize="none" placeholder="Dán Chat ID bot trả về" class="<%= input %> font-mono">
    </div>
    <div>
      <label for="debt-chat-type" class="<%= label %>">Nơi nhận</label>
      <select id="debt-chat-type" name="chatType" class="<%= input %>">
        <option value="user" <%= conn.debtOwnerChatType !== 'group' ? 'selected' : '' %>>Chat cá nhân</option>
        <option value="group" <%= conn.debtOwnerChatType === 'group' ? 'selected' : '' %>>Nhóm Zalo</option>
      </select>
    </div>
    <button type="submit" class="<%= btnPrimary %>">Lưu nơi nhận</button>
  </form>
  <p class="mt-2 text-xs text-gray-500">Để xóa cấu hình, xóa Chat ID trong ô rồi bấm “Lưu nơi nhận”.</p>
</section>

<section class="mt-5 rounded border border-gray-200 max-lg:border-0" aria-labelledby="drafts-title">
  <h2 id="drafts-title" class="border-b border-gray-200 px-5 py-4 text-base font-semibold max-lg:border-b-0 max-lg:px-0">Đơn nháp chờ khách xác nhận (<%= drafts.length %>)</h2>
  <% if (!drafts.length) { %>
    <p class="px-5 py-8 text-center text-sm text-gray-500 max-lg:px-0">Không có đơn nháp nào đang chờ.</p>
  <% } else { %>
  <table class="rtable w-full border-collapse text-left text-sm lg:min-w-[560px]">
    <caption class="sr-only">Đơn nháp Zalo đang chờ</caption>
    <thead class="<%= ui.thead %>"><tr><th scope="col" class="px-4 py-3">Đơn</th><th scope="col" class="px-4 py-3">Chat</th><th scope="col" class="px-4 py-3 text-right">Tổng</th><th scope="col" class="px-4 py-3">Hoạt động cuối</th><th scope="col" class="px-4 py-3">Hết hạn</th></tr></thead>
    <tbody>
      <% drafts.forEach((d) => { %>
        <tr class="border-b border-gray-200 last:border-b-0">
          <td data-label="" class="rt-title px-4 py-3"><% if (d.order_id) { %><a href="/admin/orders/<%= d.order_id %>" class="font-mono text-[13px] font-medium text-blue-700 hover:text-navy hover:underline"><%= d.order_code %></a><% } else { %>—<% } %></td>
          <td data-label="Chat" class="px-4 py-3"><%= d.chat_type === 'group' ? 'Nhóm' : '1:1' %></td>
          <td data-label="Tổng" class="px-4 py-3 text-right font-mono tnum"><%= d.total == null ? '—' : money(d.total) %></td>
          <td data-label="Hoạt động cuối" class="px-4 py-3 tnum"><%= ago(d.last_activity_at) %></td>
          <td data-label="Hết hạn" class="px-4 py-3 tnum"><%= d.expires_at ? fmtTime(d.expires_at) : '—' %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</section>

<section class="mt-5 rounded border border-gray-200 max-lg:border-0" aria-labelledby="fail-title">
  <h2 id="fail-title" class="border-b border-gray-200 px-5 py-4 text-base font-semibold max-lg:border-b-0 max-lg:px-0">Bill gửi lỗi (<%= failed.length %>)</h2>
  <% if (!failed.length) { %>
    <p class="px-5 py-8 text-center text-sm text-gray-500 max-lg:px-0">Mọi bill Zalo đều đã gửi được.</p>
  <% } else { %>
  <ul class="divide-y divide-gray-100">
    <% failed.forEach((f) => { %>
      <li class="flex flex-wrap items-center justify-between gap-3 px-5 py-3 max-lg:px-0">
        <span class="min-w-0">
          <a href="/admin/orders/<%= f.id %>" class="font-mono text-[13px] font-medium text-blue-700 hover:text-navy hover:underline"><%= f.order_code %></a>
          <span class="block break-words text-xs text-red-700"><%= f.receipt_error %></span>
        </span>
        <form method="post" action="/admin/zalo/orders/<%= f.id %>/resend-receipt">
          <%- include('../partials/csrf') %>
          <button type="submit" class="<%= btnSecondary %>">Gửi lại</button>
        </form>
      </li>
    <% }) %>
  </ul>
  <% } %>
</section>

<section class="mt-5 rounded border border-gray-200 max-lg:border-0" aria-labelledby="ev-title">
  <h2 id="ev-title" class="border-b border-gray-200 px-5 py-4 text-base font-semibold max-lg:border-b-0 max-lg:px-0">Sự kiện webhook gần đây</h2>
  <table class="rtable w-full border-collapse text-left text-sm lg:min-w-[640px]">
    <caption class="sr-only">Sự kiện webhook gần đây</caption>
    <thead class="<%= ui.thead %>"><tr><th scope="col" class="px-4 py-3">Nhận lúc</th><th scope="col" class="px-4 py-3">Sự kiện</th><th scope="col" class="px-4 py-3">Trạng thái</th><th scope="col" class="px-4 py-3 text-right">Gửi lại</th><th scope="col" class="px-4 py-3">Lỗi</th></tr></thead>
    <tbody>
      <% events.forEach((e) => { const [label, tone] = EVENT[e.status] || [e.status, 'neutral']; %>
        <tr class="border-b border-gray-200 last:border-b-0">
          <td data-label="" class="rt-title px-4 py-3 tnum"><%= fmtTime(e.received_at) %></td>
          <td data-label="Sự kiện" class="px-4 py-3 font-mono text-[13px]"><%= e.event_name %></td>
          <td data-label="Trạng thái" class="px-4 py-3"><%- badge(label, tone) %></td>
          <td data-label="Gửi lại" class="px-4 py-3 text-right font-mono tnum"><%= e.num_retry %></td>
          <td data-label="Lỗi" class="px-4 py-3 text-xs text-red-700"><%= e.error || '' %></td>
        </tr>
      <% }) %>
      <% if (!events.length) { %><tr><td colspan="5" data-label="" class="px-4 py-10 text-center text-gray-500">Chưa nhận sự kiện nào từ Zalo.</td></tr><% } %>
    </tbody>
  </table>
</section>
