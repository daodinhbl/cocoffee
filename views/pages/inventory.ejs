<%
  const { input, label, btnPrimary, btnSecondary, btnGhost, sheet, grabber } = ui;
  const shown = onlyLow ? items.filter((i) => i.is_active && i.is_low) : items;
  const active = items.filter((i) => i.is_active);
  const lowCount = active.filter((i) => i.is_low).length;
  const outCount = active.filter((i) => Number(i.quantity_on_hand) <= 0).length;
  const card = 'rounded-xl border border-milk-200 bg-white shadow-[0_1px_2px_rgba(15,23,42,.04)]';
  const swipe = 'min-w-[60%] shrink-0 snap-start sm:min-w-0';
%>
<div class="flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="text-2xl font-semibold tracking-tight text-navy-darker">Nguyên liệu</h1>
    <p class="mt-1 max-w-2xl text-sm text-milk-500">Tồn kho nguyên liệu và hàng bán lẻ. Kho tự trừ khi đơn hoàn tất; nhập hàng ở <a href="/admin/receiving" class="font-medium text-blue-700 underline hover:text-navy">Nhập kho</a> để giá vốn bình quân được cập nhật.</p>
  </div>
  <div class="flex gap-2">
    <a href="/admin/receiving" class="<%= btnSecondary %>"><%- icon('upload', 'h-4 w-4') %> Nhập kho</a>
    <button type="button" data-modal-open="#item-dialog" data-action="/admin/inventory" data-title="Thêm nguyên liệu" class="<%= btnPrimary %>"><%- icon('plus', 'h-4 w-4') %> Thêm nguyên liệu</button>
  </div>
</div>

<section aria-label="Tóm tắt" class="no-scrollbar -mx-4 mt-5 flex snap-x gap-3 overflow-x-auto px-4 pb-1 sm:mx-0 sm:grid sm:grid-cols-4 sm:gap-5 sm:overflow-visible sm:px-0">
  <div class="<%= card %> <%= swipe %> p-4">
    <div class="flex items-start justify-between gap-2">
      <p class="text-xs font-semibold uppercase tracking-wide text-milk-500">Mặt hàng đang dùng</p>
      <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-milk-100 text-navy" aria-hidden="true"><%- icon('box', 'h-5 w-5') %></span>
    </div>
    <p class="mt-1 font-mono text-2xl font-bold text-navy-darker tnum"><%= active.length %></p>
    <p class="mt-1 text-xs text-milk-500"><%= items.length - active.length %> ngừng dùng</p>
  </div>
  <a href="/admin/inventory?low=1" class="<%= card %> <%= swipe %> block p-4 transition hover:border-amber-300">
    <div class="flex items-start justify-between gap-2">
      <p class="text-xs font-semibold uppercase tracking-wide text-milk-500">Dưới mức tối thiểu</p>
      <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-amber-50 text-amber-700" aria-hidden="true"><%- icon('bell', 'h-5 w-5') %></span>
    </div>
    <p class="mt-1 font-mono text-2xl font-bold tnum <%= lowCount ? 'text-amber-700' : 'text-navy-darker' %>"><%= lowCount %></p>
    <p class="mt-1 text-xs text-milk-500"><%= lowCount ? 'Cần nhập thêm →' : 'Không có mục nào' %></p>
  </a>
  <div class="<%= card %> <%= swipe %> p-4">
    <div class="flex items-start justify-between gap-2">
      <p class="text-xs font-semibold uppercase tracking-wide text-milk-500">Hết hàng</p>
      <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-red-50 text-red-700" aria-hidden="true"><%- icon('x', 'h-5 w-5') %></span>
    </div>
    <p class="mt-1 font-mono text-2xl font-bold tnum <%= outCount ? 'text-red-700' : 'text-navy-darker' %>"><%= outCount %></p>
    <p class="mt-1 text-xs text-milk-500">Món dùng nguyên liệu này sẽ báo hết</p>
  </div>
  <div class="<%= card %> <%= swipe %> p-4">
    <div class="flex items-start justify-between gap-2">
      <p class="text-xs font-semibold uppercase tracking-wide text-milk-500">Giá trị tồn kho</p>
      <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-navy text-white" aria-hidden="true"><%- icon('chart', 'h-5 w-5') %></span>
    </div>
    <p class="mt-1 font-mono text-2xl font-bold text-navy-darker tnum"><%= money(stockValue) %></p>
    <p class="mt-1 text-xs text-milk-500">Theo giá vốn bình quân</p>
  </div>
</section>

<div class="mt-6 flex flex-wrap items-center justify-between gap-3">
  <div class="flex gap-2" role="group" aria-label="Lọc theo tồn kho">
    <a href="/admin/inventory" <%- !onlyLow ? 'aria-current="true"' : '' %> class="inline-flex h-10 items-center gap-2 rounded-full border px-4 text-sm font-medium transition <%= !onlyLow ? 'border-navy bg-navy text-white shadow-sm' : 'border-milk-200 bg-white hover:border-navy-accent' %>">Tất cả <span class="rounded-full px-2 py-0.5 font-mono text-xs tnum <%= !onlyLow ? 'bg-white/15' : 'bg-milk-100 text-milk-500' %>"><%= items.length %></span></a>
    <a href="/admin/inventory?low=1" <%- onlyLow ? 'aria-current="true"' : '' %> class="inline-flex h-10 items-center gap-2 rounded-full border px-4 text-sm font-medium transition <%= onlyLow ? 'border-navy bg-navy text-white shadow-sm' : 'border-milk-200 bg-white hover:border-navy-accent' %>">Sắp hết <span class="rounded-full px-2 py-0.5 font-mono text-xs tnum <%= onlyLow ? 'bg-white/15' : lowCount ? 'bg-amber-100 text-amber-800' : 'bg-milk-100 text-milk-500' %>"><%= lowCount %></span></a>
  </div>
  <div class="relative w-full sm:w-80">
    <label for="inv-filter" class="sr-only">Tìm nguyên liệu</label>
    <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-milk-500"><%- icon('search', 'h-4 w-4') %></span>
    <input id="inv-filter" type="search" data-filter-input autocomplete="off" placeholder="Tìm theo tên hoặc SKU…" class="<%= input %> pl-9">
  </div>
</div>

<div class="<%= card %> mt-3 overflow-hidden max-lg:border-0 max-lg:bg-transparent max-lg:shadow-none">
  <table class="rtable w-full border-collapse text-left text-sm lg:min-w-[900px]" data-filterable>
    <caption class="sr-only">Tồn kho</caption>
    <thead class="<%= ui.thead %>">
      <tr>
        <th scope="col" class="px-4 py-3">Mặt hàng</th>
        <th scope="col" class="px-4 py-3">Tồn kho</th>
        <th scope="col" class="px-4 py-3 text-right">Tối thiểu</th>
        <th scope="col" class="px-4 py-3 text-right">Giá vốn BQ</th>
        <th scope="col" class="px-4 py-3 text-right">Giá trị</th>
        <th scope="col" class="px-4 py-3">Tình trạng</th>
        <th scope="col" class="px-4 py-3 text-right"><span class="sr-only">Hành động</span></th>
      </tr>
    </thead>
    <tbody>
      <% shown.forEach((i) => {
           const fillEdit = { name: i.name, unit: i.unit, min_stock: i.min_stock, sku: i.sku, is_active: Boolean(i.is_active), image_url: i.image_url || '' };
           const fillAdj = { new_quantity: i.quantity_on_hand };
           const lv = stockLevel(i); %>
        <tr data-row class="border-b border-milk-200 last:border-b-0 hover:bg-milk-50 <%= i.is_active ? '' : 'text-milk-500' %>">
          <td data-label="" class="rt-title px-4 py-3">
            <div class="flex items-center gap-3">
              <% if (i.image_url) { %>
                <img src="<%= i.image_url %>" alt="" loading="lazy" width="40" height="40" class="h-10 w-10 shrink-0 rounded-lg object-cover ring-1 ring-milk-200">
              <% } else { %>
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-milk-100 text-sm font-bold text-navy" aria-hidden="true"><%= String(i.name).trim().charAt(0).toUpperCase() %></span>
              <% } %>
              <div class="min-w-0">
                <a href="/admin/inventory/<%= i.id %>" class="font-semibold text-blue-700 hover:text-navy hover:underline"><%= i.name %></a>
                <p class="mt-0.5 font-mono text-xs text-milk-500"><%= i.sku %> · <%= i.unit %></p>
              </div>
            </div>
          </td>
          <td data-label="Tồn kho" class="px-4 py-3">
            <div class="min-w-[140px] max-lg:min-w-0 max-lg:text-right">
              <span class="font-mono font-semibold text-navy-darker tnum"><%= num(i.quantity_on_hand) %></span> <span class="text-milk-500"><%= i.unit %></span>
              <div class="mt-1.5 h-1.5 w-full rounded-full bg-milk-100 max-lg:hidden" role="img" aria-label="Mức tồn so với tối thiểu"><div class="h-1.5 rounded-full <%= lv.cls %>" style="width: <%= lv.pct %>%"></div></div>
            </div>
          </td>
          <td data-label="Tối thiểu" class="px-4 py-3 text-right font-mono text-milk-500 tnum"><%= num(i.min_stock) %></td>
          <td data-label="Giá vốn BQ" class="px-4 py-3 text-right font-mono tnum"><%= money(i.avg_cost) %></td>
          <td data-label="Giá trị" class="px-4 py-3 text-right font-mono font-semibold tnum"><%= money(i.stock_value) %></td>
          <td data-label="Tình trạng" class="px-4 py-3"><%- badge(lv.text, lv.tone) %></td>
          <td data-label="" class="rt-actions px-4 py-3 text-right">
            <div class="inline-flex items-center gap-1">
              <a href="/admin/receiving?item=<%= i.id %>" class="inline-flex h-9 items-center gap-1 rounded-lg border border-milk-200 px-2.5 text-xs font-semibold text-navy hover:border-navy-accent hover:bg-blue-50" title="Nhập kho"><%- icon('upload', 'h-3.5 w-3.5') %> Nhập</a>
              <button type="button" class="inline-flex h-9 items-center rounded-lg border border-milk-200 px-2.5 text-xs font-semibold text-dark hover:border-navy-accent" title="Kiểm kê / hao hụt"
                data-modal-open="#adjust-dialog" data-action="/admin/inventory/<%= i.id %>/adjust" data-title="Kiểm kê — <%= i.name %>" data-fill="<%= safeJson(fillAdj) %>">Kiểm kê</button>
              <button type="button" class="<%= btnGhost %>" aria-label="Sửa <%= i.name %>" title="Sửa"
                data-modal-open="#item-dialog" data-action="/admin/inventory/<%= i.id %>" data-title="Sửa nguyên liệu" data-fill="<%= safeJson(fillEdit) %>">
                <%- icon('pencil', 'h-4 w-4') %><span class="btn-label">Sửa</span>
              </button>
            </div>
          </td>
        </tr>
      <% }) %>
      <tr data-empty <%- shown.length ? 'hidden' : '' %>>
        <td colspan="7" data-label="" class="px-4 py-12 text-center text-sm text-milk-500"><%= shown.length ? 'Không có mặt hàng phù hợp.' : (onlyLow ? 'Không có mặt hàng nào dưới mức tối thiểu.' : 'Chưa có nguyên liệu nào.') %></td>
      </tr>
    </tbody>
  </table>
</div>

<%- include('../partials/inventory_dialogs') %>
