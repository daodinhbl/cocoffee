<%
  const { input, label, btnPrimary, btnSecondary, btnGhost, sheet, grabber } = ui;
  const shown = onlyLow ? items.filter((i) => i.is_active && i.is_low) : items;
  const lowCount = items.filter((i) => i.is_active && i.is_low).length;
%>
<div class="flex flex-wrap items-start justify-between gap-4">
  <div>
    <h1 class="text-xl font-semibold tracking-tight sm:text-2xl">Nguyên liệu</h1>
    <p class="mt-1 max-w-2xl text-sm text-gray-500">Tồn kho nguyên liệu và hàng bán lẻ. Kho tự trừ khi đơn hoàn tất; nhập hàng ở <a href="/admin/receiving" class="font-medium underline">Nhập kho</a> để giá vốn bình quân được cập nhật.</p>
  </div>
  <button type="button" data-modal-open="#item-dialog" data-action="/admin/inventory" data-title="Thêm nguyên liệu" class="<%= btnPrimary %>">+ Thêm nguyên liệu</button>
</div>

<section aria-label="Tóm tắt" class="mt-5 grid grid-cols-12 gap-3 sm:gap-6">
  <div class="col-span-6 rounded border border-gray-200 p-3 sm:col-span-4 sm:p-4">
    <p class="text-[11px] font-semibold uppercase tracking-wide text-gray-500 sm:text-xs">Mặt hàng đang dùng</p>
    <p class="mt-2 font-mono text-xl font-semibold tnum"><%= items.filter((i) => i.is_active).length %></p>
  </div>
  <a href="/admin/inventory?low=1" class="col-span-6 rounded border border-gray-200 p-3 hover:bg-gray-50 sm:col-span-4 sm:p-4">
    <p class="text-[11px] font-semibold uppercase tracking-wide text-gray-500 sm:text-xs">Dưới mức tối thiểu</p>
    <p class="mt-2 font-mono text-xl font-semibold tnum <%= lowCount ? 'text-amber-700' : '' %>"><%= lowCount %></p>
  </a>
  <div class="col-span-12 rounded border border-gray-200 p-3 sm:col-span-4 sm:p-4">
    <p class="text-[11px] font-semibold uppercase tracking-wide text-gray-500 sm:text-xs">Giá trị tồn kho</p>
    <p class="mt-2 font-mono text-xl font-semibold tnum"><%= money(stockValue) %></p>
  </div>
</section>

<div class="mt-6 flex flex-wrap items-center justify-between gap-3">
  <div class="flex gap-2" role="group" aria-label="Lọc theo tồn kho">
    <a href="/admin/inventory" <%- !onlyLow ? 'aria-current="true"' : '' %> class="inline-flex h-9 items-center rounded border px-3 text-sm <%= !onlyLow ? 'border-amber-400 bg-amber-50 font-medium' : 'border-gray-300 hover:bg-gray-50' %>">Tất cả</a>
    <a href="/admin/inventory?low=1" <%- onlyLow ? 'aria-current="true"' : '' %> class="inline-flex h-9 items-center rounded border px-3 text-sm <%= onlyLow ? 'border-amber-400 bg-amber-50 font-medium' : 'border-gray-300 hover:bg-gray-50' %>">Sắp hết (<%= lowCount %>)</a>
  </div>
  <div class="relative w-full sm:w-80">
    <label for="inv-filter" class="sr-only">Tìm nguyên liệu</label>
    <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"><%- icon('search', 'h-4 w-4') %></span>
    <input id="inv-filter" type="search" data-filter-input autocomplete="off" placeholder="Tìm theo tên hoặc SKU…" class="<%= input %> pl-9">
  </div>
</div>

<div class="mt-3 rounded border border-gray-200 max-lg:border-0">
  <table class="rtable w-full border-collapse text-left text-sm lg:min-w-[860px]" data-filterable>
    <caption class="sr-only">Tồn kho</caption>
    <thead class="<%= ui.thead %>">
      <tr>
        <th scope="col" class="px-4 py-3">Mặt hàng</th>
        <th scope="col" class="px-4 py-3 text-right">Tồn kho</th>
        <th scope="col" class="px-4 py-3 text-right">Tối thiểu</th>
        <th scope="col" class="px-4 py-3 text-right">Giá vốn BQ</th>
        <th scope="col" class="px-4 py-3 text-right">Giá trị</th>
        <th scope="col" class="px-4 py-3">Tình trạng</th>
        <th scope="col" class="px-4 py-3 text-right"><span class="sr-only">Hành động</span></th>
      </tr>
    </thead>
    <tbody>
      <% shown.forEach((i) => {
           const fillEdit = { name: i.name, unit: i.unit, min_stock: i.min_stock, sku: i.sku, is_active: Boolean(i.is_active) };
           const fillAdj = { new_quantity: i.quantity_on_hand }; %>
        <tr data-row class="border-b border-gray-200 last:border-b-0 hover:bg-gray-50 <%= i.is_active ? '' : 'text-gray-400' %>">
          <td data-label="" class="rt-title px-4 py-3">
            <a href="/admin/inventory/<%= i.id %>" class="font-medium hover:underline"><%= i.name %></a>
            <p class="mt-0.5 font-mono text-xs text-gray-500"><%= i.sku %></p>
          </td>
          <td data-label="Tồn kho" class="px-4 py-3 text-right font-mono tnum"><%= num(i.quantity_on_hand) %> <span class="text-gray-500"><%= i.unit %></span></td>
          <td data-label="Tối thiểu" class="px-4 py-3 text-right font-mono tnum"><%= num(i.min_stock) %></td>
          <td data-label="Giá vốn BQ" class="px-4 py-3 text-right font-mono tnum"><%= money(i.avg_cost) %></td>
          <td data-label="Giá trị" class="px-4 py-3 text-right font-mono tnum"><%= money(i.stock_value) %></td>
          <td data-label="Tình trạng" class="px-4 py-3">
            <% if (!i.is_active) { %><%- badge('Ngừng dùng', 'neutral') %>
            <% } else if (i.quantity_on_hand <= 0) { %><%- badge('Hết hàng', 'bad') %>
            <% } else if (i.is_low) { %><%- badge('Sắp hết', 'warn') %>
            <% } else { %><%- badge('Đủ', 'good') %><% } %>
          </td>
          <td data-label="" class="rt-actions px-4 py-3 text-right">
            <div class="inline-flex items-center gap-1">
              <a href="/admin/receiving?item=<%= i.id %>" class="<%= btnGhost %> w-auto px-2 text-xs font-medium" title="Nhập kho">Nhập</a>
              <button type="button" class="<%= btnGhost %> w-auto px-2 text-xs font-medium" title="Kiểm kê / hao hụt"
                data-modal-open="#adjust-dialog" data-action="/admin/inventory/<%= i.id %>/adjust" data-title="Kiểm kê — <%= i.name %>" data-fill="<%= safeJson(fillAdj) %>">Kiểm kê</button>
              <button type="button" class="<%= btnGhost %>" aria-label="Sửa <%= i.name %>" title="Sửa"
                data-modal-open="#item-dialog" data-action="/admin/inventory/<%= i.id %>" data-title="Sửa nguyên liệu" data-fill="<%= safeJson(fillEdit) %>">
                <%- icon('pencil', 'h-4 w-4') %><span class="btn-label">Sửa</span>
              </button>
            </div>
          </td>
        </tr>
      <% }) %>
      <tr data-empty <%- shown.length ? 'hidden' : '' %>>
        <td colspan="7" data-label="" class="px-4 py-12 text-center text-sm text-gray-500"><%= shown.length ? 'Không có mặt hàng phù hợp.' : (onlyLow ? 'Không có mặt hàng nào dưới mức tối thiểu.' : 'Chưa có nguyên liệu nào.') %></td>
      </tr>
    </tbody>
  </table>
</div>

<!-- Dialog: create / edit item -->
<dialog id="item-dialog" aria-labelledby="item-title" class="max-w-lg max-sm:h-[94dvh] <%= sheet %>">
  <form method="post" action="/admin/inventory" class="flex max-h-[calc(100dvh-2rem)] flex-col max-sm:h-full max-sm:max-h-none">
    <%- include('../partials/csrf') %>
    <%- grabber %>
    <div class="flex items-center justify-between border-b border-gray-200 px-4 py-3 sm:px-6 sm:py-4">
      <h2 id="item-title" data-dialog-title class="text-lg font-semibold">Nguyên liệu</h2>
      <button type="button" data-modal-close aria-label="Đóng" class="<%= btnGhost %>"><%- icon('x', 'h-5 w-5') %></button>
    </div>
    <div class="space-y-4 overflow-y-auto px-4 py-4 sm:px-6 sm:py-5">
      <div>
        <label for="i-name" class="<%= label %>">Tên</label>
        <input id="i-name" name="name" required maxlength="150" class="<%= input %>" autocomplete="off">
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label for="i-sku" class="<%= label %>">Mã (SKU)</label>
          <input id="i-sku" name="sku" maxlength="40" class="<%= input %> font-mono read-only:bg-gray-50 read-only:text-gray-500" autocomplete="off" autocapitalize="characters" data-create-only>
        </div>
        <div>
          <label for="i-unit" class="<%= label %>">Đơn vị</label>
          <input id="i-unit" name="unit" required maxlength="20" class="<%= input %>" placeholder="g, ml, bao…" autocomplete="off">
        </div>
      </div>
      <div>
        <label for="i-min" class="<%= label %>">Tồn tối thiểu (cảnh báo khi bằng hoặc thấp hơn)</label>
        <input id="i-min" name="min_stock" type="number" min="0" step="any" value="0" inputmode="decimal" class="<%= input %> text-right font-mono">
      </div>
      <div class="grid grid-cols-2 gap-4" data-new-only>
        <div>
          <label for="i-qty" class="<%= label %>">Tồn đầu kỳ</label>
          <input id="i-qty" name="quantity_on_hand" type="number" min="0" step="any" value="0" inputmode="decimal" class="<%= input %> text-right font-mono">
        </div>
        <div>
          <label for="i-cost" class="<%= label %>">Giá vốn / đơn vị (đ)</label>
          <input id="i-cost" name="avg_cost" type="number" min="0" step="any" value="0" inputmode="decimal" class="<%= input %> text-right font-mono">
        </div>
        <p class="col-span-2 -mt-2 text-xs text-gray-500">Chỉ dùng khi thêm mới. Sau đó tồn kho thay đổi qua Nhập kho và Kiểm kê.</p>
      </div>
      <label class="flex items-center gap-2 text-sm">
        <input type="hidden" name="is_active" value="0">
        <input type="checkbox" name="is_active" value="1" checked class="h-4 w-4 rounded border-gray-300 accent-amber-400">
        Đang sử dụng
      </label>
    </div>
    <div class="flex items-center justify-end gap-3 border-t border-gray-200 px-4 py-3 max-sm:pb-[calc(0.75rem+env(safe-area-inset-bottom))] sm:px-6 sm:py-4">
      <button type="button" data-modal-close class="<%= btnSecondary %> max-sm:flex-1">Hủy</button>
      <button type="submit" class="<%= btnPrimary %> max-sm:flex-[2]">Lưu</button>
    </div>
  </form>
</dialog>

<!-- Dialog: stocktake / waste -->
<dialog id="adjust-dialog" aria-labelledby="adjust-title" class="max-w-md <%= sheet %>">
  <form method="post" action="#" class="flex flex-col">
    <%- include('../partials/csrf') %>
    <%- grabber %>
    <div class="flex items-center justify-between border-b border-gray-200 px-4 py-3 sm:px-6 sm:py-4">
      <h2 id="adjust-title" data-dialog-title class="text-lg font-semibold">Kiểm kê</h2>
      <button type="button" data-modal-close aria-label="Đóng" class="<%= btnGhost %>"><%- icon('x', 'h-5 w-5') %></button>
    </div>
    <div class="space-y-4 px-4 py-4 sm:px-6 sm:py-5">
      <div>
        <label for="a-type" class="<%= label %>">Loại điều chỉnh</label>
        <select id="a-type" name="type" class="<%= input %>">
          <option value="adjustment">Kiểm kê (đặt lại số thực tế)</option>
          <option value="waste">Hao hụt / hỏng (đặt lại số còn lại)</option>
        </select>
      </div>
      <div>
        <label for="a-qty" class="<%= label %>">Số lượng thực tế còn lại</label>
        <input id="a-qty" name="new_quantity" type="number" min="0" step="any" required inputmode="decimal" class="<%= input %> text-right font-mono">
      </div>
      <div>
        <label for="a-note" class="<%= label %>">Ghi chú</label>
        <input id="a-note" name="note" maxlength="255" class="<%= input %>" placeholder="VD: kiểm kê cuối tháng" autocomplete="off">
      </div>
    </div>
    <div class="flex items-center justify-end gap-3 border-t border-gray-200 px-4 py-3 max-sm:pb-[calc(0.75rem+env(safe-area-inset-bottom))] sm:px-6 sm:py-4">
      <button type="button" data-modal-close class="<%= btnSecondary %> max-sm:flex-1">Hủy</button>
      <button type="submit" class="<%= btnPrimary %> max-sm:flex-[2]">Ghi nhận</button>
    </div>
  </form>
</dialog>
