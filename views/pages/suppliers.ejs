<%
  const { input, label, btnPrimary, btnSecondary, btnGhost, sheet, grabber } = ui;
  const card = 'rounded-xl border border-milk-200 bg-white shadow-[0_1px_2px_rgba(15,23,42,.04)]';
  const offset = (page - 1) * pageSize;
%>
<div class="flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="text-xl font-semibold tracking-tight text-navy-darker sm:text-2xl">Nhà cung cấp</h1>
    <p class="mt-1 max-w-2xl text-sm text-gray-500">Danh sách nơi nhập hàng, tổng tiền hàng đã nhập và công nợ phải trả. Chọn nhà cung cấp khi lập phiếu ở <a href="/admin/receiving" class="font-medium text-blue-700 underline">Nhập kho</a>; trả nợ ở trang chi tiết.</p>
  </div>
  <button type="button" data-modal-open="#supplier-dialog" data-action="/admin/suppliers" data-title="Thêm nhà cung cấp" class="<%= btnPrimary %>"><%- icon('plus', 'h-4 w-4') %> Thêm nhà cung cấp</button>
</div>

<section aria-label="Tóm tắt" class="mt-5 grid grid-cols-2 gap-3 lg:grid-cols-4">
  <div class="<%= card %> px-4 py-3">
    <p class="text-xs font-medium uppercase tracking-wide text-gray-500">Nhà cung cấp</p>
    <p class="mt-1 text-2xl font-semibold tnum text-navy-darker"><%= totals.suppliers %></p>
    <p class="text-xs text-milk-500"><%= totals.inDebt %> đang còn nợ</p>
  </div>
  <div class="<%= card %> px-4 py-3">
    <p class="text-xs font-medium uppercase tracking-wide text-gray-500">Tổng tiền hàng đã nhập</p>
    <p class="mt-1 text-2xl font-semibold tnum text-navy-darker"><%= money(totals.purchased) %></p>
    <p class="text-xs text-milk-500">Cộng các phiếu nhập có nhà cung cấp</p>
  </div>
  <div class="<%= card %> px-4 py-3">
    <p class="text-xs font-medium uppercase tracking-wide text-gray-500">Đã thanh toán</p>
    <p class="mt-1 text-2xl font-semibold tnum text-emerald-700"><%= money(totals.paid) %></p>
    <p class="text-xs text-milk-500">Trả ngay + trả nợ sau</p>
  </div>
  <a href="<%= tabUrl(true) %>" class="<%= card %> block px-4 py-3 transition hover:border-red-300">
    <p class="text-xs font-medium uppercase tracking-wide text-gray-500">Công nợ phải trả</p>
    <p class="mt-1 text-2xl font-semibold tnum <%= totals.debt > 0 ? 'text-red-700' : 'text-navy-darker' %>"><%= money(totals.debt) %></p>
    <p class="text-xs text-milk-500"><%= totals.debt > 0 ? 'Xem các nhà cung cấp còn nợ →' : 'Không còn nợ' %></p>
  </a>
</section>

<section class="mt-6" aria-label="Bộ lọc">
  <div class="<%= card %> p-3 sm:p-4">
    <div class="flex flex-col gap-3 lg:flex-row lg:items-center">
      <form method="get" action="/admin/suppliers" role="search" class="relative lg:w-80">
        <% if (onlyDebt) { %><input type="hidden" name="debt" value="1"><% } %>
        <label for="sup-q" class="sr-only">Tìm nhà cung cấp</label>
        <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"><%- icon('search', 'h-4 w-4') %></span>
        <input id="sup-q" name="q" type="search" value="<%= q %>" autocomplete="off" placeholder="Tìm theo tên hoặc điện thoại… (Enter)" class="<%= input %> pl-9">
      </form>
      <div role="group" aria-label="Công nợ" class="inline-flex w-full rounded-lg bg-milk-50 p-1 lg:w-auto">
        <a href="<%= tabUrl(false) %>" <%- !onlyDebt ? 'aria-current="true"' : '' %> class="inline-flex h-9 flex-1 items-center justify-center rounded-md px-3 text-sm font-medium transition lg:flex-none <%= !onlyDebt ? 'bg-white text-navy-darker shadow' : 'text-gray-600 hover:text-dark' %>">Tất cả</a>
        <a href="<%= tabUrl(true) %>" <%- onlyDebt ? 'aria-current="true"' : '' %> class="inline-flex h-9 flex-1 items-center justify-center gap-2 rounded-md px-3 text-sm font-medium transition lg:flex-none <%= onlyDebt ? 'bg-white text-navy-darker shadow' : 'text-gray-600 hover:text-dark' %>">Còn nợ <span class="tnum text-xs <%= totals.inDebt ? 'rounded-full bg-red-100 px-1.5 text-red-700' : 'opacity-70' %>"><%= totals.inDebt %></span></a>
      </div>
      <p class="text-sm text-gray-500 lg:ml-auto"><span class="font-semibold tnum text-dark"><%= total %></span> nhà cung cấp<%= q ? ` khớp “${q}”` : '' %></p>
    </div>
  </div>
</section>

<div class="<%= card %> mt-3 overflow-hidden">
  <table class="rtable w-full border-collapse text-left text-sm lg:min-w-[820px]">
    <caption class="sr-only">Nhà cung cấp</caption>
    <thead class="<%= ui.thead %>">
      <tr>
        <th scope="col" class="w-12 px-2 py-3 text-center sm:px-4">STT</th>
        <th scope="col" class="px-4 py-3">Nhà cung cấp</th>
        <th scope="col" class="px-4 py-3 text-right">Số phiếu</th>
        <th scope="col" class="px-4 py-3 text-right">Tổng nhập</th>
        <th scope="col" class="px-4 py-3 text-right">Đã trả</th>
        <th scope="col" class="px-4 py-3 text-right">Còn nợ</th>
        <th scope="col" class="px-4 py-3">Lần nhập cuối</th>
        <th scope="col" class="px-4 py-3 text-right"><span class="sr-only">Hành động</span></th>
      </tr>
    </thead>
    <tbody>
      <% rows.forEach((s, idx) => {
           const stt = offset + idx + 1;
           const fill = { name: s.name, phone: s.phone || '', address: s.address || '', tax_code: s.tax_code || '', note: s.note || '', is_active: Boolean(s.is_active) };
      %>
        <tr data-row class="border-b border-milk-200 last:border-b-0 <%= stt % 2 === 1 ? 'bg-blue-50/70 hover:bg-blue-100/70' : 'hover:bg-milk-50' %> <%= s.is_active ? '' : 'text-milk-500' %>">
          <td data-label="" class="rt-no px-2 py-3 text-center font-mono text-xs text-milk-500 tnum sm:px-4"><%= stt %></td>
          <td data-label="" class="rt-title px-4 py-3">
            <a href="/admin/suppliers/<%= s.id %>" class="font-semibold text-blue-700 hover:text-navy hover:underline"><%= s.name %></a>
            <% if (!s.is_active) { %><%- badge('Ngừng', 'neutral') %><% } %>
            <p class="mt-0.5 text-xs text-milk-500"><%= [s.phone, s.address].filter(Boolean).join(' · ') || '—' %></p>
          </td>
          <td data-label="Số phiếu" class="px-4 py-3 text-right font-mono tnum"><%= s.receipts %></td>
          <td data-label="Tổng nhập" class="px-4 py-3 text-right font-mono tnum"><%= money(s.purchased) %></td>
          <td data-label="Đã trả" class="px-4 py-3 text-right font-mono tnum text-emerald-700"><%= money(s.paid) %></td>
          <td data-label="Còn nợ" class="px-4 py-3 text-right font-mono font-semibold tnum <%= Number(s.debt) > 0 ? 'text-red-700' : 'text-gray-400' %>"><%= Number(s.debt) > 0 ? money(s.debt) : '—' %></td>
          <td data-label="Lần nhập cuối" class="px-4 py-3 tnum text-gray-600"><%= s.last_at ? fmtTime(s.last_at) : '—' %></td>
          <td data-label="" class="rt-actions px-4 py-3 text-right">
            <div class="inline-flex items-center gap-1">
              <a href="/admin/receiving?supplier=<%= s.id %>" class="inline-flex h-9 items-center rounded-lg border border-milk-200 px-2.5 text-xs font-semibold text-navy hover:border-navy-accent hover:bg-blue-50">Nhập hàng</a>
              <a href="/admin/suppliers/<%= s.id %>" class="inline-flex h-9 items-center rounded-lg border border-milk-200 px-2.5 text-xs font-semibold text-dark hover:border-navy-accent">Chi tiết</a>
              <button type="button" class="<%= btnGhost %>" aria-label="Sửa <%= s.name %>" title="Sửa" data-modal-open="#supplier-dialog" data-action="/admin/suppliers/<%= s.id %>" data-title="Sửa nhà cung cấp" data-fill="<%= safeJson(fill) %>"><%- icon('pencil', 'h-4 w-4') %></button>
            </div>
          </td>
        </tr>
      <% }) %>
      <% if (!rows.length) { %>
        <tr data-empty><td colspan="8" data-label="" class="px-4 py-12 text-center text-sm text-gray-500"><%= q || onlyDebt ? 'Không có nhà cung cấp phù hợp.' : 'Chưa có nhà cung cấp nào. Bấm “Thêm nhà cung cấp” hoặc nhập tên khi lập phiếu nhập kho.' %></td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<%- include('../partials/pager', { page, pages, total, pageSize, pageUrl, unit: 'nhà cung cấp' }) %>

<%- include('../partials/supplier_dialog') %>
