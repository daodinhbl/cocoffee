<%
  const { input, label, btnPrimary, btnSecondary, btnDanger, sheet, grabber, btnGhost } = ui;
  const canCancel  = ['draft', 'open'].includes(order.status);
  const canPay     = order.status === 'open' || (order.status === 'completed' && order.payment_status === 'unpaid');
  const canResend  = order.source === 'zalo' && order.status === 'completed';
  const profit     = order.total - order.cogs_total;
  const margin     = order.total > 0 ? (profit / order.total) * 100 : 0;
  const isPaid     = order.payment_status === 'paid';
  const isComplete = order.status === 'completed';
  const isDraft    = order.status === 'draft';

  // Status colour for the hero strip
  const heroColor = {
    draft:     'bg-amber-50  border-amber-200  text-amber-800',
    open:      'bg-sky-50    border-sky-200    text-sky-800',
    completed: isPaid ? 'bg-green-50 border-green-200 text-green-800'
                      : 'bg-amber-50 border-amber-200 text-amber-800',
    cancelled: 'bg-gray-50   border-gray-200   text-gray-600',
  }[order.status] || 'bg-gray-50 border-gray-200 text-gray-600';

  const heroIcon = {
    draft:     'bell',
    open:      'cup',
    completed: isPaid ? 'check' : 'receipt',
    cancelled: 'x',
  }[order.status] || 'receipt';
%>

<!-- ── Header ────────────────────────────────────────────────────────────────── -->
<div class="flex flex-wrap items-start justify-between gap-3">
  <div class="flex flex-wrap items-center gap-2.5">
    <h1 class="font-mono text-xl font-bold tracking-tight text-navy-darker sm:text-2xl"><%= order.order_code %></h1>
    <%- orderStatusBadge(order) %>
    <%- sourceBadge(order.source) %>
  </div>
  <div class="flex flex-wrap gap-2">
    <% if (['open', 'completed'].includes(order.status)) { %>
    <a href="/admin/pos/receipt/<%= order.id %>" target="_blank" rel="noopener"
       class="<%= btnSecondary %>" title="Mở hóa đơn in">
      <%- icon('receipt', 'h-4 w-4') %> In hóa đơn
    </a>
    <% } %>
    <a href="/admin/orders" class="<%= btnSecondary %>">← Danh sách đơn</a>
  </div>
</div>

<!-- ── Meta strip ──────────────────────────────────────────────────────────── -->
<p class="mt-1.5 text-sm text-milk-500">
  Tạo lúc <span class="tnum"><%= fmtTime(order.created_at) %></span>
  <% if (order.table_name) { %> · <span class="font-medium text-dark"><%= order.table_name %></span><% } %>
  <% if (order.customer_name) { %> · <a href="/admin/customers/<%= order.customer_id %>" class="font-medium text-blue-700 hover:underline"><%= order.customer_name %></a><% } %>
  <% if (order.completed_at) { %> · hoàn tất <span class="tnum"><%= fmtTime(order.completed_at) %></span><% } %>
</p>

<!-- ── Hero summary bar ───────────────────────────────────────────────────── -->
<div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
  <%
    const kpi = [
      { label: 'Tổng cộng',   value: money(order.total),    accent: true },
      { label: 'Tạm tính',    value: money(order.subtotal),  accent: false },
      { label: 'Giảm giá',    value: order.discount > 0 ? '−' + money(order.discount) : '—', accent: false },
      isComplete
        ? { label: 'Lãi gộp', value: money(profit), sub: pct(margin), tone: marginTone(margin), accent: false }
        : { label: 'Thanh toán', value: isPaid ? (METHOD_LABEL[order.payment_method] || '—') : 'Chưa thu', accent: false },
    ];
  %>
  <% kpi.forEach((k) => { %>
  <div class="rounded-xl border border-milk-200 bg-white p-3.5 shadow-[0_1px_2px_rgba(15,23,42,.04)] sm:p-4">
    <p class="text-[11px] font-semibold uppercase tracking-wide text-milk-500"><%= k.label %></p>
    <p class="mt-1 font-mono text-lg font-bold tnum <%= k.accent ? 'text-navy-darker' : (k.tone === 'good' ? 'text-green-700' : k.tone === 'warn' ? 'text-amber-700' : k.tone === 'bad' ? 'text-red-700' : 'text-dark') %>">
      <%= k.value %>
    </p>
    <% if (k.sub) { %><p class="mt-0.5 text-xs text-milk-500 tnum"><%= k.sub %></p><% } %>
  </div>
  <% }) %>
</div>

<!-- ── Two-column layout ──────────────────────────────────────────────────── -->
<div class="mt-5 grid grid-cols-12 gap-4 sm:gap-6">

  <!-- LEFT: items + totals -->
  <section class="col-span-12 overflow-hidden rounded-xl border border-milk-200 bg-white shadow-[0_1px_2px_rgba(15,23,42,.04)] lg:col-span-8"
           aria-labelledby="items-title">
    <h2 id="items-title" class="border-b border-milk-200 px-5 py-3.5 text-sm font-semibold uppercase tracking-wide text-milk-500">
      Món đã gọi <span class="ml-1.5 font-mono text-milk-400">(<%= order.items.length %>)</span>
    </h2>

    <table class="rtable w-full border-collapse text-left text-sm">
      <caption class="sr-only">Các món trong đơn</caption>
      <thead class="<%= ui.thead %>">
        <tr>
          <th scope="col" class="px-5 py-3">Món</th>
          <th scope="col" class="px-3 py-3 text-right">SL</th>
          <th scope="col" class="px-3 py-3 text-right">Đơn giá</th>
          <th scope="col" class="px-5 py-3 text-right">Thành tiền</th>
        </tr>
      </thead>
      <tbody>
        <% order.items.forEach((i) => { %>
          <tr class="border-b border-milk-200 last:border-b-0 hover:bg-milk-50 transition-colors">
            <td data-label="" class="rt-title px-5 py-3">
              <span class="font-medium"><%= i.product_name %></span>
              <% if (i.note) { %><span class="mt-0.5 block text-xs text-milk-500">📝 <%= i.note %></span><% } %>
            </td>
            <td data-label="SL" class="px-3 py-3 text-right font-mono tnum text-dark"><%= i.quantity %></td>
            <td data-label="Đơn giá" class="px-3 py-3 text-right font-mono tnum text-milk-500"><%= money(i.unit_price) %></td>
            <td data-label="Thành tiền" class="px-5 py-3 text-right font-mono font-semibold tnum text-navy-darker"><%= money(i.line_total) %></td>
          </tr>
        <% }) %>
        <% if (!order.items.length) { %>
          <tr>
            <td colspan="4" data-label="" class="px-5 py-10 text-center text-milk-500">
              <%- icon('cup', 'h-8 w-8 mx-auto mb-2 text-milk-300') %>
              <p>Đơn chưa có món.</p>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>

    <!-- Totals footer -->
    <div class="border-t border-milk-200 px-5 py-4">
      <dl class="space-y-1.5 text-sm">
        <div class="flex justify-between text-milk-500">
          <dt>Tạm tính</dt>
          <dd class="font-mono tnum"><%= money(order.subtotal) %></dd>
        </div>
        <% if (order.discount > 0) { %>
        <div class="flex justify-between text-amber-700">
          <dt>Giảm giá</dt>
          <dd class="font-mono tnum">−<%= money(order.discount) %></dd>
        </div>
        <% } %>
        <div class="flex justify-between border-t border-dashed border-milk-200 pt-2 text-base font-bold text-navy-darker">
          <dt>Tổng cộng</dt>
          <dd class="font-mono tnum"><%= money(order.total) %></dd>
        </div>
        <% if (isComplete) { %>
          <div class="flex justify-between text-milk-500">
            <dt>Giá vốn (COGS)</dt>
            <dd class="font-mono tnum"><%= money(order.cogs_total) %></dd>
          </div>
          <div class="flex justify-between <%= margin >= 55 ? 'text-green-700' : 'text-red-700' %>">
            <dt>Lãi gộp</dt>
            <dd class="font-mono tnum">
              <%= money(profit) %>
              <% if (order.total > 0) { %><span class="ml-1 text-xs opacity-70">(<%= pct(margin) %>)</span><% } %>
            </dd>
          </div>
        <% } %>
      </dl>
    </div>
  </section>

  <!-- RIGHT: info + actions -->
  <div class="col-span-12 space-y-4 sm:space-y-5 lg:col-span-4">

    <!-- Info card -->
    <section class="overflow-hidden rounded-xl border border-milk-200 bg-white shadow-[0_1px_2px_rgba(15,23,42,.04)]"
             aria-labelledby="info-title">
      <h2 id="info-title" class="border-b border-milk-200 px-5 py-3.5 text-sm font-semibold uppercase tracking-wide text-milk-500">Thông tin</h2>
      <dl class="divide-y divide-milk-100 text-sm">
        <div class="flex items-center justify-between gap-3 px-5 py-3">
          <dt class="text-milk-500">Trạng thái</dt>
          <dd><%- orderStatusBadge(order) %></dd>
        </div>
        <div class="flex items-center justify-between gap-3 px-5 py-3">
          <dt class="text-milk-500">Kênh</dt>
          <dd><%- sourceBadge(order.source) %></dd>
        </div>
        <div class="flex items-center justify-between gap-3 px-5 py-3">
          <dt class="text-milk-500">Thanh toán</dt>
          <dd>
            <% if (isPaid) { %>
              <%- badge(METHOD_LABEL[order.payment_method] || order.payment_method, 'good') %>
            <% } else { %>
              <%- badge('Chưa thu', 'warn') %>
            <% } %>
          </dd>
        </div>
        <% if (order.paid_at) { %>
        <div class="flex items-center justify-between gap-3 px-5 py-3">
          <dt class="text-milk-500">Thu lúc</dt>
          <dd class="tnum text-right"><%= fmtTime(order.paid_at) %></dd>
        </div>
        <% } %>
        <% if (order.table_name) { %>
        <div class="flex items-center justify-between gap-3 px-5 py-3">
          <dt class="text-milk-500">Bàn</dt>
          <dd class="font-medium"><%= order.table_name %></dd>
        </div>
        <% } %>
        <% if (order.customer_name) { %>
        <div class="flex items-center justify-between gap-3 px-5 py-3">
          <dt class="text-milk-500">Khách hàng</dt>
          <dd><a href="/admin/customers/<%= order.customer_id %>" class="font-medium text-blue-700 hover:underline"><%= order.customer_name %></a></dd>
        </div>
        <% } %>
        <% if (order.note) { %>
        <div class="flex items-start justify-between gap-3 px-5 py-3">
          <dt class="shrink-0 text-milk-500">Ghi chú</dt>
          <dd class="text-right"><%= order.note %></dd>
        </div>
        <% } %>
        <% if (order.source === 'zalo') { %>
        <div class="flex items-center justify-between gap-3 px-5 py-3">
          <dt class="text-milk-500">Zalo</dt>
          <dd><%= order.zalo_chat_type === 'group' ? 'Nhóm chat' : 'Chat 1:1' %></dd>
        </div>
        <div class="flex items-center justify-between gap-3 px-5 py-3">
          <dt class="text-milk-500">Bill Zalo</dt>
          <dd>
            <%- order.receipt_sent_at
              ? badge('Đã gửi ' + fmtTime(order.receipt_sent_at), 'good')
              : (order.receipt_error ? badge('Gửi lỗi', 'bad') : badge('Chưa gửi', 'neutral')) %>
          </dd>
        </div>
        <% if (order.receipt_error) { %>
        <div class="px-5 pb-3">
          <p class="rounded border border-red-200 bg-red-50 px-2.5 py-2 text-xs text-red-800">
            <%- icon('x', 'h-3.5 w-3.5 inline-block mr-1 -mt-0.5') %><%= order.receipt_error %>
          </p>
        </div>
        <% } %>
        <% } %>
      </dl>

      <!-- Payment history -->
      <% if (payments.length) { %>
      <div class="border-t border-milk-200 px-5 py-4">
        <h3 class="text-xs font-semibold uppercase tracking-wide text-milk-500">Lịch sử thu tiền</h3>
        <ul class="mt-3 space-y-2">
          <% payments.forEach((p) => { %>
            <li class="flex items-center justify-between gap-3 text-sm">
              <span>
                <span class="font-medium"><%= METHOD_LABEL[p.method] || p.method %></span>
                <span class="block text-xs text-milk-500">
                  <span class="tnum"><%= fmtTime(p.paid_at) %></span>
                  <% if (p.received_by_name) { %> · <%= p.received_by_name %><% } %>
                  <% if (p.reference) { %> · <span class="font-mono"><%= p.reference %></span><% } %>
                </span>
              </span>
              <span class="font-mono font-semibold tnum text-navy-darker"><%= money(p.amount) %></span>
            </li>
          <% }) %>
        </ul>
      </div>
      <% } %>
    </section>

    <!-- Pay form -->
    <% if (canPay) { %>
    <section class="overflow-hidden rounded-xl border border-amber-200 bg-amber-50 shadow-[0_1px_2px_rgba(15,23,42,.04)]"
             aria-labelledby="pay-title">
      <h2 id="pay-title" class="border-b border-amber-200 px-5 py-3.5 text-sm font-semibold uppercase tracking-wide text-amber-700">
        <%- icon('receipt', 'h-4 w-4 inline-block mr-1.5 -mt-0.5') %>Thu tiền
      </h2>
      <div class="px-5 py-4">
        <p class="mb-4 text-xs text-amber-800">
          <%= order.status === 'open'
            ? 'Thu tiền sẽ hoàn tất đơn: trừ kho theo định mức và chốt giá vốn.'
            : 'Đơn Zalo đã trừ kho; chỉ ghi nhận tiền đã thu.' %>
        </p>
        <form method="post" action="/admin/orders/<%= order.id %>/pay" class="space-y-3"
          data-confirm="<%= order.status === 'open'
            ? `Thu tiền và hoàn tất đơn ${order.order_code}? Số tiền = tạm tính − giảm giá đã nhập.`
            : `Ghi nhận thu ${money(order.total)} cho đơn ${order.order_code}?` %>">
          <%- include('../partials/csrf') %>
          <div>
            <label for="pay-method" class="<%= label %>">Hình thức thanh toán</label>
            <select id="pay-method" name="method" class="<%= input %>">
              <option value="cash">Tiền mặt</option>
              <option value="transfer">Chuyển khoản</option>
              <option value="card">Thẻ</option>
              <option value="other">Khác</option>
            </select>
          </div>
          <% if (order.status === 'open') { %>
          <div>
            <label for="pay-discount" class="<%= label %>">Giảm giá (đ)</label>
            <input id="pay-discount" name="discount" type="number"
                   min="0" max="<%= order.subtotal %>" step="500" inputmode="numeric"
                   value="<%= order.discount %>"
                   class="<%= input %> text-right font-mono">
          </div>
          <% } %>
          <div>
            <label for="pay-ref" class="<%= label %>">Mã tham chiếu <span class="font-normal text-milk-400">(tùy chọn)</span></label>
            <input id="pay-ref" name="reference" maxlength="100" class="<%= input %>" autocomplete="off">
          </div>
          <button type="submit" class="inline-flex h-10 w-full items-center justify-center gap-2 rounded bg-amber-400 px-4 text-sm font-bold text-ink-900 hover:bg-amber-500 active:bg-amber-600">
            <%- icon('check', 'h-4 w-4') %>
            <%= order.status === 'open' ? 'Thu tiền & hoàn tất đơn' : `Thu ${money(order.total)}` %>
          </button>
        </form>
      </div>
    </section>
    <% } %>

    <!-- Other actions -->
    <% if (canResend || canCancel || canRecordDebt) { %>
    <section class="overflow-hidden rounded-xl border border-milk-200 bg-white shadow-[0_1px_2px_rgba(15,23,42,.04)]"
             aria-labelledby="act-title">
      <h2 id="act-title" class="border-b border-milk-200 px-5 py-3.5 text-sm font-semibold uppercase tracking-wide text-milk-500">Thao tác khác</h2>
      <div class="space-y-3 px-5 py-4">
        <% if (canRecordDebt) { %>
          <button type="button" data-modal-open="#debt-dialog" class="<%= btnPrimary %> w-full">
            <%- icon('receipt', 'h-4 w-4') %> Ghi công nợ cho khách
          </button>
          <p class="text-xs text-milk-500">Đơn Zalo này chưa nằm trong sổ nợ của khách nào. Ghi nợ sẽ gắn đơn vào khách, tăng số dư nợ và báo khách qua Zalo.</p>
        <% } %>
        <% if (canResend) { %>
          <form method="post" action="/admin/orders/<%= order.id %>/resend-receipt">
            <%- include('../partials/csrf') %>
            <button type="submit" class="<%= btnSecondary %> w-full">
              <%- icon('chat', 'h-4 w-4') %> Gửi lại bill qua Zalo
            </button>
          </form>
        <% } %>
        <% if (canCancel) { %>
          <form method="post" action="/admin/orders/<%= order.id %>/cancel"
                data-confirm="Hủy đơn <%= order.order_code %>? Đơn chưa trừ kho nên không ảnh hưởng tồn kho.">
            <%- include('../partials/csrf') %>
            <button type="submit" class="<%= btnDanger %> w-full">
              <%- icon('x', 'h-4 w-4') %> Hủy đơn
            </button>
          </form>
        <% } %>
      </div>
    </section>
    <% } %>

  </div><!-- /right col -->
</div><!-- /grid -->

<% if (canRecordDebt) { %>
<!-- Ghi công nợ: an existing customer, or a new one that takes this order's Zalo account -->
<dialog id="debt-dialog" aria-labelledby="debt-title" class="max-w-md <%= sheet %>">
  <form method="post" action="/admin/orders/<%= order.id %>/record-debt" class="flex flex-col">
    <%- include('../partials/csrf') %>
    <%- grabber %>
    <div class="flex items-center justify-between border-b border-gray-200 px-4 py-3 sm:px-6 sm:py-4">
      <h2 id="debt-title" class="text-lg font-semibold">Ghi công nợ · <%= order.order_code %></h2>
      <button type="button" data-modal-close aria-label="Đóng" class="<%= btnGhost %>"><%- icon('x', 'h-5 w-5') %></button>
    </div>
    <div class="space-y-4 px-4 py-4 sm:px-6 sm:py-5">
      <p class="rounded border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-900">Số tiền ghi nợ: <b class="font-mono"><%= money(order.total) %></b>. Đơn vẫn "chờ thu tiền" cho tới khi bạn thu nợ.</p>
      <div>
        <label for="debt-customer" class="<%= label %>">Khách hàng có sẵn</label>
        <select id="debt-customer" name="customer_id" class="<%= input %>">
          <option value="">— Chọn khách —</option>
          <% debtCustomers.forEach((c) => { %>
            <option value="<%= c.id %>"><%= c.name %><%= c.phone ? ' · ' + c.phone : '' %><%= Number(c.balance) > 0 ? ' · nợ ' + money(c.balance) : '' %><%= c.zalo_user_id ? ' · đã có Zalo' : '' %></option>
          <% }) %>
        </select>
      </div>
      <p class="text-center text-xs uppercase tracking-wide text-milk-500">hoặc tạo khách mới</p>
      <div class="grid gap-3 sm:grid-cols-2">
        <div>
          <label for="debt-new-name" class="<%= label %>">Tên khách mới</label>
          <input id="debt-new-name" name="new_name" maxlength="120" class="<%= input %>" autocomplete="off" placeholder="VD: Chị Lan">
        </div>
        <div>
          <label for="debt-new-phone" class="<%= label %>">Số điện thoại</label>
          <input id="debt-new-phone" name="new_phone" maxlength="20" inputmode="tel" class="<%= input %> font-mono" autocomplete="off">
        </div>
      </div>
      <% if (order.zalo_user_id) { %>
        <label class="flex items-start gap-2 text-sm text-gray-700">
          <input type="hidden" name="link_zalo" value="0">
          <input type="checkbox" name="link_zalo" value="1" checked class="mt-1 h-4 w-4 rounded border-gray-300">
          <span>Liên kết tài khoản Zalo của đơn (<code class="font-mono text-xs"><%= order.zalo_user_id %></code>) với khách này, để đơn Zalo sau tự vào sổ nợ và khách nhận thông báo.</span>
        </label>
      <% } %>
    </div>
    <div class="flex items-center justify-end gap-3 border-t border-gray-200 px-4 py-3 max-sm:pb-[calc(0.75rem+env(safe-area-inset-bottom))] sm:px-6 sm:py-4">
      <button type="button" data-modal-close class="<%= btnSecondary %> max-sm:flex-1">Hủy</button>
      <button type="submit" class="<%= btnPrimary %> max-sm:flex-[2]">Ghi công nợ</button>
    </div>
  </form>
</dialog>
<% } %>
