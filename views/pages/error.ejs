<div class="mx-auto max-w-lg py-16 text-center">
  <p class="font-mono text-5xl font-semibold text-gray-300 tnum"><%= status %></p>
  <h1 class="mt-4 text-xl font-semibold"><%= status === 404 ? 'Không tìm thấy trang' : 'Có lỗi xảy ra' %></h1>
  <p class="mt-2 text-sm text-gray-600"><%= message %></p>
  <div class="mt-6 flex justify-center gap-3">
    <a href="/admin/dashboard" class="<%= ui.btnPrimary %>">Về tổng quan</a>
  </div>
</div>
