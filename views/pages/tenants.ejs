<%
  const { input, label, btnPrimary, btnSecondary } = ui;
  const card = 'rounded-xl border border-milk-200 bg-white shadow-[0_1px_2px_rgba(15,23,42,.04)]';
  const small = 'inline-flex h-9 items-center rounded-lg border border-milk-200 px-2.5 text-xs font-semibold text-dark hover:border-navy-accent';
%>
<div class="flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="text-xl font-semibold tracking-tight text-navy-darker sm:text-2xl">Đăng ký quán</h1>
    <p class="mt-1 max-w-2xl text-sm text-gray-500">Các quán đã đăng ký tại <a href="/dang-ky" class="font-medium text-blue-700 underline" target="_blank" rel="noopener">/dang-ky</a>. Mỗi quán là <b>tên-quán.<%= base %></b> với database riêng; quán chờ sẽ tự hoàn tất khi bạn thêm database trống.</p>
  </div>
  <%- badge(signupOpen ? 'Đang mở đăng ký' : 'Đã đóng đăng ký (TENANT_SIGNUP_OPEN)', signupOpen ? 'good' : 'neutral') %>
</div>

<section aria-label="Tóm tắt" class="mt-5 grid grid-cols-2 gap-3 lg:grid-cols-4">
  <div class="<%= card %> px-4 py-3"><p class="text-xs font-medium uppercase tracking-wide text-gray-500">Tổng số quán</p><p class="mt-1 text-2xl font-semibold tnum text-navy-darker"><%= counts.total %></p><p class="text-xs text-milk-500"><%= counts.active %> đang hoạt động</p></div>
  <div class="<%= card %> px-4 py-3"><p class="text-xs font-medium uppercase tracking-wide text-gray-500">Chờ cấp DB</p><p class="mt-1 text-2xl font-semibold tnum <%= counts.pending ? 'text-amber-700' : 'text-navy-darker' %>"><%= counts.pending %></p><p class="text-xs text-milk-500">Cần database trống</p></div>
  <div class="<%= card %> px-4 py-3"><p class="text-xs font-medium uppercase tracking-wide text-gray-500">Database trống</p><p class="mt-1 text-2xl font-semibold tnum <%= free ? 'text-emerald-700' : 'text-red-700' %>"><%= free %></p><p class="text-xs text-milk-500">Sẵn sàng cho quán mới</p></div>
  <div class="<%= card %> px-4 py-3"><p class="text-xs font-medium uppercase tracking-wide text-gray-500">Tạm ngưng</p><p class="mt-1 text-2xl font-semibold tnum text-navy-darker"><%= counts.suspended %></p></div>
</section>

<section class="<%= card %> mt-5 overflow-hidden" aria-label="Danh sách quán">
  <table class="rtable w-full border-collapse text-left text-sm lg:min-w-[860px]">
    <thead class="border-b border-milk-200 bg-milk-50 text-xs uppercase tracking-wide text-gray-500">
      <tr>
        <th scope="col" class="w-12 px-2 py-3 text-center sm:px-4">STT</th>
        <th scope="col" class="px-4 py-3">Quán</th>
        <th scope="col" class="px-4 py-3">Chủ quán</th>
        <th scope="col" class="px-4 py-3">Trạng thái</th>
        <th scope="col" class="px-4 py-3">Database</th>
        <th scope="col" class="px-4 py-3">Đăng ký lúc</th>
        <th scope="col" class="px-4 py-3 text-right"><span class="sr-only">Hành động</span></th>
      </tr>
    </thead>
    <tbody>
      <% shops.forEach((t, idx) => { const st = statusText[t.status] || [t.status, 'neutral']; %>
        <tr class="border-b border-milk-200 last:border-b-0 <%= (idx + 1) % 2 === 1 ? 'bg-blue-50/70' : '' %>">
          <td data-label="" class="rt-no px-2 py-3 text-center font-mono text-xs text-milk-500 tnum sm:px-4"><%= idx + 1 %></td>
          <td data-label="" class="rt-title px-4 py-3">
            <span class="font-semibold text-navy-darker"><%= t.name %></span>
            <p class="mt-0.5 text-xs text-milk-500"><% if (t.status === 'active') { %><a href="<%= urlOf(t.slug) %>/admin/login" target="_blank" rel="noopener" class="text-blue-700 hover:underline"><%= t.slug %>.<%= base %></a><% } else { %><%= t.slug %>.<%= base %><% } %></p>
          </td>
          <td data-label="Chủ quán" class="px-4 py-3"><%= t.owner_name %><p class="text-xs text-milk-500"><%= [t.owner_email, t.owner_phone].filter(Boolean).join(' · ') %></p><p class="text-xs text-milk-500">Tài khoản: <%= t.owner_username %></p></td>
          <td data-label="Trạng thái" class="px-4 py-3"><%- badge(st[0], st[1]) %><% if (t.error && t.status !== 'active') { %><p class="mt-1 max-w-[16rem] text-xs text-red-700"><%= t.error %></p><% } %></td>
          <td data-label="Database" class="px-4 py-3 font-mono text-xs"><%= t.db_name || '—' %></td>
          <td data-label="Đăng ký lúc" class="px-4 py-3 tnum text-gray-600"><%= fmtTime(t.created_at) %></td>
          <td data-label="" class="rt-actions px-4 py-3 text-right">
            <div class="inline-flex flex-wrap items-center justify-end gap-1">
              <% if (t.status !== 'active') { %>
                <form method="post" action="/admin/tenants/<%= t.id %>/provision"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="_back" value="/admin/tenants"><button class="<%= small %>"><%= t.db_id ? 'Thử lại' : 'Cấp DB' %></button></form>
              <% } %>
              <% if (t.status === 'suspended') { %>
                <form method="post" action="/admin/tenants/<%= t.id %>/status"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="_back" value="/admin/tenants"><input type="hidden" name="status" value="active"><button class="<%= small %>">Mở lại</button></form>
              <% } else if (t.status === 'active') { %>
                <form method="post" action="/admin/tenants/<%= t.id %>/status" data-confirm="Tạm ngưng quán <%= t.name %>? Mọi người dùng quán này sẽ không đăng nhập được."><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="_back" value="/admin/tenants"><input type="hidden" name="status" value="suspended"><button class="<%= small %> text-red-700">Tạm ngưng</button></form>
              <% } %>
            </div>
          </td>
        </tr>
      <% }) %>
      <% if (!shops.length) { %>
        <tr data-empty><td colspan="7" data-label="" class="px-4 py-12 text-center text-sm text-gray-500">Chưa có quán nào đăng ký.</td></tr>
      <% } %>
    </tbody>
  </table>
</section>

<section class="mt-6 grid gap-5 lg:grid-cols-2" aria-label="Database">
  <div class="<%= card %> p-5">
    <h2 class="text-base font-semibold text-navy-darker">Thêm database trống</h2>
    <p class="mt-1 text-xs text-gray-500">Tạo database trong hPanel &gt; Databases (kèm người dùng), rồi nhập vào đây. Database phải chưa có bảng nào. Mật khẩu được mã hóa khi lưu.</p>
    <form method="post" action="/admin/tenants/databases" autocomplete="off" class="mt-3 grid gap-3 sm:grid-cols-2">
      <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="_back" value="/admin/tenants">
      <div><label class="<%= label %>" for="db-host">Máy chủ</label><input id="db-host" name="host" required value="127.0.0.1" class="<%= input %>"></div>
      <div><label class="<%= label %>" for="db-port">Cổng</label><input id="db-port" name="port" type="number" value="3306" class="<%= input %>"></div>
      <div><label class="<%= label %>" for="db-name">Tên database</label><input id="db-name" name="name" required maxlength="64" class="<%= input %>"></div>
      <div><label class="<%= label %>" for="db-user">Người dùng</label><input id="db-user" name="user" required maxlength="64" class="<%= input %>"></div>
      <div class="sm:col-span-2"><label class="<%= label %>" for="db-pass">Mật khẩu</label><input id="db-pass" name="password" type="password" required autocomplete="new-password" class="<%= input %>"></div>
      <div class="sm:col-span-2"><label class="<%= label %>" for="db-note">Ghi chú (không bắt buộc)</label><input id="db-note" name="note" maxlength="120" class="<%= input %>"></div>
      <div class="sm:col-span-2"><button type="submit" class="<%= btnPrimary %>"><%- icon('plus', 'h-4 w-4') %> Thêm database</button></div>
    </form>
  </div>
  <div class="<%= card %> p-5">
    <h2 class="text-base font-semibold text-navy-darker">Database đã đăng ký</h2>
    <ul class="mt-3 divide-y divide-milk-200 text-sm">
      <% dbs.forEach((d) => { %>
        <li class="flex items-center justify-between gap-3 py-2"><span class="font-mono text-xs"><%= d.db_name %><span class="text-milk-500"> @ <%= d.db_host %></span></span><% if (d.tenant_id) { %><span class="text-xs text-gray-600">dùng bởi <b><%= d.slug %></b></span><% } else { %><%- badge('Trống', 'good') %><% } %></li>
      <% }) %>
      <% if (!dbs.length) { %><li class="py-6 text-center text-gray-500">Chưa có database nào. Thêm một database trống để quán mới đăng ký được cấp tự động.</li><% } %>
    </ul>
  </div>
</section>
