<%
  const kpiTone = { good: 'text-emerald-700', warn: 'text-amber-700', neutral: 'text-milk-500' };
  const kpiChip = { revenue: 'bg-navy text-white', cogs: 'bg-milk-100 text-navy', profit: 'bg-emerald-50 text-emerald-700', unpaid: 'bg-amber-50 text-amber-700' };
  const revenue = kpis[0];
  const others = kpis.slice(1);
  const nowHour = Number(new Intl.DateTimeFormat('en-GB', { hour: 'numeric', hour12: false, timeZone: 'Asia/Ho_Chi_Minh' }).format(new Date()));
  const dateText = new Intl.DateTimeFormat('vi-VN', { weekday: 'long', day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'Asia/Ho_Chi_Minh' }).format(new Date());
  const hello = nowHour < 11 ? 'Chào buổi sáng' : nowHour < 14 ? 'Chào buổi trưa' : nowHour < 18 ? 'Chào buổi chiều' : 'Chào buổi tối';
  const card = 'rounded-xl border border-milk-200 bg-white shadow-[0_1px_2px_rgba(15,23,42,.04)]';
%>

<!-- Hero: today's revenue on navy, quick actions -->
<section aria-label="Hôm nay" class="relative overflow-hidden rounded-2xl bg-navy-darker p-5 text-white shadow-[0_12px_32px_-12px_rgba(15,23,42,.45)] sm:p-7">
  <div class="pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-full bg-navy-accent/30 blur-2xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -bottom-20 left-1/3 h-48 w-48 rounded-full bg-amber-400/10 blur-2xl" aria-hidden="true"></div>
  <div class="relative flex flex-wrap items-end justify-between gap-6">
    <div class="min-w-0">
      <p class="text-sm text-navy-soft"><%= hello %><%= greetingName ? `, ${greetingName}` : '' %> · <span class="capitalize"><%= dateText %></span></p>
      <h1 class="mt-1 text-sm font-semibold uppercase tracking-wider text-navy-muted">Doanh thu hôm nay</h1>
      <p class="mt-1 font-mono text-4xl font-bold tnum sm:text-5xl"><%= money(revenue.value) %></p>
      <p class="mt-2 text-sm <%= revenue.tone === 'good' ? 'text-emerald-300' : revenue.tone === 'warn' ? 'text-amber-300' : 'text-navy-muted' %>"><%= revenue.delta %></p>
      <p class="mt-1 text-xs text-navy-muted"><%= ordersToday %> đơn hoàn tất · cập nhật lúc <%= fmtTime(new Date()) %></p>
    </div>
    <div class="grid w-full grid-cols-3 gap-2 sm:w-auto sm:grid-cols-none sm:grid-flow-col">
      <a href="/admin/pos" class="flex h-16 flex-col items-center justify-center gap-1 whitespace-nowrap rounded-xl text-xs sm:h-12 sm:flex-row sm:gap-2 sm:text-sm bg-amber-400 px-3 font-bold text-navy-darker shadow hover:bg-amber-500 sm:px-4"><%- icon('cart', 'h-5 w-5') %><span>Mở POS</span></a>
      <a href="/admin/orders" class="flex h-16 flex-col items-center justify-center gap-1 whitespace-nowrap rounded-xl text-xs sm:h-12 sm:flex-row sm:gap-2 sm:text-sm bg-white/10 px-3 font-semibold ring-1 ring-white/15 hover:bg-white/15 sm:px-4"><%- icon('receipt', 'h-5 w-5') %><span>Đơn hàng</span></a>
      <a href="/admin/reports" class="flex h-16 flex-col items-center justify-center gap-1 whitespace-nowrap rounded-xl text-xs sm:h-12 sm:flex-row sm:gap-2 sm:text-sm bg-white/10 px-3 font-semibold ring-1 ring-white/15 hover:bg-white/15 sm:px-4"><%- icon('chart', 'h-5 w-5') %><span>Báo cáo</span></a>
    </div>
  </div>
</section>

<!-- KPI cards -->
<section aria-label="Chỉ số chính" class="mt-4 grid grid-cols-2 gap-3 sm:mt-6 sm:gap-5 xl:grid-cols-4">
  <% others.forEach((k) => { %>
    <div class="<%= card %> p-4 sm:p-5">
      <div class="flex items-start justify-between gap-2">
        <p class="text-[11px] font-semibold uppercase tracking-wide text-milk-500 sm:text-xs"><%= k.label %></p>
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg <%= kpiChip[k.key] %>" aria-hidden="true"><%- icon(k.icon, 'h-5 w-5') %></span>
      </div>
      <p class="mt-2 font-mono text-xl font-bold text-navy-darker tnum sm:text-2xl"><%= k.plain ? k.value : money(k.value) %></p>
      <p class="mt-1.5 text-[11px] sm:text-xs <%= kpiTone[k.tone] || 'text-milk-500' %>"><%= k.delta %></p>
    </div>
  <% }) %>
  <div class="<%= card %> p-4 sm:p-5">
    <div class="flex items-start justify-between gap-2">
      <p class="text-[11px] font-semibold uppercase tracking-wide text-milk-500 sm:text-xs">Đang phục vụ</p>
      <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-blue-50 text-navy-accent" aria-hidden="true"><%- icon('table', 'h-5 w-5') %></span>
    </div>
    <p class="mt-2 font-mono text-xl font-bold text-navy-darker tnum sm:text-2xl"><%= counts.open_orders %> <span class="text-sm font-semibold text-milk-500">đơn</span></p>
    <p class="mt-1.5 text-[11px] text-milk-500 sm:text-xs"><a href="/admin/tables" class="text-blue-700 hover:text-navy hover:underline">Xem sơ đồ bàn →</a></p>
  </div>
</section>

<!-- Revenue by hour -->
<section aria-labelledby="hour-title" class="<%= card %> mt-4 p-4 sm:mt-6 sm:p-5">
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h2 id="hour-title" class="text-base font-semibold text-navy-darker">Doanh thu theo giờ</h2>
    <p class="text-xs text-milk-500">06:00 – 22:00 · hôm nay</p>
  </div>
  <div class="mt-4"><%- include('../partials/chart_columns', { hours: hourly }) %></div>
</section>

<div class="mt-4 grid grid-cols-12 gap-4 sm:mt-6 sm:gap-6">
  <!-- Recent orders -->
  <section aria-labelledby="recent-title" class="<%= card %> col-span-12 overflow-hidden xl:col-span-7">
    <div class="flex items-center justify-between border-b border-milk-200 px-5 py-4">
      <h2 id="recent-title" class="text-base font-semibold text-navy-darker">Đơn gần đây</h2>
      <a href="/admin/orders" class="text-xs font-medium text-blue-700 hover:text-navy">Tất cả đơn →</a>
    </div>
    <% if (!recentOrders.length) { %>
      <p class="px-5 py-10 text-center text-sm text-milk-500">Chưa có đơn hàng nào.</p>
    <% } else { %>
    <div class="relative overflow-x-auto">
      <table class="rtable w-full border-collapse text-left text-sm lg:min-w-[520px]">
        <caption class="sr-only">Đơn hàng gần đây</caption>
        <thead class="<%= ui.thead %>">
          <tr>
            <th scope="col" class="px-5 py-3">Mã đơn</th>
            <th scope="col" class="px-3 py-3">Kênh</th>
            <th scope="col" class="px-3 py-3 text-right">Tổng tiền</th>
            <th scope="col" class="px-5 py-3">Trạng thái</th>
          </tr>
        </thead>
        <tbody>
          <% recentOrders.forEach((o) => { %>
            <tr class="border-b border-milk-200 last:border-b-0 hover:bg-milk-50">
              <td data-label="" class="rt-title px-5 py-3">
                <a href="/admin/orders/<%= o.id %>" class="font-mono text-[13px] font-medium text-blue-700 hover:text-navy hover:underline"><%= o.order_code %></a>
                <span class="ml-2 text-xs text-milk-500"><%= fmtTime(o.created_at) %></span>
              </td>
              <td data-label="Kênh" class="px-3 py-3"><%- sourceBadge(o.source) %></td>
              <td data-label="Tổng tiền" class="px-3 py-3 text-right font-mono font-semibold text-navy-darker tnum"><%= money(o.total) %></td>
              <td data-label="Trạng thái" class="px-5 py-3"><%- orderStatusBadge(o) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </section>

  <!-- Low stock -->
  <section aria-labelledby="stock-title" class="<%= card %> col-span-12 overflow-hidden xl:col-span-5">
    <div class="flex items-center justify-between border-b border-milk-200 px-5 py-4">
      <h2 id="stock-title" class="text-base font-semibold text-navy-darker">Cảnh báo tồn kho thấp</h2>
      <% if (lowStock.length) { %><a href="/admin/inventory?low=1" class="rounded-full border border-amber-200 bg-amber-50 px-2.5 py-0.5 text-xs font-semibold text-amber-800"><%= lowStock.length %> mục</a><% } %>
    </div>
    <% if (!lowStock.length) { %>
      <div class="flex flex-col items-center px-5 py-10 text-center">
        <span class="flex h-12 w-12 items-center justify-center rounded-full bg-emerald-50 text-emerald-600" aria-hidden="true"><%- icon('check', 'h-6 w-6') %></span>
        <p class="mt-3 text-sm text-milk-500">Mọi nguyên liệu đều trên mức tối thiểu.</p>
      </div>
    <% } %>
    <ul>
      <% lowStock.forEach((s) => { const ratio = s.min_stock > 0 ? Math.max(0, Math.min(100, Math.round((s.quantity_on_hand / s.min_stock) * 100))) : 0; %>
        <li class="border-b border-milk-200 px-5 py-4 last:border-b-0">
          <div class="flex items-baseline justify-between gap-3">
            <a href="/admin/receiving?item=<%= s.id %>" class="text-sm font-medium text-blue-700 hover:text-navy hover:underline" title="Nhập kho"><%= s.name %></a>
            <span class="font-mono text-xs text-milk-500 tnum"><%= num(s.quantity_on_hand) %> / <%= num(s.min_stock) %> <%= s.unit %></span>
          </div>
          <div class="mt-2 h-2 w-full rounded-full bg-milk-100" role="img" aria-label="Tồn kho bằng <%= ratio %>% mức tối thiểu">
            <div class="h-2 rounded-full <%= ratio < 60 ? 'bg-red-500' : 'bg-amber-400' %>" style="width: <%= ratio %>%"></div>
          </div>
        </li>
      <% }) %>
    </ul>
  </section>
</div>

<%
  const qtyFmt = (n) => num(n);
  const chartList = [
    {
      id: 'best', title: 'Món bán chạy', subtitle: '30 ngày gần nhất · theo số ly/món bán ra',
      link: { href: '/admin/reports', label: 'Báo cáo' }, empty: 'Chưa có đơn hoàn tất trong 30 ngày.',
      rows: charts.bestSellers.map((p) => ({ label: p.name, value: p.qty, display: `${num(p.qty)} món`, detail: `${num(p.qty)} món · doanh thu ${money(p.revenue)}` })),
    },
    {
      id: 'low', title: 'Hàng sắp hết', subtitle: 'Tồn kho so với mức tối thiểu · thấp nhất trước',
      link: { href: '/admin/inventory?low=1', label: 'Nhập kho' }, empty: 'Không có nguyên liệu nào dưới mức tối thiểu.',
      rows: charts.lowStock.map((i) => ({ label: i.name, href: `/admin/receiving?item=${i.id}`, value: Math.round(i.ratio * 100), display: `${Math.round(i.ratio * 100)}%`,
        tone: i.ratio < 0.5 ? 'critical' : 'warning', detail: `còn ${num(i.qty)} / tối thiểu ${num(i.min)} ${i.unit}` })),
    },
    {
      id: 'over', title: 'Nguyên liệu tồn kho nhiều', subtitle: 'Giá trị tồn (số lượng × giá vốn bình quân)',
      link: { href: '/admin/inventory', label: 'Kho' }, empty: 'Chưa có giá trị tồn kho.',
      rows: charts.overstock.map((i) => ({ label: i.name, href: `/admin/inventory/${i.id}`, value: i.value, display: money(i.value),
        detail: `${num(i.qty)} ${i.unit}${i.cover ? ` · gấp ${num(Math.round(i.cover * 10) / 10)} lần mức tối thiểu` : ''}` })),
    },
    {
      id: 'debt', title: 'Khách hàng công nợ nhiều nhất', subtitle: 'Đơn Zalo đã giao nhưng chưa thu tiền',
      link: { href: '/admin/orders?status=completed&payment=unpaid', label: 'Đơn chờ thu' }, empty: 'Không có khách nào đang nợ.',
      rows: charts.debtors.map((d) => ({ label: d.who, value: d.amount, display: money(d.amount),
        detail: `${d.orders} đơn chưa thu${d.oldest ? ` · cũ nhất ${fmtTime(d.oldest)}` : ''}` })),
    },
  ];
%>
<h2 class="mt-8 text-lg font-semibold text-navy-darker">Phân tích nhanh</h2>
<div class="mt-3 grid grid-cols-1 gap-4 sm:gap-6 lg:grid-cols-2">
  <% chartList.forEach((chart) => { %><%- include('../partials/barchart', { chart }) %><% }) %>
</div>
