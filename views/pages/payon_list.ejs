<%
  const { input, label, btnPrimary, btnSecondary } = ui;
  const STATUS = {
    pending: ['Chờ khách', 'info'], applying: ['Đang ghi nhận', 'info'], paid: ['Đã thu', 'good'], manual: ['Cần xử lý', 'bad'],
    resolved: ['Đã xử lý', 'neutral'], expired: ['Hết hạn', 'neutral'], failed: ['Thất bại', 'neutral'],
  };
  const when = (d) => (d ? new Date(d).toLocaleString('vi-VN', { timeZone: 'Asia/Ho_Chi_Minh', dateStyle: 'short', timeStyle: 'short' }) : '—');
%>
<div>
  <h1 class="text-xl font-semibold tracking-tight sm:text-2xl">Giao dịch PayOn</h1>
  <p class="mt-1 text-sm text-gray-500">Tiền khách chuyển qua mã QR PayOn. Khoản "cần xử lý" là tiền đã về nhưng không tự ghi vào đơn được (đơn đã hủy, đã thu cách khác, đổi số tiền…).</p>
</div>

<section class="mt-5 rounded border border-red-200 bg-white" aria-labelledby="attn-title">
  <h2 id="attn-title" class="border-b border-red-200 px-5 py-3 text-base font-semibold text-red-800">Cần xử lý (<%= attention.length %>)</h2>
  <% if (!attention.length) { %>
    <p class="px-5 py-4 text-sm text-gray-500">Không có khoản nào cần xử lý.</p>
  <% } else { %>
    <ul class="divide-y divide-gray-200">
      <% attention.forEach((m) => { %>
      <li class="px-5 py-4 text-sm">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <p class="font-semibold"><%= money(m.received == null ? m.amount : m.received) %> · đơn
            <% if (m.order_id) { %><a class="underline" href="/admin/orders/<%= m.order_id %>"><%= m.order_code || `#${m.order_id}` %></a><% } else { %>—<% } %></p>
          <p class="text-xs text-gray-500"><%= when(m.paid_at || m.created_at) %> · mã <span class="font-mono"><%= m.merchant_request_id %></span></p>
        </div>
        <p class="mt-1 text-red-900"><%= m.note || 'Cần xử lý tay.' %></p>
        <div class="mt-3 flex flex-wrap items-end gap-3">
          <form method="post" action="/admin/payon/<%= m.id %>/apply">
            <%- include('../partials/csrf') %><input type="hidden" name="_back" value="/admin/payon">
            <button type="submit" class="<%= btnSecondary %>">Thử ghi nhận lại</button>
          </form>
          <form method="post" action="/admin/payon/<%= m.id %>/resolve" class="flex flex-wrap items-end gap-2" data-confirm="Đánh dấu khoản này là đã xử lý? (ví dụ đã hoàn tiền cho khách)">
            <%- include('../partials/csrf') %><input type="hidden" name="_back" value="/admin/payon">
            <div>
              <label for="note-<%= m.id %>" class="<%= label %>">Cách đã xử lý</label>
              <input id="note-<%= m.id %>" name="note" required maxlength="150" placeholder="VD: đã hoàn 79.000đ cho khách ngày 15/10" class="<%= input %> w-72 max-w-full">
            </div>
            <button type="submit" class="<%= btnPrimary %>">Đã xử lý</button>
          </form>
        </div>
      </li>
      <% }) %>
    </ul>
  <% } %>
</section>

<section class="mt-5 rounded border border-gray-200 bg-white" aria-labelledby="recent-title">
  <h2 id="recent-title" class="border-b border-gray-200 px-5 py-3 text-base font-semibold">Gần đây</h2>
  <% if (!recent.length) { %>
    <p class="px-5 py-4 text-sm text-gray-500">Chưa có giao dịch nào.</p>
  <% } else { %>
  <table class="rtable w-full border-collapse text-left text-sm lg:min-w-[640px]">
    <caption class="sr-only">Giao dịch PayOn gần đây</caption>
    <thead class="<%= ui.thead %>"><tr><th scope="col" class="px-4 py-3">Thời gian</th><th scope="col" class="px-4 py-3">Đơn</th><th scope="col" class="px-4 py-3 text-right">Số tiền</th><th scope="col" class="px-4 py-3">Trạng thái</th><th scope="col" class="px-4 py-3">Ghi chú</th></tr></thead>
    <tbody>
      <% recent.forEach((r) => { const st = STATUS[r.status] || [r.status, 'neutral']; %>
      <tr class="border-b border-gray-200 last:border-b-0">
        <td data-label="Thời gian" class="px-4 py-3"><%= when(r.paid_at || r.created_at) %></td>
        <td data-label="Đơn" class="rt-title px-4 py-3"><% if (r.order_id) { %><a class="underline" href="/admin/orders/<%= r.order_id %>"><%= r.order_code || `#${r.order_id}` %></a><% } else { %>—<% } %></td>
        <td data-label="Số tiền" class="px-4 py-3 text-right font-mono"><%= money(r.received == null ? r.amount : r.received) %></td>
        <td data-label="Trạng thái" class="px-4 py-3"><%- badge(st[0], st[1]) %></td>
        <td data-label="Ghi chú" class="px-4 py-3 text-gray-600"><%= r.note || '' %></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</section>
