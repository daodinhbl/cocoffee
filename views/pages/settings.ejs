<%
  const { input, label, btnPrimary, btnSecondary, btnGhost, sheet, grabber } = ui;
  const ROLE = { admin: 'Quản trị viên', cashier: 'Thu ngân' };
  const onOff = (v) => (v ? badge('Bật', 'good') : badge('Tắt', 'neutral'));
%>
<div>
  <h1 class="text-xl font-semibold tracking-tight sm:text-2xl">Cài đặt</h1>
  <p class="mt-1 text-sm text-gray-500">Tài khoản của bạn, nhân sự và cấu hình hệ thống.</p>
</div>

<div class="mt-5 grid grid-cols-12 gap-4 sm:gap-6">
  <section class="col-span-12 rounded border border-gray-200 p-5 lg:col-span-5" aria-labelledby="pw-title">
    <h2 id="pw-title" class="text-base font-semibold">Đổi mật khẩu</h2>
    <% if (forced) { %>
      <p class="mt-2 rounded border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800">Mật khẩu hiện tại quá yếu (ví dụ mật khẩu mặc định). Đặt mật khẩu mới để tiếp tục sử dụng trang quản trị.</p>
    <% } %>
    <form method="post" action="/admin/settings/password" class="mt-4 space-y-4">
      <%- include('../partials/csrf') %>
      <div>
        <label for="pw-cur" class="<%= label %>">Mật khẩu hiện tại</label>
        <input id="pw-cur" name="current_password" type="password" required autocomplete="current-password" maxlength="200" class="<%= input %>">
      </div>
      <div>
        <label for="pw-new" class="<%= label %>">Mật khẩu mới (tối thiểu 10 ký tự)</label>
        <input id="pw-new" name="new_password" type="password" required minlength="10" autocomplete="new-password" maxlength="200" class="<%= input %>">
      </div>
      <div>
        <label for="pw-cfm" class="<%= label %>">Nhập lại mật khẩu mới</label>
        <input id="pw-cfm" name="confirm_password" type="password" required minlength="10" autocomplete="new-password" maxlength="200" class="<%= input %>">
      </div>
      <button type="submit" class="<%= btnPrimary %> w-full sm:w-auto">Đổi mật khẩu</button>
    </form>
  </section>

  <% if (!forced) { %>
  <section class="col-span-12 rounded border border-gray-200 p-5 lg:col-span-7" aria-labelledby="cfg-title">
    <h2 id="cfg-title" class="text-base font-semibold">Cấu hình hệ thống</h2>
    <p class="mt-1 text-xs text-gray-500">Tên miền công khai sửa được ngay bên dưới; các mục còn lại chỉ đọc, đổi trong biến môi trường của ứng dụng (hPanel) rồi khởi động lại.</p>
    <dl class="mt-3 space-y-2 text-sm">
      <div class="flex justify-between gap-3"><dt class="text-gray-500">Tên quán (SHOP_NAME)</dt><dd><%= shopName %></dd></div>
      <div class="flex justify-between gap-3"><dt class="text-gray-500">Tên miền công khai</dt><dd class="break-all text-right font-mono text-xs"><%= config.publicBaseUrl %></dd></div>
      <div class="flex justify-between gap-3"><dt class="text-gray-500">Cho phép bán khi âm kho</dt><dd><%- onOff(config.allowNegativeStock) %></dd></div>
      <div class="flex justify-between gap-3"><dt class="text-gray-500">Đơn nháp Zalo hết hạn sau</dt><dd><%= config.draftTtlMinutes %> phút</dd></div>
      <div class="flex justify-between gap-3"><dt class="text-gray-500">Xác thực chữ ký Zalo</dt><dd><%- onOff(config.verifySignature) %></dd></div>
      <div class="flex justify-between gap-3"><dt class="text-gray-500">Bill dạng hình ảnh</dt><dd><%- onOff(config.receiptImage) %></dd></div>
      <div class="flex justify-between gap-3"><dt class="text-gray-500">Múi giờ cơ sở dữ liệu</dt><dd class="font-mono"><%= config.timezone %></dd></div>
      <div class="flex justify-between gap-3"><dt class="text-gray-500">Phiên đăng nhập</dt><dd class="font-mono"><%= config.sessionHours %></dd></div>
    </dl>
    <form method="post" action="/admin/settings/public-url" class="mt-4 border-t border-milk-200 pt-4" autocomplete="off">
      <%- include('../partials/csrf') %>
      <input type="hidden" name="_back" value="/admin/settings">
      <label for="public-url" class="text-sm font-medium">Sửa tên miền công khai</label>
      <p class="mt-0.5 text-xs text-gray-500">Địa chỉ mà mã QR, webhook Zalo, PayOn và hóa đơn dạng ảnh dùng để quay về quán (ví dụ <span class="font-mono">https://quan-cua-toi.ngrok-free.app</span>). Địa chỉ lưu ở đây được ưu tiên hơn biến <span class="font-mono">PUBLIC_BASE_URL</span><%= config.publicBaseUrlEnv ? ` (${config.publicBaseUrlEnv})` : '' %>; để trống rồi lưu để dùng lại biến đó.</p>
      <div class="mt-2 flex flex-wrap gap-2">
        <input id="public-url" name="public_url" type="text" inputmode="url" autocapitalize="none" spellcheck="false" maxlength="200" value="<%= config.publicBaseUrlSource === 'settings' ? config.publicBaseUrl : '' %>" placeholder="<%= config.publicBaseUrlEnv || 'https://ten-mien-cua-ban.com' %>" class="<%= input %> min-w-0 flex-1 font-mono text-sm">
        <button type="submit" class="<%= btnPrimary %>">Lưu</button>
      </div>
      <p class="mt-1 text-xs text-gray-500">Đang dùng: <b class="font-mono"><%= config.publicBaseUrl %></b><%= config.publicBaseUrlSource === 'settings' ? ' (đã lưu trong Cài đặt)' : config.publicBaseUrlSource === 'env' ? ' (biến môi trường)' : '' %></p>
    </form>
  </section>

  <% if (heli) { %>
  <section class="col-span-12 rounded border border-gray-200 bg-white p-5" aria-labelledby="heli-title">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <h2 id="heli-title" class="text-base font-semibold">Trợ lý Heli (ChatGPT / OpenAI)</h2>
        <p class="mt-1 max-w-3xl text-xs text-gray-500">Khóa API để trợ lý giọng nói Heli trả lời câu hỏi về quán. Lấy khóa tại <span class="font-mono">platform.openai.com/api-keys</span>. Khóa lưu ở đây được ưu tiên hơn biến <span class="font-mono">OPENAI_API_KEY</span>; ô để trống thì giữ nguyên khóa hiện có. Khóa không bao giờ hiện lại sau khi lưu.</p>
      </div>
      <%- badge(heli.enabled ? 'Đang bật' : 'Chưa có khóa', heli.enabled ? 'good' : 'neutral') %>
    </div>
    <form method="post" action="/admin/settings/heli" class="mt-4 grid gap-3 sm:grid-cols-2" autocomplete="off">
      <%- include('../partials/csrf') %>
      <input type="hidden" name="_back" value="/admin/settings">
      <div class="sm:col-span-2">
        <label for="heli-key" class="<%= label %>">Khóa API<%= heli.hint ? ` (đang dùng ${heli.hint}, ${heli.source === 'settings' ? 'đã lưu trong Cài đặt' : 'từ biến môi trường'})` : '' %></label>
        <input id="heli-key" name="api_key" type="password" maxlength="320" autocomplete="new-password" spellcheck="false" placeholder="<%= heli.hint ? 'Để trống để giữ khóa hiện tại' : 'sk-…' %>" class="<%= input %> font-mono text-sm">
      </div>
      <div>
        <label for="heli-model" class="<%= label %>">Mô hình trả lời</label>
        <input id="heli-model" name="model" list="heli-models" maxlength="60" value="<%= heli.model %>" class="<%= input %> font-mono text-sm">
        <datalist id="heli-models"><% heli.models.forEach((m) => { %><option value="<%= m %>"><% }) %></datalist>
      </div>
      <div class="flex flex-wrap items-end gap-2">
        <button type="submit" class="<%= btnPrimary %>">Lưu</button>
        <button type="submit" formaction="/admin/settings/heli/test" class="<%= btnSecondary %>">Kiểm tra khóa</button>
        <% if (heli.source === 'settings') { %><button type="submit" name="clear" value="1" class="<%= btnGhost %> text-red-700" data-confirm="Xóa khóa API đã lưu?">Xóa khóa đã lưu</button><% } %>
      </div>
    </form>
  </section>
  <% } %>

  <% if (machineId) { %>
  <section class="col-span-12 rounded border border-gray-200 bg-white p-5" aria-labelledby="mid-title">
    <h2 id="mid-title" class="text-base font-semibold">Mã máy (giấy phép)</h2>
    <p class="mt-1 max-w-3xl text-xs text-gray-500">Giấy phép của máy chủ này gắn với mã máy bên dưới. Gửi mã này cho người cấp giấy phép để nhận mã kích hoạt, rồi dán mã đó vào tab Giấy phép của chương trình POS Tasotek Server trên máy tính của quán.</p>
    <div class="mt-3 flex flex-wrap items-center gap-3">
      <code id="machine-id" class="select-all rounded bg-milk-100 px-3 py-2 font-mono text-sm font-semibold"><%= machineId %></code>
      <button type="button" data-copy-from="#machine-id" data-copy-note="#copy-note" class="<%= btnSecondary %>">Sao chép mã máy</button>
      <span id="copy-note" class="text-xs text-gray-500" aria-live="polite"></span>
    </div>
  </section>
  <% } %>

  <% if (dbConn) { %>
  <section class="col-span-12 rounded border border-gray-200 bg-white p-5" aria-labelledby="dbconn-title">
    <h2 id="dbconn-title" class="text-base font-semibold">Kết nối cơ sở dữ liệu</h2>
    <p class="mt-1 max-w-3xl text-xs text-gray-500">Đổi máy chủ, tên, người dùng và mật khẩu CSDL không cần vào hPanel. Kết nối được thử trước khi lưu; lưu xong phải <b>khởi động lại ứng dụng</b> mới áp dụng. Mỗi thao tác cần nhập lại mật khẩu quản trị của bạn. Mật khẩu CSDL không bao giờ hiện lại.</p>
    <div class="mt-4 grid gap-5 lg:grid-cols-2">
    <% [['db', 'CSDL của ứng dụng này', 'Nơi ứng dụng đọc và ghi dữ liệu (CSDL cục bộ của máy cài đặt, hoặc của Hostinger).'], ['cloud', 'CSDL đám mây (Hostinger)', 'Nơi máy cục bộ sao chép dữ liệu lên khi có mạng (đồng bộ ngoại tuyến). Để trống nếu không dùng.']].forEach(([sec, title, hint]) => {
         const info = dbConn.sections[sec]; const cur = info.saved || info.running || {}; %>
      <form method="post" action="/admin/settings/db/save" class="rounded-lg border border-milk-200 p-4" autocomplete="off">
        <%- include('../partials/csrf') %>
        <input type="hidden" name="_back" value="/admin/settings">
        <input type="hidden" name="section" value="<%= sec %>">
        <div class="flex flex-wrap items-start justify-between gap-2">
          <h3 class="text-sm font-semibold"><%= title %></h3>
          <% if (info.restartNeeded) { %><%- badge('Cần khởi động lại', 'warn') %><% } else if (info.source === 'file') { %><%- badge('Đã lưu trong Cài đặt', 'info') %><% } else if (info.source === 'env') { %><%- badge('Từ biến môi trường', 'neutral') %><% } %>
        </div>
        <p class="mt-0.5 text-xs text-gray-500"><%= hint %></p>
        <div class="mt-3 grid gap-3 sm:grid-cols-3">
          <div class="sm:col-span-2"><label class="<%= label %>" for="db-<%= sec %>-host">Máy chủ</label><input id="db-<%= sec %>-host" name="host" value="<%= cur.host || '' %>" maxlength="120" class="<%= input %> font-mono text-sm" placeholder="127.0.0.1"></div>
          <div><label class="<%= label %>" for="db-<%= sec %>-port">Cổng</label><input id="db-<%= sec %>-port" name="port" type="number" min="1" max="65535" value="<%= cur.port || 3306 %>" class="<%= input %> font-mono text-sm"></div>
          <div><label class="<%= label %>" for="db-<%= sec %>-name">Tên CSDL</label><input id="db-<%= sec %>-name" name="name" value="<%= cur.name || '' %>" maxlength="64" class="<%= input %> font-mono text-sm"></div>
          <div><label class="<%= label %>" for="db-<%= sec %>-user">Người dùng</label><input id="db-<%= sec %>-user" name="user" value="<%= cur.user || '' %>" maxlength="64" class="<%= input %> font-mono text-sm"></div>
          <div><label class="<%= label %>" for="db-<%= sec %>-pass">Mật khẩu CSDL</label><input id="db-<%= sec %>-pass" name="password" type="password" maxlength="200" autocomplete="new-password" placeholder="<%= cur.hasPassword ? 'Để trống để giữ mật khẩu hiện tại' : '' %>" class="<%= input %> font-mono text-sm"></div>
          <div class="sm:col-span-3"><label class="<%= label %>" for="db-<%= sec %>-admin">Mật khẩu quản trị của bạn (xác nhận)</label><input id="db-<%= sec %>-admin" name="admin_password" type="password" required maxlength="200" autocomplete="current-password" class="<%= input %>"></div>
        </div>
        <div class="mt-3 flex flex-wrap gap-2">
          <button type="submit" formaction="/admin/settings/db/test" class="<%= btnSecondary %>">Kiểm tra kết nối</button>
          <button type="submit" class="<%= btnPrimary %>">Lưu</button>
          <% if (info.source === 'file') { %><button type="submit" formaction="/admin/settings/db/reset" class="<%= btnGhost %> text-red-700" data-confirm="Bỏ kết nối đã lưu và dùng lại biến môi trường sau khi khởi động lại?">Bỏ kết nối đã lưu</button><% } %>
        </div>
      </form>
    <% }) %>
    </div>
    <% if (dbConn.sections.db.restartNeeded || dbConn.sections.cloud.restartNeeded) { %>
      <form method="post" action="/admin/settings/db/restart" class="mt-4 flex flex-wrap items-end gap-2 rounded-lg border border-amber-300 bg-amber-50 p-3" autocomplete="off">
        <%- include('../partials/csrf') %>
        <input type="hidden" name="_back" value="/admin/settings">
        <p class="w-full text-sm text-amber-900">Có thay đổi kết nối chưa áp dụng. <%= dbConn.canRestart ? 'Bấm khởi động lại (cần mật khẩu quản trị).' : 'Ứng dụng đang chạy trực tiếp: hãy tắt và mở lại ứng dụng, hoặc khởi động lại trong hPanel.' %></p>
        <% if (dbConn.canRestart) { %>
          <input name="admin_password" type="password" required maxlength="200" placeholder="Mật khẩu quản trị" autocomplete="current-password" class="<%= input %> max-w-xs">
          <button type="submit" class="<%= btnPrimary %>">Khởi động lại ngay</button>
        <% } %>
      </form>
    <% } %>
  </section>
  <% } %>

  <% if (shop) { %>
  <section class="col-span-12 rounded border border-gray-200 bg-white p-5" aria-labelledby="shop-title">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <h2 id="shop-title" class="text-base font-semibold">Thông tin cửa hàng / hộ kinh doanh</h2>
        <p class="mt-1 max-w-3xl text-xs text-gray-500">Tên, địa chỉ, điện thoại hiển thị trên hóa đơn, tin nhắn Zalo và trang giới thiệu. Chủ hộ, mã số thuế, số giấy đăng ký và kỳ kê khai dùng cho sổ sách và báo cáo thuế. Để trống một ô thì dùng giá trị mặc định của hệ thống.</p>
      </div>
      <div><%- shop.stored.taxCode ? badge(`MST ${shop.stored.taxCode}`, 'good') : badge('Chưa có mã số thuế', 'neutral') %></div>
    </div>
    <form method="post" action="/admin/settings/shop" class="mt-4 grid grid-cols-12 gap-4">
      <%- include('../partials/csrf') %>
      <input type="hidden" name="_back" value="/admin/settings">
      <% const span = { name: 'sm:col-span-6 lg:col-span-4', legalName: 'sm:col-span-6 lg:col-span-4', ownerName: 'sm:col-span-6 lg:col-span-4', taxCode: 'sm:col-span-6 lg:col-span-3', regNo: 'sm:col-span-6 lg:col-span-3', address: 'sm:col-span-12 lg:col-span-6', phone: 'sm:col-span-6 lg:col-span-3', email: 'sm:col-span-6 lg:col-span-4', businessLine: 'sm:col-span-6 lg:col-span-5' }; %>
      <% shopFields.forEach(([key, text, max, kind]) => { %>
        <div class="col-span-12 <%= span[key] || 'sm:col-span-6' %>">
          <label for="shop-<%= key %>" class="<%= label %>"><%= text %></label>
          <input id="shop-<%= key %>" name="<%= key %>" maxlength="<%= max %>" value="<%= shop.stored[key] %>" placeholder="<%= shop.defaults[key] %>" autocomplete="off"
                 <%- kind === 'tax' ? 'inputmode="numeric" pattern="\\d{10}(-\\d{3})?"' : '' %> <%- kind === 'email' ? 'type="email"' : '' %> class="<%= input %> <%= kind === 'tax' ? 'font-mono' : '' %>">
        </div>
      <% }) %>
      <div class="col-span-12 sm:col-span-6 lg:col-span-3">
        <label for="shop-period" class="<%= label %>">Kỳ kê khai thuế</label>
        <select id="shop-period" name="declarationPeriod" class="<%= input %>">
          <% declarationPeriods.forEach((p) => { %><option value="<%= p.code %>" <%= (shop.stored.declarationPeriod || shop.defaults.declarationPeriod) === p.code ? 'selected' : '' %>><%= p.label %></option><% }) %>
        </select>
      </div>
      <div class="col-span-12"><button type="submit" class="<%= btnPrimary %> w-full sm:w-auto">Lưu thông tin cửa hàng</button></div>
    </form>
  </section>
  <% } %>

  <section class="col-span-12 rounded border border-gray-200 bg-white p-5" aria-labelledby="ios-title">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <h2 id="ios-title" class="text-base font-semibold">Ứng dụng iOS (iPhone / iPad)</h2>
        <p class="mt-1 text-xs text-gray-500">Trang <a href="/download/ios" target="_blank" rel="noopener" class="font-semibold text-blue-700 hover:underline">/download/ios</a> và mã QR trên trang đăng nhập dẫn tới liên kết này: liên kết công khai <b>TestFlight</b> (bản thử nghiệm) hoặc trang <b>App Store</b> khi đã phát hành. Để trống khi chưa có; bản Android không bị ảnh hưởng.</p>
      </div>
      <div><%- iosApp.link ? badge(iosApp.link.label, 'good') : badge('Chưa có liên kết', 'neutral') %></div>
    </div>
    <form method="post" action="/admin/settings/ios-app" class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-end">
      <%- include('../partials/csrf') %>
      <div class="min-w-0 flex-1">
        <label for="ios-url" class="<%= label %>">Liên kết tải (https://testflight.apple.com/join/… hoặc https://apps.apple.com/…)</label>
        <input id="ios-url" name="url" type="url" maxlength="300" value="<%= iosApp.url %>" placeholder="https://testflight.apple.com/join/XXXXXXXX" inputmode="url" autocomplete="off" spellcheck="false" class="<%= input %> font-mono text-xs">
      </div>
      <button type="submit" class="<%= btnPrimary %> w-full sm:w-auto">Lưu liên kết</button>
    </form>
    <% if (!iosApp.url && iosApp.fallback) { %>
      <p class="mt-2 text-xs text-gray-500">Đang dùng <code class="font-mono">IOS_APP_URL</code> từ biến môi trường: <span class="break-all font-mono"><%= iosApp.fallback.url %></span></p>
    <% } %>
  </section>

  <section class="col-span-12 rounded border border-gray-200 bg-white p-5" aria-labelledby="printer-title">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <h2 id="printer-title" class="text-base font-semibold">Máy in hóa đơn</h2>
        <p class="mt-1 text-xs text-gray-500">Áp dụng cho hóa đơn in từ màn hình bán hàng (POS) và trang chi tiết đơn. Trình duyệt in ra <b>máy in mặc định</b> của thiết bị: hãy đặt máy in nhiệt làm mặc định và chọn khổ giấy tương ứng trong hộp thoại in lần đầu.</p>
      </div>
      <a href="/admin/pos/receipt/sample" target="_blank" rel="noopener" class="<%= btnSecondary %>"><%- icon('receipt', 'h-4 w-4') %> In thử</a>
    </div>
    <form method="post" action="/admin/settings/printer" class="mt-4 grid grid-cols-12 gap-4">
      <%- include('../partials/csrf') %>
      <input type="hidden" name="_back" value="/admin/settings">
      <fieldset class="col-span-12 sm:col-span-6 lg:col-span-4">
        <legend class="<%= label %>">Khổ giấy</legend>
        <div class="flex gap-2">
          <% [80, 58].forEach((mm) => { %>
          <label class="flex h-10 flex-1 cursor-pointer items-center justify-center gap-2 rounded border border-gray-300 bg-white text-sm font-medium has-[:checked]:border-navy-accent has-[:checked]:bg-blue-50 has-[:checked]:text-navy">
            <input type="radio" name="paperMm" value="<%= mm %>" <%= printer.paperMm === mm ? 'checked' : '' %> class="accent-blue-700"> <%= mm %>mm
          </label>
          <% }) %>
        </div>
      </fieldset>
      <div class="col-span-6 sm:col-span-3 lg:col-span-2">
        <label for="p-copies" class="<%= label %>">Số liên</label>
        <select id="p-copies" name="copies" class="<%= input %>">
          <% [1, 2, 3].forEach((n) => { %><option value="<%= n %>" <%= printer.copies === n ? 'selected' : '' %>><%= n %> liên</option><% }) %>
        </select>
      </div>
      <div class="col-span-6 sm:col-span-3 lg:col-span-2">
        <label for="p-vat" class="<%= label %>">Thuế VAT (%)</label>
        <input id="p-vat" name="vatRate" type="number" min="0" max="20" step="1" inputmode="numeric" value="<%= printer.vatRate %>" class="<%= input %> text-right font-mono">
      </div>
      <div class="col-span-12 lg:col-span-4">
        <label for="p-name" class="<%= label %>">Tên máy in (ghi chú)</label>
        <input id="p-name" name="printerName" maxlength="100" value="<%= printer.printerName %>" placeholder="VD: Xprinter XP-80C quầy 1" class="<%= input %>">
      </div>
      <div class="col-span-12 sm:col-span-8">
        <label for="p-addr" class="<%= label %>">Địa chỉ in trên hóa đơn</label>
        <input id="p-addr" name="shopAddress" maxlength="200" value="<%= printer.shopAddress %>" placeholder="Số nhà, đường, phường, thành phố" class="<%= input %>">
      </div>
      <div class="col-span-12 sm:col-span-4">
        <label for="p-phone" class="<%= label %>">Điện thoại</label>
        <input id="p-phone" name="shopPhone" maxlength="30" value="<%= printer.shopPhone %>" inputmode="tel" class="<%= input %>">
      </div>
      <div class="col-span-12">
        <label for="p-footer" class="<%= label %>">Lời chào cuối hóa đơn</label>
        <input id="p-footer" name="footer" maxlength="255" value="<%= printer.footer %>" class="<%= input %>">
      </div>
      <div class="col-span-12 grid grid-cols-12 gap-4">
        <div class="col-span-12 sm:col-span-6 lg:col-span-4">
          <label for="p-wifi" class="<%= label %>">Tên Wi-Fi (in cuối hóa đơn)</label>
          <input id="p-wifi" name="wifiName" maxlength="60" value="<%= printer.wifiName %>" autocomplete="off" placeholder="VD: CoCoffee" class="<%= input %>">
        </div>
        <div class="col-span-12 sm:col-span-6 lg:col-span-4">
          <label for="p-wifipw" class="<%= label %>">Mật khẩu Wi-Fi</label>
          <input id="p-wifipw" name="wifiPassword" maxlength="60" value="<%= printer.wifiPassword %>" autocomplete="off" spellcheck="false" class="<%= input %> font-mono">
        </div>
        <p class="col-span-12 -mt-2 text-xs text-gray-500">Địa chỉ và điện thoại ở trên cũng được in ngay dưới tên quán. Để trống Wi-Fi thì không in.</p>
      </div>
      <div class="col-span-12 grid grid-cols-12 gap-4 rounded-lg border border-gray-200 p-4">
        <div class="col-span-12 lg:col-span-8">
          <%- include('../partials/image_field', { fieldId: 'logo', mode: 'logo', current: printer.logoUrl, title: 'Logo cửa hàng (in trên đầu hóa đơn)', hint: 'PNG/JPEG. Nên dùng logo nền trắng, nét đậm (máy in nhiệt chỉ in đen trắng). Ảnh tự thu nhỏ tối đa 480 × 240 px.' }) %>
        </div>
        <div class="col-span-12 lg:col-span-4">
          <label for="p-logo-size" class="<%= label %>">Cỡ logo trên hóa đơn</label>
          <select id="p-logo-size" name="logoSize" class="<%= input %>">
            <% [['s', 'Nhỏ (22mm)'], ['m', 'Vừa (32mm)'], ['l', 'Lớn (44mm)']].forEach(([k, t]) => { %><option value="<%= k %>" <%= printer.logoSize === k ? 'selected' : '' %>><%= t %></option><% }) %>
          </select>
        </div>
      </div>
      <div class="col-span-12 flex flex-wrap gap-x-6 gap-y-2 text-sm">
        <label class="flex min-h-10 items-center gap-2">
          <input type="hidden" name="autoPrint" value="0">
          <input type="checkbox" name="autoPrint" value="1" <%= printer.autoPrint ? 'checked' : '' %> class="h-4 w-4 rounded border-gray-300 accent-blue-700">
          Tự động in sau khi thanh toán ở POS
        </label>
        <label class="flex min-h-10 items-center gap-2">
          <input type="hidden" name="showVat" value="0">
          <input type="checkbox" name="showVat" value="1" <%= printer.showVat ? 'checked' : '' %> class="h-4 w-4 rounded border-gray-300 accent-blue-700">
          Hiện dòng "Đã gồm VAT" trên hóa đơn
        </label>
      </div>
      <div class="col-span-12">
        <button type="submit" class="<%= btnPrimary %> w-full sm:w-auto">Lưu cấu hình máy in</button>
      </div>
    </form>
  </section>

  <% const px = payonPanel.config; %>
  <section class="col-span-12 rounded border border-gray-200 bg-white p-5" aria-labelledby="payon-cfg-title">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <h2 id="payon-cfg-title" class="text-base font-semibold">Thanh toán QR (PayOn / NextPay)</h2>
        <p class="mt-1 text-xs text-gray-500">Mỗi đơn có một mã QR ngân hàng theo đúng số tiền; khách chuyển khoản xong, PayOn báo về máy chủ và đơn tự chuyển sang "Đã thu" (kèm tin Zalo cho khách và chủ quán). Khóa lấy trong cổng PayOn → Tích hợp thanh toán → Thông tin kết nối. Để trống ô mật khẩu/khóa để giữ giá trị đã lưu.</p>
      </div>
      <span><%- px.ready ? badge('Đang bật', 'good') : (px.complete ? badge('Chưa bật', 'warn') : badge('Chưa cấu hình', 'neutral')) %></span>
    </div>
    <dl class="mt-3 grid gap-x-6 gap-y-1 text-xs text-gray-600 sm:grid-cols-2">
      <div class="flex justify-between gap-3"><dt>Địa chỉ nhận thông báo (url_notify)</dt><dd class="break-all text-right font-mono"><%= payonPanel.ipnUrl || '(chưa đặt PUBLIC_BASE_URL)' %></dd></div>
      <div class="flex justify-between gap-3"><dt>Máy chủ PayOn</dt><dd class="break-all text-right font-mono"><%= px.baseUrl %></dd></div>
    </dl>
    <form method="post" action="/admin/settings/payon" class="mt-4 grid grid-cols-12 gap-4" autocomplete="off">
      <%- include('../partials/csrf') %>
      <input type="hidden" name="_back" value="/admin/settings">
      <div class="col-span-12 sm:col-span-4">
        <label for="px-env" class="<%= label %>">Môi trường</label>
        <select id="px-env" name="env" class="<%= input %>" <%= px.fromEnv.env ? 'disabled' : '' %>>
          <option value="sandbox" <%= px.env === 'sandbox' ? 'selected' : '' %>>Thử nghiệm (sandbox)</option>
          <option value="production" <%= px.env === 'production' ? 'selected' : '' %>>Thật (production)</option>
        </select>
      </div>
      <div class="col-span-12 sm:col-span-4">
        <label for="px-app" class="<%= label %>">APP_ID</label>
        <input id="px-app" name="appId" maxlength="60" value="<%= px.appId %>" class="<%= input %> font-mono" <%= px.fromEnv.appId ? 'readonly' : '' %>>
      </div>
      <div class="col-span-12 sm:col-span-4">
        <label for="px-mc" class="<%= label %>">Mã merchant (MC_ID, số)</label>
        <input id="px-mc" name="merchantId" maxlength="20" inputmode="numeric" value="<%= px.merchantId %>" class="<%= input %> font-mono" <%= px.fromEnv.merchantId ? 'readonly' : '' %>>
      </div>
      <div class="col-span-12 sm:col-span-4">
        <label for="px-user" class="<%= label %>">MC_AUTH_USER</label>
        <input id="px-user" name="authUser" maxlength="100" value="<%= px.authUser %>" class="<%= input %> font-mono" <%= px.fromEnv.authUser ? 'readonly' : '' %>>
      </div>
      <div class="col-span-12 sm:col-span-4">
        <label for="px-pass" class="<%= label %>">MC_AUTH_PASS <span class="font-normal text-gray-500"><%= px.authPassSet ? `(đã lưu ${px.authPassHint})` : '(chưa có)' %></span></label>
        <input id="px-pass" name="authPass" type="password" maxlength="200" class="<%= input %>" placeholder="<%= px.authPassSet ? 'Để trống = giữ nguyên' : '' %>" autocomplete="new-password" <%= px.fromEnv.authPass ? 'readonly' : '' %>>
      </div>
      <div class="col-span-12 sm:col-span-4">
        <label for="px-key" class="<%= label %>">MC_SECRET_KEY <span class="font-normal text-gray-500"><%= px.secretKeySet ? `(đã lưu ${px.secretKeyHint})` : '(chưa có)' %></span></label>
        <input id="px-key" name="secretKey" type="password" maxlength="200" class="<%= input %>" placeholder="<%= px.secretKeySet ? 'Để trống = giữ nguyên' : '' %>" autocomplete="new-password" <%= px.fromEnv.secretKey ? 'readonly' : '' %>>
      </div>
      <div class="col-span-12 sm:col-span-6">
        <label for="px-bank" class="<%= label %>">Ngân hàng nhận tiền bằng QR</label>
        <select id="px-bank" name="bankCode" class="<%= input %>">
          <option value="">— bấm "Kiểm tra kết nối" để tải danh sách —</option>
          <% payonPanel.banks.forEach((b) => { %><option value="<%= b.code %>" <%= px.bankCode === b.code ? 'selected' : '' %>><%= b.name %></option><% }) %>
          <% if (px.bankCode && !payonPanel.banks.some((b) => b.code === px.bankCode)) { %><option value="<%= px.bankCode %>" selected><%= px.bankName || px.bankCode %></option><% } %>
        </select>
      </div>
      <div class="col-span-12 sm:col-span-3">
        <label for="px-exp" class="<%= label %>">QR hết hạn sau (phút)</label>
        <input id="px-exp" name="expireMinutes" type="number" min="3" max="60" step="1" value="<%= px.expireMinutes %>" class="<%= input %> text-right font-mono">
      </div>
      <div class="col-span-12 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
        <label class="flex min-h-10 items-center gap-2">
          <input type="hidden" name="enabled" value="0">
          <input type="checkbox" name="enabled" value="1" <%= px.enabled ? 'checked' : '' %> class="h-4 w-4 rounded border-gray-300 accent-blue-700">
          Bật thanh toán QR PayOn trên trang đơn hàng
        </label>
      </div>
      <div class="col-span-12 flex flex-wrap gap-2">
        <button type="submit" class="<%= btnPrimary %> w-full sm:w-auto">Lưu cấu hình PayOn</button>
      </div>
    </form>
    <div class="mt-3 flex flex-wrap gap-2 border-t border-gray-200 pt-3">
      <form method="post" action="/admin/settings/payon/test"><%- include('../partials/csrf') %><input type="hidden" name="_back" value="/admin/settings">
        <button type="submit" class="<%= btnSecondary %>" <%= px.complete ? '' : 'disabled' %>>Kiểm tra kết nối &amp; tải danh sách ngân hàng</button></form>
      <a href="/admin/payon" class="<%= btnSecondary %>">Xem giao dịch PayOn</a>
      <form method="post" action="/admin/settings/payon/ip"><%- include('../partials/csrf') %><input type="hidden" name="_back" value="/admin/settings">
        <button type="submit" class="<%= btnSecondary %>">Xem IP máy chủ (để NextPay khai báo)</button></form>
    </div>
  </section>

  <section class="col-span-12 rounded border border-gray-200 max-lg:border-0" aria-labelledby="users-title">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-gray-200 px-5 py-4 max-lg:border-b-0 max-lg:px-0">
      <h2 id="users-title" class="text-base font-semibold">Tài khoản nhân viên (<%= users.length %>)</h2>
      <button type="button" data-modal-open="#user-dialog" class="<%= btnPrimary %>">+ Thêm tài khoản</button>
    </div>
    <table class="rtable w-full border-collapse text-left text-sm lg:min-w-[640px]">
      <caption class="sr-only">Tài khoản nhân viên</caption>
      <thead class="<%= ui.thead %>"><tr><th scope="col" class="px-4 py-3">Tài khoản</th><th scope="col" class="px-4 py-3">Vai trò</th><th scope="col" class="px-4 py-3">Trạng thái</th><th scope="col" class="px-4 py-3 text-right"><span class="sr-only">Hành động</span></th></tr></thead>
      <tbody>
        <% users.forEach((u) => { const me = u.id === currentUser.id; %>
          <tr class="border-b border-gray-200 last:border-b-0 hover:bg-gray-50 <%= u.is_active ? '' : 'text-gray-400' %>">
            <td data-label="" class="rt-title px-4 py-3"><span class="font-medium"><%= u.full_name %></span><span class="ml-2 font-mono text-xs text-gray-500"><%= u.username %></span><% if (me) { %> <%- badge('Bạn', 'info') %><% } %></td>
            <td data-label="Vai trò" class="px-4 py-3"><%= ROLE[u.role] || u.role %></td>
            <td data-label="Trạng thái" class="px-4 py-3"><%- u.is_active ? badge('Hoạt động', 'good') : badge('Đã khóa', 'neutral') %></td>
            <td data-label="" class="rt-actions px-4 py-3 text-right">
              <div class="inline-flex items-center gap-1">
                <% if (!me) { %>
                  <button type="button" class="<%= btnGhost %> w-auto px-2 text-xs font-medium" data-modal-open="#reset-dialog" data-action="/admin/settings/users/<%= u.id %>/password" data-title="Đặt lại mật khẩu — <%= u.username %>">Đặt lại mật khẩu</button>
                  <form method="post" action="/admin/settings/users/<%= u.id %>/active" <% if (u.is_active) { %>data-confirm="Khóa tài khoản <%= u.username %>? Người này sẽ không đăng nhập được nữa."<% } %>>
                    <%- include('../partials/csrf') %>
                    <input type="hidden" name="active" value="<%= u.is_active ? 0 : 1 %>">
                    <button type="submit" class="<%= btnGhost %> w-auto px-2 text-xs font-medium"><%= u.is_active ? 'Khóa' : 'Mở khóa' %></button>
                  </form>
                <% } %>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </section>
  <% } %>
</div>

<% if (!forced) { %>
<dialog id="user-dialog" aria-labelledby="user-title" class="max-w-md <%= sheet %>">
  <form method="post" action="/admin/settings/users" class="flex flex-col">
    <%- include('../partials/csrf') %>
    <%- grabber %>
    <div class="flex items-center justify-between border-b border-gray-200 px-4 py-3 sm:px-6 sm:py-4">
      <h2 id="user-title" class="text-lg font-semibold">Thêm tài khoản</h2>
      <button type="button" data-modal-close aria-label="Đóng" class="<%= btnGhost %>"><%- icon('x', 'h-5 w-5') %></button>
    </div>
    <div class="space-y-4 px-4 py-4 sm:px-6 sm:py-5">
      <div>
        <label for="u-name" class="<%= label %>">Họ tên</label>
        <input id="u-name" name="full_name" required maxlength="100" class="<%= input %>" autocomplete="off">
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label for="u-user" class="<%= label %>">Tên đăng nhập</label>
          <input id="u-user" name="username" required minlength="3" maxlength="50" pattern="[a-z0-9][a-z0-9._\-]{2,49}" class="<%= input %> font-mono" autocomplete="off" autocapitalize="none" spellcheck="false">
        </div>
        <div>
          <label for="u-role" class="<%= label %>">Vai trò</label>
          <select id="u-role" name="role" class="<%= input %>"><option value="cashier">Thu ngân</option><option value="admin">Quản trị viên</option></select>
        </div>
      </div>
      <div>
        <label for="u-pass" class="<%= label %>">Mật khẩu (tối thiểu 10 ký tự)</label>
        <input id="u-pass" name="password" type="password" required minlength="10" maxlength="200" autocomplete="new-password" class="<%= input %>">
      </div>
      <p class="text-xs text-gray-500">Thu ngân đăng nhập bằng ứng dụng POS; chỉ quản trị viên vào được trang quản trị này.</p>
    </div>
    <div class="flex items-center justify-end gap-3 border-t border-gray-200 px-4 py-3 max-sm:pb-[calc(0.75rem+env(safe-area-inset-bottom))] sm:px-6 sm:py-4">
      <button type="button" data-modal-close class="<%= btnSecondary %> max-sm:flex-1">Hủy</button>
      <button type="submit" class="<%= btnPrimary %> max-sm:flex-[2]">Tạo tài khoản</button>
    </div>
  </form>
</dialog>

<dialog id="reset-dialog" aria-labelledby="reset-title" class="max-w-md <%= sheet %>">
  <form method="post" action="#" class="flex flex-col">
    <%- include('../partials/csrf') %>
    <%- grabber %>
    <div class="flex items-center justify-between border-b border-gray-200 px-4 py-3 sm:px-6 sm:py-4">
      <h2 id="reset-title" data-dialog-title class="text-lg font-semibold">Đặt lại mật khẩu</h2>
      <button type="button" data-modal-close aria-label="Đóng" class="<%= btnGhost %>"><%- icon('x', 'h-5 w-5') %></button>
    </div>
    <div class="px-4 py-4 sm:px-6 sm:py-5">
      <label for="rs-pass" class="<%= label %>">Mật khẩu mới (tối thiểu 10 ký tự)</label>
      <input id="rs-pass" name="password" type="password" required minlength="10" maxlength="200" autocomplete="new-password" class="<%= input %>">
    </div>
    <div class="flex items-center justify-end gap-3 border-t border-gray-200 px-4 py-3 max-sm:pb-[calc(0.75rem+env(safe-area-inset-bottom))] sm:px-6 sm:py-4">
      <button type="button" data-modal-close class="<%= btnSecondary %> max-sm:flex-1">Hủy</button>
      <button type="submit" class="<%= btnPrimary %> max-sm:flex-[2]">Đặt lại</button>
    </div>
  </form>
</dialog>
<% } %>
