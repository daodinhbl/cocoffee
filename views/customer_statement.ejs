<%
  const fmtDay = (d) => d.split('-').reverse().join('/');
  const TYPE = { debt: 'Phát sinh nợ', payment: 'Thu nợ', adjust: 'Điều chỉnh' };
  const METHOD = { cash: 'tiền mặt', transfer: 'chuyển khoản', card: 'thẻ', other: 'khác' };
  const today = new Intl.DateTimeFormat('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'Asia/Ho_Chi_Minh' }).format(new Date());
%><!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>Biên bản đối chiếu công nợ · <%= customer.name %></title>
  <style>
    @page { size: A4; margin: 14mm 14mm 16mm; }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: "Times New Roman", Times, "Liberation Serif", Tinos, serif; font-size: 12.5pt; line-height: 1.4; color: #000; background: #e5e7eb; }
    .sheet { width: 210mm; max-width: 100%; min-height: 297mm; margin: 12px auto; padding: 14mm; background: #fff; box-shadow: 0 4px 16px rgba(0,0,0,.15); }
    .head { display: flex; justify-content: space-between; gap: 12mm; }
    .shop { font-weight: bold; text-transform: uppercase; }
    .muted { color: #333; font-size: 11pt; }
    h1 { margin: 8mm 0 1mm; text-align: center; font-size: 17pt; letter-spacing: .5px; }
    .period { text-align: center; font-style: italic; margin-bottom: 6mm; }
    .parties { margin: 0 0 5mm; }
    .parties p { margin: 1mm 0; }
    table { width: 100%; border-collapse: collapse; font-size: 11.5pt; }
    th, td { border: 1px solid #000; padding: 1.6mm 2mm; vertical-align: top; }
    th { background: #f1f1f1; text-align: center; }
    td.n { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
    tr.sum td { font-weight: bold; background: #fafafa; }
    .conclude { margin: 5mm 0; }
    .sign { display: grid; grid-template-columns: 1fr 1fr; gap: 10mm; margin-top: 8mm; text-align: center; }
    .sign .role { font-weight: bold; text-transform: uppercase; }
    .sign .hint { font-style: italic; font-size: 10.5pt; }
    .sign .space { height: 26mm; }
    .bar { position: sticky; top: 0; display: flex; gap: 8px; justify-content: center; padding: 10px; background: #0f172a; }
    .bar button { font: inherit; font-size: 13pt; min-height: 44px; padding: 0 18px; border: 0; border-radius: 10px; cursor: pointer; }
    .bar .print { background: #fbbf24; color: #0f172a; font-weight: bold; }
    .bar .close { background: #334155; color: #fff; }
    @media screen and (max-width: 820px) { .sheet { min-height: 0; padding: 6mm; } table { font-size: 10pt; } }
    @media print { body { background: #fff; } .sheet { margin: 0; width: auto; min-height: 0; padding: 0; box-shadow: none; } .bar { display: none; } }
  </style>
</head>
<body>
  <div class="bar">
    <button type="button" class="print" id="btn-print">In biên bản (A4)</button>
    <button type="button" class="close" id="btn-close">Đóng</button>
  </div>
  <main class="sheet">
    <div class="head">
      <div>
        <div class="shop"><%= shopName %></div>
        <% if (printer.shopAddress) { %><div class="muted">Địa chỉ: <%= printer.shopAddress %></div><% } %>
        <% if (printer.shopPhone) { %><div class="muted">Điện thoại: <%= printer.shopPhone %></div><% } %>
      </div>
      <div class="muted" style="text-align:right">Ngày lập: <%= today %><br>Mã KH: KH<%= String(customer.id).padStart(5, '0') %></div>
    </div>

    <h1>BIÊN BẢN ĐỐI CHIẾU CÔNG NỢ</h1>
    <div class="period">Từ ngày <%= fmtDay(period.from) %> đến ngày <%= fmtDay(period.to) %></div>

    <div class="parties">
      <p><b>Bên bán (A):</b> <%= shopName %><%= printer.shopAddress ? ` — ${printer.shopAddress}` : '' %></p>
      <p><b>Bên mua (B):</b> <%= customer.name %><%= customer.phone ? ` — ĐT: ${customer.phone}` : '' %></p>
      <p>Hai bên cùng đối chiếu công nợ phát sinh trong kỳ như sau:</p>
    </div>

    <table>
      <thead>
        <tr><th style="width:9%">STT</th><th style="width:16%">Ngày</th><th>Diễn giải</th><th style="width:17%">Phát sinh nợ</th><th style="width:17%">Đã thanh toán</th><th style="width:17%">Còn nợ</th></tr>
      </thead>
      <tbody>
        <tr><td></td><td></td><td><b>Nợ đầu kỳ</b></td><td class="n"></td><td class="n"></td><td class="n"><b><%= money(st.opening) %></b></td></tr>
        <% st.entries.forEach((e, i) => { %>
          <tr>
            <td style="text-align:center"><%= i + 1 %></td>
            <td><%= fmtTime(e.created_at).split(' ')[0] %></td>
            <td><%= TYPE[e.entry_type] || e.entry_type %><%= e.order_code ? ` — đơn ${e.order_code}` : '' %><%= e.method ? ` (${METHOD[e.method] || e.method})` : '' %><%= e.note && !/^(Nợ đơn|Thu nợ đơn) /.test(e.note) && e.note !== 'Thu nợ' ? ` — ${e.note}` : '' %></td>
            <td class="n"><%= e.amount > 0 ? money(e.amount) : '' %></td>
            <td class="n"><%= e.amount < 0 ? money(-e.amount) : '' %></td>
            <td class="n"><%= money(e.balance) %></td>
          </tr>
        <% }) %>
        <% if (!st.entries.length) { %><tr><td colspan="6" style="text-align:center;font-style:italic">Không có phát sinh trong kỳ</td></tr><% } %>
        <tr class="sum"><td colspan="3">Cộng phát sinh trong kỳ</td><td class="n"><%= money(st.increase) %></td><td class="n"><%= money(st.decrease) %></td><td class="n"></td></tr>
        <tr class="sum"><td colspan="5">Nợ cuối kỳ (B còn phải trả A)</td><td class="n"><%= money(st.closing) %></td></tr>
      </tbody>
    </table>

    <p class="conclude">Tính đến ngày <%= fmtDay(period.to) %>, Bên B còn nợ Bên A số tiền: <b><%= money(st.closing) %></b>.
      Biên bản được lập thành 02 bản, mỗi bên giữ 01 bản. Nếu có sai lệch, Bên B vui lòng phản hồi để hai bên cùng kiểm tra lại.</p>

    <div class="sign">
      <div><div class="role">Đại diện Bên A</div><div class="hint">(Ký, ghi rõ họ tên)</div><div class="space"></div><div><%= printedBy %></div></div>
      <div><div class="role">Đại diện Bên B</div><div class="hint">(Ký, ghi rõ họ tên)</div><div class="space"></div><div><%= customer.name %></div></div>
    </div>
  </main>
  <script nonce="<%= nonce %>">
    document.getElementById('btn-print').addEventListener('click', function () { window.print(); });
    document.getElementById('btn-close').addEventListener('click', function () { if (window.opener || history.length <= 1) window.close(); else history.back(); });
    <% if (autoPrint) { %>window.addEventListener('load', function () { setTimeout(function () { window.print(); }, 150); });<% } %>
  </script>
</body>
</html>
