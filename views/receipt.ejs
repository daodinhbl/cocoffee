<%
  // Thermal paper: 80mm prints ~72mm wide, 58mm prints ~48mm. Everything is sized in mm/pt so the
  // browser's print scaling stays at 100%.
  const printable = paper === 58 ? 48 : 72;
  const base = paper === 58 ? 9 : 10.5;          // pt
  const methodText = payments.length ? payments.map((p) => p.label).join(', ') : 'Chưa thanh toán';
  const copies = Math.max(1, Math.min(3, printer.copies || 1));
%><!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>Hóa đơn <%= order.order_code %></title>
  <style>
    @page { size: <%= paper %>mm auto; margin: 0; }
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; }
    body { font-family: "Times New Roman", Times, "Liberation Serif", Tinos, serif; font-size: <%= base %>pt; line-height: 1.3; color: #000; background: #e5e7eb; }
    .paper:last-of-type { page-break-after: auto; break-after: auto; }
    .copy { text-align: center; font-size: <%= base - 2 %>pt; font-style: italic; margin-top: 2mm; }
    .hint { color: #cbd5e1; font-size: 11pt; align-self: center; }
    .sample { text-align: center; border: 1px solid #000; padding: 1mm; margin-bottom: 2mm; font-weight: bold; }
    .paper { width: <%= paper %>mm; margin: 12px auto; page-break-after: always; break-after: page; padding: 4mm <%= (paper - printable) / 2 %>mm 6mm; background: #fff; box-shadow: 0 4px 16px rgba(0,0,0,.15); }
    .center { text-align: center; }
    .shop { font-size: <%= base + 5 %>pt; font-weight: bold; text-transform: uppercase; letter-spacing: .5px; }
    .muted { font-size: <%= base - 1 %>pt; }
    .title { margin: 3mm 0 1mm; font-size: <%= base + 3 %>pt; font-weight: bold; }
    .rule { border: 0; border-top: 1px dashed #000; margin: 2mm 0; }
    .rule.solid { border-top-style: solid; }
    .row { display: flex; justify-content: space-between; gap: 2mm; }
    .row > :last-child { text-align: right; white-space: nowrap; }
    table { width: 100%; border-collapse: collapse; }
    th { font-weight: bold; text-align: left; border-bottom: 1px solid #000; padding: 0 0 1mm; font-size: <%= base - 1 %>pt; }
    td { padding: 1mm 0 0; vertical-align: top; }
    td.n, th.n { text-align: right; white-space: nowrap; }
    .item { font-weight: bold; }
    .sub { font-size: <%= base - 1 %>pt; padding-top: 0; }
    .total { font-size: <%= base + 5 %>pt; font-weight: bold; }
    .note { font-style: italic; }
    .bar { position: sticky; top: 0; display: flex; gap: 8px; justify-content: center; padding: 10px; background: #0f172a; }
    .bar button { font: inherit; font-size: 14pt; min-height: 48px; padding: 0 20px; border: 0; border-radius: 10px; cursor: pointer; }
    .bar .print { background: #fbbf24; color: #0f172a; font-weight: bold; }
    .bar .close { background: #334155; color: #fff; }
    @media print {
      body { background: #fff; }
      .paper { margin: 0; box-shadow: none; }
      .bar { display: none; }
    }
  </style>
</head>
<body>
  <div class="bar">
    <button type="button" class="print" id="btn-print">In hóa đơn (<%= paper %>mm)</button>
    <button type="button" class="close" id="btn-close">Đóng</button>
    <span class="hint"><%= copies %> liên<% if (printer.printerName) { %> · Máy in: <%= printer.printerName %><% } %></span>
  </div>
<% for (let copy = 1; copy <= copies; copy++) { %>

  <main class="paper">
    <% if (sample) { %><div class="sample">HÓA ĐƠN IN THỬ — KHÔNG CÓ GIÁ TRỊ</div><% } %>
    <div class="center">
      <div class="shop"><%= shopName %></div>
      <% if (printer.shopAddress) { %><div class="muted"><%= printer.shopAddress %></div><% } %>
      <% if (printer.shopPhone) { %><div class="muted">ĐT: <%= printer.shopPhone %></div><% } %>
      <div class="title">HÓA ĐƠN THANH TOÁN</div>
      <div class="muted">Số: <b><%= order.order_code %></b></div>
    </div>
    <hr class="rule">
    <div class="row"><span>Ngày:</span><span><%= fmtTime(order.paid_at || order.completed_at || order.created_at) %></span></div>
    <div class="row"><span>Bàn:</span><span><%= order.table_name || order.table_code || (order.source === 'zalo' ? 'Đơn Zalo' : 'Mang đi') %></span></div>
    <div class="row"><span>Thu ngân:</span><span><%= (payments[0] && payments[0].received_by_name) || printedBy %></span></div>
    <hr class="rule">

    <table>
      <thead><tr><th>Món</th><th class="n">SL</th><th class="n">Thành tiền</th></tr></thead>
      <tbody>
        <% order.items.forEach((i) => { %>
        <tr><td class="item" colspan="3"><%= i.product_name %></td></tr>
        <tr>
          <td class="sub"><%= money(i.unit_price) %></td>
          <td class="sub n">x<%= i.quantity %></td>
          <td class="sub n"><%= money(i.line_total) %></td>
        </tr>
        <% if (i.note) { %><tr><td class="sub note" colspan="3">↳ <%= i.note %></td></tr><% } %>
        <% }) %>
      </tbody>
    </table>
    <hr class="rule solid">

    <div class="row"><span>Tạm tính</span><span><%= money(order.subtotal) %></span></div>
    <% if (Number(order.discount) > 0) { %><div class="row"><span>Giảm giá</span><span>−<%= money(order.discount) %></span></div><% } %>
    <div class="row total"><span>TỔNG CỘNG</span><span><%= money(order.total) %></span></div>
    <% if (vat !== null) { %><div class="row muted"><span>(Đã gồm VAT <%= printer.vatRate %>%)</span><span><%= money(vat) %></span></div><% } %>
    <hr class="rule">
    <div class="row"><span>Thanh toán</span><span><%= methodText %></span></div>
    <% if (cash) { %>
      <div class="row"><span>Khách đưa</span><span><%= money(cash.given) %></span></div>
      <div class="row"><span>Tiền thối</span><span><%= money(cash.change) %></span></div>
    <% } %>
    <% if (order.note) { %><hr class="rule"><div class="note">Ghi chú: <%= order.note %></div><% } %>
    <hr class="rule">
    <div class="center">
      <div><b><%= printer.footer || 'Cảm ơn quý khách — hẹn gặp lại!' %></b></div>
      <% if (copies > 1) { %><div class="copy">Liên <%= copy %>/<%= copies %></div><% } %>
    </div>
  </main>
<% } %>

  <script nonce="<%= nonce %>">
    (function () {
      document.getElementById('btn-print').addEventListener('click', function () { window.print(); });
      document.getElementById('btn-close').addEventListener('click', function () {
        if (window.opener || window.history.length <= 1) window.close(); else window.history.back();
      });
      <% if (autoPrint) { %>window.addEventListener('load', function () { setTimeout(function () { window.print(); }, 150); });<% } %>
    })();
  </script>
</body>
</html>
