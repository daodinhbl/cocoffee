# `git archive` (scripts/package-deploy.js) ships only what the server runs on Hostinger.
test/            export-ignore
docs/            export-ignore
mobile/          export-ignore
README.md        export-ignore
.htaccess        export-ignore
.gitattributes   export-ignore
.gitignore       export-ignore

# One line-ending rule for everyone: text files are LF in the repo AND in the working tree (no more CRLF churn on Windows).
* text=auto eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.apk binary
*.ipa binary
*.zip binary
*.docx binary
*.ttf binary

# shell scripts must keep LF line endings (they run on Linux)
*.sh text eol=lf

# CI workflows are not part of the server deploy archive
.github/         export-ignore
/desktop export-ignore

# Google Play store graphics and testers' invite (CHPlay/README.md): not part of the server
/CHPlay export-ignore
