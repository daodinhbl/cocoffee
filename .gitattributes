# `git archive` (scripts/package-deploy.js) ships only what the server runs on Hostinger.
test/            export-ignore
docs/            export-ignore
mobile/          export-ignore
README.md        export-ignore
.htaccess        export-ignore
.gitattributes   export-ignore
.gitignore       export-ignore

# shell scripts must keep LF line endings (they run on Linux)
*.sh text eol=lf
