<?xml version="1.0" encoding="utf-8"?>
<!-- Release: HTTPS only. The app carries the staff token and the shop's data; plain HTTP is refused by the OS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
